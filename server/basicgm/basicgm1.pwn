stock MapObj_OnInit()
{
	// une zone de streaming par mapping
	// [v13] chaque mapping est enregistre (nom + point d'arrivee) pour le panneau /mappings
	MapReg_Begin("Mecanicien de Los Santos");   MapObj_Mechanic(); MapReg_End();
	MapReg_Begin("Centre de reeducation");      MapObj_Hospital(); MapReg_End();
	MapReg_Begin("Base de Verdant Meadows");    MapObj_Base();     MapReg_End();
	MapReg_Begin("Armurerie (interieur)");      MapObj_Armory();   MapReg_End();
	MapReg_Begin("Studio Crestwood News");      MapObj_News();     MapReg_End();
	MapReg_Begin("Mairie (City Hall)");         MapObj_CityHall(); MapReg_End();
	// mappings importes
	MapReg_Begin("Hotel");                      MapImp_Hotel();          MapReg_End();
	MapReg_Begin("Armee LS");                   MapImp_ArmeeLS();        MapReg_End();
	// LSPD (Unity Station) retire le 31/10 (modele APK 1862 : plantages)
	// [v14] "Station-service" (1779,-1775) retire : le nouveau LSPD est construit au meme endroit
	MapReg_Begin("Parc");                       MapImp_Parc();           MapReg_End();
	MapReg_Begin("Banque LS");                  MapImp_BanqueLS();       MapReg_End();
	MapReg_Begin("Place du spawn");             MapImp_SpawnPlace();     MapReg_End();
	MapReg_Begin("Samsung Shop");               MapImp_SamsungShop();    MapReg_End();
	MapReg_Begin("Paquebot");                   MapImp_Paquebot();       MapReg_End();
	MapReg_Begin("Bureau Glenpark");            MapImp_BureauGlenpark(); MapReg_End();
	MapReg_Begin("Mini-banque");                MapImp_MiniBanque();     MapReg_End();
	MapReg_Begin("Cyber cafe");                 MapImp_CyberCafe();      MapReg_End();
#if MAP_MODELES_DATA
	MapReg_Begin("Banque Atlas");               MapImp_BanqueAtlas();    MapReg_End();
	MapReg_Begin("Mecano MTA");                 MapImp_MecanoMTA();      MapReg_End();
	MapReg_Begin("Concession SF");              MapImp_ConcessionSF();   MapReg_End();
#endif
	Ms_OnInit();
	Pts_LoadArrivals();
	Entry_LoadDB();
	for (new e = 0; e < g_EntryCount; e++) Entry_Build(e);
	printf("[MAPPINGS] %d objets dynamiques charges, %d portails.", CountDynamicObjects(), g_EntryCount);
	return 1;
}

stock MapObj_OnConnect(playerid)
{
	Ms_OnConnect(playerid);
#if MAP_REMOVE_BUILDINGS
	MapObj_RemoveBuildings(playerid);
	MapObj_CityHallRemove(playerid);
	MapImp_RemoveBuildings(playerid);
#if MAP_MODELES_DATA
	MapImp_RemoveBuildingsData(playerid);
#endif
#endif
	return 1;
}

// Ajoute les icones des lieux et des entrees au JSON des blips (module CARTE)
stock MapObj_AppendBlips(json[], size, &n)
{
	new part[64];
	for (new i = 0; i < sizeof(g_Places); i++, n++)
	{
		format(part, sizeof part, "%s{\"x\":%.1f,\"y\":%.1f,\"icon\":%d}", n ? (",") : (""), g_Places[i][plX], g_Places[i][plY], g_Places[i][plBlip]);
		strcat(json, part, size);
	}
	for (new e = 0; e < g_EntryCount; e++)
	{
		if (!Entry_Ready(e) || !g_Entries[e][enBlip]) continue;
		n++;
		format(part, sizeof part, "%s{\"x\":%.1f,\"y\":%.1f,\"icon\":%d}", (n > 1) ? (",") : (""), g_Entries[e][enOX], g_Entries[e][enOY], g_Entries[e][enBlip]);
		strcat(json, part, size);
	}
	return 1;
}

stock MapObj_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/entrer", true) || !strcmp(cmdtext, "/sortir", true))
	{
		if (!Entry_Use(playerid)) SendClientMessage(playerid, 0xFF4444FF, "Il n'y a pas de porte ici.");
		return 1;
	}
	if (!strcmp(cmdtext, "/tplieu ", true, 8))
	{
		if (Admin_Level(playerid) < ADMIN_LVL_ADMIN) return 0;
		new id = strval(cmdtext[8]) - 1;
		if (id >= 0 && id < sizeof(g_Places))
		{
			Entry_Teleport(playerid, g_Places[id][plX], g_Places[id][plY], g_Places[id][plZ] + 1.0, 0.0);
			return 1;
		}
		id -= sizeof(g_Places);
		if (id >= 0 && id < g_EntryCount)
		{
			Entry_Teleport(playerid, g_Entries[id][enIX], g_Entries[id][enIY], g_Entries[id][enIZ] + 0.6, g_Entries[id][enIA]);
			return 1;
		}
		SendClientMessage(playerid, 0xFF4444FF, "Lieu inconnu (/lieux).");
		return 1;
	}
	return 0;
}

// ============================================================
//  AIDE : /aide (/help, /commandes)
//  Dialogue liste des categories -> tableau des commandes. Les dialogues
//  SA-MP classiques sont affiches par la page assets/dialog/index.html.
// ============================================================

#define AIDE_DIALOG_MAIN      9620
#define AIDE_DIALOG_CAT       9621
#define AIDE_DIALOG_PLACES    9622

#define AIDE_CAT_COUNT        10

new g_AideCatName[AIDE_CAT_COUNT][32] =
{
	"Général", "Argent & banque", "Boutique & inventaire", "Emplois", "Véhicules",
	"Factions", "Police", "Lieux & GPS", "Administration", "Gouvernement"
};

new g_AideCatIcon[AIDE_CAT_COUNT][10] =
{
	"{FFFFFF}", "{33CC33}", "{FFB454}", "{FFCC33}", "{7DB4FF}", "{BDF38B}", "{3B82FF}", "{FF6B72}", "{C2A2DA}", "{FFCC33}"
};

new g_AideMap[MAX_PLAYERS][AIDE_CAT_COUNT];   // ligne de la liste -> categorie (selon les droits)

stock Aide_Main(playerid)
{
	new list[700], line[64], n = 0;
	for (new c = 0; c < AIDE_CAT_COUNT; c++)
	{
		if (c == 6 && !Fac_IsLaw(playerid) && Admin_Level(playerid) < ADMIN_LVL_ADMIN) continue;
		if (c == 8 && Admin_Level(playerid) < ADMIN_LVL_ADMIN) continue;
		if (c == 9 && !Gov_Is(playerid) && Admin_Level(playerid) < ADMIN_LVL_ADMIN) continue;
		format(line, sizeof line, "%s%s%s", n ? ("\n") : (""), g_AideCatIcon[c], g_AideCatName[c]);
		strcat(list, line, sizeof list);
		g_AideMap[playerid][n] = c;
		n++;
	}
	return ShowPlayerDialog(playerid, AIDE_DIALOG_MAIN, DIALOG_STYLE_LIST, "{33CCFF}Crestwood RP {FFFFFF}- Aide", list, "Ouvrir", "Fermer");
}

stock Aide_Cat(playerid, c)
{
	new t[3200], title[64];
	format(title, sizeof title, "{33CCFF}Aide {FFFFFF}- %s", g_AideCatName[c]);
	t = "Commande\tDescription\n";
	switch (c)
	{
		case 0:
		{
			strcat(t, "{33CCFF}/aide\t{FFFFFF}Cette liste des commandes\n", sizeof t);
			strcat(t, "{33CCFF}/interagir\t{FFFFFF}Agit avec ce qui est proche (icône de main)\n", sizeof t);
			strcat(t, "{33CCFF}/vetements\t{FFFFFF}Changer d'apparence (aussi /skin)\n", sizeof t);
			strcat(t, "{33CCFF}/entrer  /sortir\t{FFFFFF}Passer une porte (armurerie, studio, bunker)\n", sizeof t);
			strcat(t, "{33CCFF}/interaction\t{FFFFFF}Menu avec le joueur le plus proche (saluer, argent, papiers)\n", sizeof t);
			strcat(t, "{33CCFF}Double tap sur un joueur\t{FFFFFF}Ouvre le menu d'interaction avec ce joueur\n", sizeof t);
