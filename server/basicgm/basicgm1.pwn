#include <a_samp>

// [Crestwood] VOCAL DE PROXIMITE (SampVoice 3.1, meme version que le client de l'APK)
//   0 = desactive (si le plugin sampvoice n'est pas installe sur le serveur)
#define CW_VOICE              1
#if CW_VOICE
	#include <sampvoice>
#endif

#pragma tabsize 0
#pragma dynamic 32768   // pile/tas : 128 Ko (gros tableaux JSON des pages)

// ============================================================
//  SYSTEME D'ARGENT + BANQUE
//  Relie a la page de l'application : assets/bank/index.html
// ------------------------------------------------------------
//  serveur -> client : ShowPlayerDialog(9500/9501/9502, caption "@bank",
//                      info = JSON). L'application Android intercepte ces
//                      dialogues et les envoie a la page banque.
//  client -> serveur : commande de chat cachee
//                      /bankact <type> <pin> <montant> <cible>
//  Donnees : SQLite  scriptfiles/crestwood_bank.db  (cash, banque, PIN, historique)
//  Aucun plugin necessaire (SQLite est integre a SA-MP 0.3.7).
// ============================================================

#define BANK_DIALOG_OPEN      9500
#define BANK_DIALOG_UPDATE    9501
#define BANK_DIALOG_CLOSE     9502

#define BANK_START_CASH       5000        // argent liquide d'un nouveau joueur
#define BANK_START_BALANCE    0           // solde bancaire d'un nouveau joueur
#define BANK_MAX_AMOUNT       100000000   // montant max par operation
#define BANK_MAX_MONEY        2000000000  // plafond (SA-MP : int 32 bits)
#define BANK_MAX_HISTORY      8           // lignes d'historique envoyees a la page
#define BANK_USE_RANGE        4.0         // distance max d'un point banque
#define BANK_PIN_MAX_FAILS    3           // essais avant blocage
#define BANK_LOCK_SECONDS     60          // duree du blocage
#define BANK_AUTOSAVE_MS      300000      // sauvegarde auto (5 min)
#define BANK_PAY_RANGE        6.0         // distance max pour /payer
#define BANK_GIVE_ENABLED     1           // /givemoney et /givebank (ouverts a tous) : 0 = desactives

#define BANK_COL_INFO         0x33CCFFFF
#define BANK_COL_OK           0x33CC33FF
#define BANK_COL_ERR          0xFF4444FF

// Points banque / distributeurs (X, Y, Z) - modifie a ta guise
// ============================================================
//  [Crestwood] Points d'interaction : SEULEMENT des icones 3D dessinees par le client
//  (module MARQUEURS 3D) + la main d'interaction. Plus de pickups ni de textes 3D.
//  Mettre 1 pour revenir aux anciens pickups / textes.
// ============================================================
#define CW_PICKUPS            0
#define CW_TEXT3D             0

new g_RpXUni[MAX_PLAYERS];
// [Crestwood] carburant de chaque vehicule (module SERVICES, include/Svc.inc) : 100 a la creation
new Float:g_CwFuel[MAX_VEHICLES + 1];
new g_CwLastVeh[MAX_PLAYERS];
stock Cw_CreateVehicle(vehicletype, Float:x, Float:y, Float:z, Float:rotation, color1, color2, respawn_delay, addsiren = 0)
{
	new v = CreateVehicle(vehicletype, x, y, z, rotation, color1, color2, respawn_delay, addsiren);
	if (v > 0 && v <= MAX_VEHICLES) g_CwFuel[v] = 100.0;
	return v;
}
#define CreateVehicle Cw_CreateVehicle
stock GetPlayerLastVehicle(playerid) { return g_CwLastVeh[playerid]; }             // module RP PLUS : skin d uniforme de faction porte (0 = aucun)

stock Cw_Pickup(model, type, Float:x, Float:y, Float:z, world)
{
#if CW_PICKUPS
	return CreatePickup(model, type, x, y, z, world);
#else
	#pragma unused model, type, x, y, z, world
	return -1;
#endif
}

stock Text3D:Cw_Label(const text[], color, Float:x, Float:y, Float:z, Float:dist, world, los)
{
#if CW_TEXT3D
	return Create3DTextLabel(text, color, x, y, z, dist, world, los);
#else
	#pragma unused text, color, x, y, z, dist, world, los
	return Text3D:INVALID_3DTEXT_ID;
#endif
}

// [v13] banques placees en jeu par les admins (panneau /points), plus aucun point fixe
#define PT_MAX_BANK           40
new Float:g_BankPos[PT_MAX_BANK][3];
new g_BankCount;

new g_BankPickup[sizeof(g_BankPos)];
new DB:g_BankDB;

new g_BankBalance[MAX_PLAYERS];
new g_BankPinHash[MAX_PLAYERS];
new g_BankCard[MAX_PLAYERS];
new g_BankCashLoad[MAX_PLAYERS];
new g_BankLoaded[MAX_PLAYERS];
new g_BankCashApplied[MAX_PLAYERS];
new g_BankOpen[MAX_PLAYERS];
new g_BankAuth[MAX_PLAYERS];
new g_BankFails[MAX_PLAYERS];
new g_BankLockUntil[MAX_PLAYERS];

forward Bank_AutoSave();

// ------------------------------------------------------------
//  Utilitaires
// ------------------------------------------------------------
stock Bank_NextToken(const str[], &idx, out[], outsize)
{
	while (str[idx] == ' ') idx++;
	new i = 0;
	while (str[idx] != 0 && str[idx] != ' ' && i < outsize - 1)
	{
		out[i] = str[idx];
		i++;
		idx++;
	}
	out[i] = 0;
	return i;
}

stock Bank_HashPin(pin, card)
{
	new s[24], h = 5381;
	format(s, sizeof s, "%04d:%d:CW", pin, card);
	for (new i = 0; s[i] != 0; i++)
	{
		h = ((h << 5) + h) ^ s[i];
	}
	if (h == 0) h = 1;
	return h;
}

stock Bank_Msg(playerid, color, const text[])
{
	return SendClientMessage(playerid, color, text);
}

// ------------------------------------------------------------
//  Base de donnees
// ------------------------------------------------------------
stock Bank_InitDB()
{
	g_BankDB = db_open("crestwood_bank.db");
	if (g_BankDB == DB:0)
	{
		print("[BANQUE] ERREUR : impossible d'ouvrir crestwood_bank.db");
		return 0;
	}
	db_free_result(db_query(g_BankDB, "CREATE TABLE IF NOT EXISTS bank_accounts (name TEXT PRIMARY KEY COLLATE NOCASE, cash INTEGER NOT NULL DEFAULT 0, balance INTEGER NOT NULL DEFAULT 0, pin INTEGER NOT NULL DEFAULT 0, card INTEGER NOT NULL DEFAULT 0)"));
	db_free_result(db_query(g_BankDB, "CREATE TABLE IF NOT EXISTS bank_history (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT COLLATE NOCASE, descr TEXT, amount INTEGER, date TEXT)"));
	print("[BANQUE] Base de donnees prete.");
	return 1;
}

stock Bank_SavePlayer(playerid)
{
	if (!g_BankLoaded[playerid] || !g_BankCashApplied[playerid]) return 0;
	new name[MAX_PLAYER_NAME + 1], query[256];
	GetPlayerName(playerid, name, sizeof name);
	format(query, sizeof query, "UPDATE bank_accounts SET cash = %d, balance = %d, pin = %d WHERE name = '%s'", GetPlayerMoney(playerid), g_BankBalance[playerid], g_BankPinHash[playerid], name);
	db_free_result(db_query(g_BankDB, query));
	return 1;
}

stock Bank_LoadPlayer(playerid)
{
	g_BankLoaded[playerid] = 0;
	g_BankOpen[playerid] = 0;
	g_BankAuth[playerid] = 0;
	g_BankFails[playerid] = 0;
	g_BankLockUntil[playerid] = 0;
	g_BankCashApplied[playerid] = 0;

	new name[MAX_PLAYER_NAME + 1], query[256], f[24];
	GetPlayerName(playerid, name, sizeof name);
	format(query, sizeof query, "SELECT cash, balance, pin, card FROM bank_accounts WHERE name = '%s' LIMIT 1", name);
	new DBResult:res = db_query(g_BankDB, query);

	if (db_num_rows(res) > 0)
	{
		db_get_field(res, 0, f, sizeof f); g_BankCashLoad[playerid] = strval(f);
		db_get_field(res, 1, f, sizeof f); g_BankBalance[playerid] = strval(f);
		db_get_field(res, 2, f, sizeof f); g_BankPinHash[playerid] = strval(f);
		db_get_field(res, 3, f, sizeof f); g_BankCard[playerid] = strval(f);
		db_free_result(res);
	}
	else
	{
		db_free_result(res);
		g_BankCashLoad[playerid] = BANK_START_CASH;
		g_BankBalance[playerid] = BANK_START_BALANCE;
		g_BankPinHash[playerid] = 0;
		g_BankCard[playerid] = random(10000);
		format(query, sizeof query, "INSERT INTO bank_accounts (name, cash, balance, pin, card) VALUES ('%s', %d, %d, 0, %d)", name, g_BankCashLoad[playerid], g_BankBalance[playerid], g_BankCard[playerid]);
		db_free_result(db_query(g_BankDB, query));
	}
	g_BankLoaded[playerid] = 1;
	return 1;
}

stock Bank_AddHistory(playerid, const descr[], amount)
{
	new name[MAX_PLAYER_NAME + 1], query[300], date[24], h, mi, s, y, mo, d;
	GetPlayerName(playerid, name, sizeof name);
	gettime(h, mi, s);
	getdate(y, mo, d);
	format(date, sizeof date, "%02d/%02d %02d:%02d", d, mo, h, mi);
	format(query, sizeof query, "INSERT INTO bank_history (name, descr, amount, date) VALUES ('%s', '%s', %d, '%s')", name, descr, amount, date);
	db_free_result(db_query(g_BankDB, query));
	return 1;
}

stock Bank_BuildHistory(playerid, out[], outsize)
{
	out[0] = 0;
	new name[MAX_PLAYER_NAME + 1], query[200];
	GetPlayerName(playerid, name, sizeof name);
	format(query, sizeof query, "SELECT descr, date, amount FROM bank_history WHERE name = '%s' ORDER BY id DESC LIMIT %d", name, BANK_MAX_HISTORY);
	new DBResult:res = db_query(g_BankDB, query);
	new rows = db_num_rows(res);
	new d[64], dt[24], am[16], item[160];
	for (new i = 0; i < rows; i++)
	{
		db_get_field(res, 0, d, sizeof d);
		db_get_field(res, 1, dt, sizeof dt);
		db_get_field(res, 2, am, sizeof am);
		if (i > 0) strcat(out, ",", outsize);
		format(item, sizeof item, "{\"desc\":\"%s\",\"date\":\"%s\",\"amount\":%d}", d, dt, strval(am));
		strcat(out, item, outsize);
		db_next_row(res);
	}
	db_free_result(res);
	return rows;
}

// ------------------------------------------------------------
//  Envoi de l'etat a la page banque (via dialogue "@bank")
// ------------------------------------------------------------
stock Bank_Send(playerid, dialogid, ok, const msg[])
{
	new json[1800], hist[1100], name[MAX_PLAYER_NAME + 1], hasPin[6], okStr[6];
	GetPlayerName(playerid, name, sizeof name);
	for (new i = 0; name[i] != 0; i++)
	{
		if (name[i] == '_') name[i] = ' ';
	}
	Bank_BuildHistory(playerid, hist, sizeof hist);
	if (g_BankPinHash[playerid] != 0) format(hasPin, sizeof hasPin, "true");
	else format(hasPin, sizeof hasPin, "false");
	if (ok) format(okStr, sizeof okStr, "true");
	else format(okStr, sizeof okStr, "false");

	format(json, sizeof json, "{\"player\":\"%s\",\"cash\":%d,\"balance\":%d,\"cardLast\":\"%04d\",\"hasPin\":%s,\"ok\":%s,\"msg\":\"%s\",\"history\":[%s]}",
		name, GetPlayerMoney(playerid), g_BankBalance[playerid], g_BankCard[playerid], hasPin, okStr, msg, hist);

	ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@bank", json, "OK", "");
	return 1;
}

// ------------------------------------------------------------
//  Ouverture / fermeture
// ------------------------------------------------------------
stock Bank_IsNearPoint(playerid)
{
	for (new i = 0; i < g_BankCount; i++)
	{
		if (IsPlayerInRangeOfPoint(playerid, BANK_USE_RANGE, g_BankPos[i][0], g_BankPos[i][1], g_BankPos[i][2])) return 1;
	}
	return 0;
}

stock Bank_Open(playerid)
{
	if (!IsPlayerConnected(playerid) || !g_BankLoaded[playerid]) return 0;
	if (g_BankOpen[playerid]) return 1;
	if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
	{
		Bank_Msg(playerid, BANK_COL_ERR, "Banque : descends de ton vehicule d'abord.");
		return 0;
	}
	if (!Bank_IsNearPoint(playerid))
	{
		Bank_Msg(playerid, BANK_COL_ERR, "Banque : tu n'es pas pres d'une banque ou d'un distributeur.");
		return 0;
	}
	g_BankOpen[playerid] = 1;
	g_BankAuth[playerid] = 0;
	TogglePlayerControllable(playerid, 0);
	Bank_Send(playerid, BANK_DIALOG_OPEN, 1, "");
	return 1;
}

stock Bank_Close(playerid, notifyClient)
{
	if (!g_BankOpen[playerid]) return 0;
	g_BankOpen[playerid] = 0;
	g_BankAuth[playerid] = 0;
	if (IsPlayerConnected(playerid))
	{
		TogglePlayerControllable(playerid, 1);
		if (notifyClient) ShowPlayerDialog(playerid, BANK_DIALOG_CLOSE, DIALOG_STYLE_MSGBOX, "@bank", "{}", "OK", "");
		Bank_SavePlayer(playerid);
	}
	return 1;
}

// ------------------------------------------------------------
//  Verification du PIN (avec blocage apres trop d'echecs)
//  retourne 1 si OK, 0 sinon (la reponse d'erreur est deja envoyee)
// ------------------------------------------------------------
stock Bank_CheckPin(playerid, pin)
{
	new now = gettime();
	if (g_BankLockUntil[playerid] > now)
	{
		new msg[64];
		format(msg, sizeof msg, "Trop d'essais. Reessaie dans %d s.", g_BankLockUntil[playerid] - now);
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, msg);
		return 0;
	}
	if (pin < 0 || pin > 9999 || Bank_HashPin(pin, g_BankCard[playerid]) != g_BankPinHash[playerid])
	{
		g_BankFails[playerid]++;
		new msg[64];
		if (g_BankFails[playerid] >= BANK_PIN_MAX_FAILS)
		{
			g_BankFails[playerid] = 0;
			g_BankLockUntil[playerid] = now + BANK_LOCK_SECONDS;
			format(msg, sizeof msg, "Mot de passe incorrect. Compte bloque %d s.", BANK_LOCK_SECONDS);
		}
		else
		{
			format(msg, sizeof msg, "Mot de passe incorrect (%d essai(s) restant(s)).", BANK_PIN_MAX_FAILS - g_BankFails[playerid]);
		}
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, msg);
		return 0;
	}
	g_BankFails[playerid] = 0;
	return 1;
}

// ------------------------------------------------------------
//  Actions envoyees par la page : /bankact <type> <pin> <montant> <cible>
// ------------------------------------------------------------
stock Bank_Action(playerid, const params[])
{
	new idx = 0, tType[20], tPin[12], tAmount[16], tTarget[12];
	Bank_NextToken(params, idx, tType, sizeof tType);
	Bank_NextToken(params, idx, tPin, sizeof tPin);
	Bank_NextToken(params, idx, tAmount, sizeof tAmount);
	Bank_NextToken(params, idx, tTarget, sizeof tTarget);

	if (!strcmp(tType, "close", true))
	{
		Bank_Close(playerid, 0);
		return 1;
	}

	// Toute autre action exige une session ouverte pres d'une banque
	if (!g_BankOpen[playerid] || !g_BankLoaded[playerid]) return 1;
	if (!Bank_IsNearPoint(playerid))
	{
		Bank_Close(playerid, true);
		return 1;
	}

	new pin = strval(tPin);
	new amount = strval(tAmount);
	new target = strval(tTarget);
	new msg[96];

	// ---- Creation du mot de passe ----
	if (!strcmp(tType, "register_pin", true))
	{
		if (g_BankPinHash[playerid] != 0)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Un mot de passe existe deja.");
			return 1;
		}
		if (pin < 0 || pin > 9999)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Mot de passe invalide (4 chiffres).");
			return 1;
		}
		g_BankPinHash[playerid] = Bank_HashPin(pin, g_BankCard[playerid]);
		g_BankAuth[playerid] = 1;
		Bank_SavePlayer(playerid);
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 1, "Mot de passe enregistre.");
		return 1;
	}

	// Les actions suivantes demandent un compte avec mot de passe
	if (g_BankPinHash[playerid] == 0)
	{
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Cree d'abord un mot de passe.");
		return 1;
	}

	// ---- Connexion ----
	if (!strcmp(tType, "verify_pin", true))
	{
		if (!Bank_CheckPin(playerid, pin)) return 1;
		g_BankAuth[playerid] = 1;
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 1, "Acces autorise.");
		return 1;
	}

	// ---- Transactions ----
	if (!g_BankAuth[playerid])
	{
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Connecte-toi d'abord.");
		return 1;
	}
	if (!Bank_CheckPin(playerid, pin)) return 1;

	if (amount <= 0 || amount > BANK_MAX_AMOUNT)
	{
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Montant invalide.");
		return 1;
	}

	// Retrait : banque -> liquide
	if (!strcmp(tType, "withdraw", true))
	{
		if (g_BankBalance[playerid] < amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Solde bancaire insuffisant.");
			return 1;
		}
		if (GetPlayerMoney(playerid) > BANK_MAX_MONEY - amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Tu ne peux pas porter autant d'argent liquide.");
			return 1;
		}
		g_BankBalance[playerid] -= amount;
		GivePlayerMoney(playerid, amount);
		Bank_AddHistory(playerid, "Retrait", -amount);
		Bank_SavePlayer(playerid);
		format(msg, sizeof msg, "Retrait de %d effectue.", amount);
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 1, msg);
		return 1;
	}

	// Depot : liquide -> banque
	if (!strcmp(tType, "deposit", true))
	{
		if (GetPlayerMoney(playerid) < amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Tu n'as pas assez d'argent liquide.");
			return 1;
		}
		if (g_BankBalance[playerid] > BANK_MAX_MONEY - amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Plafond du compte atteint.");
			return 1;
		}
		GivePlayerMoney(playerid, -amount);
		g_BankBalance[playerid] += amount;
		Bank_AddHistory(playerid, "Depot", amount);
		Bank_SavePlayer(playerid);
		format(msg, sizeof msg, "Depot de %d effectue.", amount);
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 1, msg);
		return 1;
	}

	// Virement : banque -> banque d'un autre joueur (par ID)
	if (!strcmp(tType, "transfer", true))
	{
		if (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target) || !g_BankLoaded[target])
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Joueur introuvable.");
			return 1;
		}
		if (target == playerid)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Tu ne peux pas te virer de l'argent.");
			return 1;
		}
		if (g_BankBalance[playerid] < amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Solde bancaire insuffisant.");
			return 1;
		}
		if (g_BankBalance[target] > BANK_MAX_MONEY - amount)
		{
			Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Le compte du destinataire est plein.");
			return 1;
		}

		new nameFrom[MAX_PLAYER_NAME + 1], nameTo[MAX_PLAYER_NAME + 1], histText[64];
		GetPlayerName(playerid, nameFrom, sizeof nameFrom);
		GetPlayerName(target, nameTo, sizeof nameTo);

		g_BankBalance[playerid] -= amount;
		g_BankBalance[target] += amount;

		format(histText, sizeof histText, "Virement vers %s", nameTo);
		Bank_AddHistory(playerid, histText, -amount);
		format(histText, sizeof histText, "Virement de %s", nameFrom);
		Bank_AddHistory(target, histText, amount);

		Bank_SavePlayer(playerid);
		Bank_SavePlayer(target);

		format(msg, sizeof msg, "Virement de %d envoye a %s.", amount, nameTo);
		Bank_Send(playerid, BANK_DIALOG_UPDATE, 1, msg);

		format(msg, sizeof msg, "Banque : tu as recu un virement de %d de %s.", amount, nameFrom);
		Bank_Msg(target, BANK_COL_OK, msg);
		if (g_BankOpen[target]) Bank_Send(target, BANK_DIALOG_UPDATE, 1, "Virement recu.");
		return 1;
	}

	Bank_Send(playerid, BANK_DIALOG_UPDATE, 0, "Action inconnue.");
	return 1;
}

// ------------------------------------------------------------
//  Callbacks relies au gamemode
// ------------------------------------------------------------
stock Bank_OnInit()
{
	if (!Bank_InitDB()) return 0;
	for (new i = 0; i < g_BankCount; i++)
	{
		g_BankPickup[i] = Cw_Pickup(1274, 1, g_BankPos[i][0], g_BankPos[i][1], g_BankPos[i][2], -1);
		Cw_Label("Banque", 0x33CC33FF, g_BankPos[i][0], g_BankPos[i][1], g_BankPos[i][2] + 0.6, 15.0, 0, 0);
	}
	SetTimer("Bank_AutoSave", BANK_AUTOSAVE_MS, true);
	return 1;
}

stock Bank_OnExit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i)) Bank_SavePlayer(i);
	}
	if (g_BankDB != DB:0) db_close(g_BankDB);
	return 1;
}

public Bank_AutoSave()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i)) Bank_SavePlayer(i);
	}
	return 1;
}

stock Bank_OnConnect(playerid)
{
	if (g_BankDB == DB:0) return 0;
	return Bank_LoadPlayer(playerid);
}

stock Bank_OnDisconnect(playerid)
{
	Bank_SavePlayer(playerid);
	g_BankLoaded[playerid] = 0;
	g_BankOpen[playerid] = 0;
	g_BankAuth[playerid] = 0;
	return 1;
}

stock Bank_OnSpawn(playerid)
{
	if (!g_BankLoaded[playerid]) return 0;
	if (!g_BankCashApplied[playerid])
	{
		g_BankCashApplied[playerid] = 1;
		ResetPlayerMoney(playerid);
		GivePlayerMoney(playerid, g_BankCashLoad[playerid]);
	}
	for (new i = 0; i < g_BankCount; i++)
	{
		if (i < 30) SetPlayerMapIcon(playerid, i, g_BankPos[i][0], g_BankPos[i][1], g_BankPos[i][2], 52, 0, MAPICON_LOCAL);
	}
	return 1;
}

stock Bank_OnDeath(playerid)
{
	Bank_Close(playerid, true);
	return 1;
}

stock Bank_OnPickup(playerid, pickupid)
{
	// Le pickup reste un repere visuel : la banque s'ouvre en touchant l'icone de main (/interagir)
	for (new i = 0; i < g_BankCount; i++)
	{
		if (pickupid == g_BankPickup[i]) return 1;
	}
	return 0;
}

stock Bank_OnKey(playerid, newkeys, oldkeys)
{
	if ((newkeys & KEY_YES) && !(oldkeys & KEY_YES) && !g_BankOpen[playerid])
	{
		if (Bank_IsNearPoint(playerid)) Bank_Open(playerid);
	}
	return 1;
}

// Retourne 1 si la commande a ete geree
stock Bank_OnCommand(playerid, const cmdtext[])
{
	// Commande cachee envoyee par la page banque
	if (!strcmp(cmdtext, "/bankact ", true, 9))
	{
		Bank_Action(playerid, cmdtext[9]);
		return 1;
	}

	if (!strcmp(cmdtext, "/banque", true))
	{
		Bank_Open(playerid);
		return 1;
	}

	if (!strcmp(cmdtext, "/argent", true))
	{
		new msg[96];
		format(msg, sizeof msg, "Argent liquide : %d  |  Compte bancaire : %d", GetPlayerMoney(playerid), g_BankBalance[playerid]);
		Bank_Msg(playerid, BANK_COL_INFO, msg);
		return 1;
	}

	// /payer <id> <montant> : donner de l'argent liquide a un joueur proche
	if (!strcmp(cmdtext, "/payer ", true, 7))
	{
		new idx = 7, tId[12], tAmount[16], msg[96];
		Bank_NextToken(cmdtext, idx, tId, sizeof tId);
		Bank_NextToken(cmdtext, idx, tAmount, sizeof tAmount);
		new target = strval(tId), amount = strval(tAmount);
		if (!tId[0] || !tAmount[0])
		{
			Bank_Msg(playerid, BANK_COL_INFO, "Utilisation : /payer <id> <montant>");
			return 1;
		}
		if (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target) || target == playerid)
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Joueur invalide.");
			return 1;
		}
		if (amount <= 0 || amount > BANK_MAX_AMOUNT || GetPlayerMoney(playerid) < amount)
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Montant invalide ou argent liquide insuffisant.");
			return 1;
		}
		if (GetPlayerMoney(target) > BANK_MAX_MONEY - amount)
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Ce joueur ne peut pas porter autant d'argent.");
			return 1;
		}
		new Float:x, Float:y, Float:z;
		GetPlayerPos(target, x, y, z);
		if (!IsPlayerInRangeOfPoint(playerid, BANK_PAY_RANGE, x, y, z))
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Ce joueur est trop loin.");
			return 1;
		}
		new nameFrom[MAX_PLAYER_NAME + 1], nameTo[MAX_PLAYER_NAME + 1];
		GetPlayerName(playerid, nameFrom, sizeof nameFrom);
		GetPlayerName(target, nameTo, sizeof nameTo);
		GivePlayerMoney(playerid, -amount);
		GivePlayerMoney(target, amount);
		format(msg, sizeof msg, "Tu as donne %d a %s.", amount, nameTo);
		Bank_Msg(playerid, BANK_COL_OK, msg);
		format(msg, sizeof msg, "%s t'a donne %d.", nameFrom, amount);
		Bank_Msg(target, BANK_COL_OK, msg);
		Bank_SavePlayer(playerid);
		Bank_SavePlayer(target);
		return 1;
	}

	// /givemoney <id> <montant> : liquide (+/-) ; /givebank <id> <montant> : compte bancaire
	// Ouvertes a tous les joueurs. Mets BANK_GIVE_ENABLED a 0 pour les desactiver.
	if (!strcmp(cmdtext, "/givemoney ", true, 11) || !strcmp(cmdtext, "/givebank ", true, 10))
	{
		#if BANK_GIVE_ENABLED == 0
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Cette commande est desactivee.");
			return 1;
		}
		#endif
		new isBank = (cmdtext[5] == 'b' || cmdtext[5] == 'B');
		new idx = 0, tCmd[16], tId[12], tAmount[16], msg[96];
		Bank_NextToken(cmdtext, idx, tCmd, sizeof tCmd);
		Bank_NextToken(cmdtext, idx, tId, sizeof tId);
		Bank_NextToken(cmdtext, idx, tAmount, sizeof tAmount);
		new target = strval(tId), amount = strval(tAmount);
		if (!tId[0] || !tAmount[0] || target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target) || !g_BankLoaded[target])
		{
			Bank_Msg(playerid, BANK_COL_INFO, "Utilisation : /givemoney|/givebank <id> <montant>");
			return 1;
		}
		if (amount < -BANK_MAX_AMOUNT || amount > BANK_MAX_AMOUNT)
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Montant invalide.");
			return 1;
		}
		if (isBank && (g_BankBalance[target] + amount < 0 || g_BankBalance[target] > BANK_MAX_MONEY - amount))
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Solde bancaire resultant invalide.");
			return 1;
		}
		if (!isBank && (GetPlayerMoney(target) + amount < 0 || GetPlayerMoney(target) > BANK_MAX_MONEY - amount))
		{
			Bank_Msg(playerid, BANK_COL_ERR, "Argent liquide resultant invalide.");
			return 1;
		}
		if (isBank)
		{
			g_BankBalance[target] += amount;
			Bank_AddHistory(target, "Ajustement", amount);
			if (g_BankOpen[target]) Bank_Send(target, BANK_DIALOG_UPDATE, 1, "");
		}
		else
		{
			GivePlayerMoney(target, amount);
		}
		Bank_SavePlayer(target);
		if (isBank) format(msg, sizeof msg, "OK : %d ajoute (banque) au joueur %d.", amount, target);
		else format(msg, sizeof msg, "OK : %d ajoute (liquide) au joueur %d.", amount, target);
		Bank_Msg(playerid, BANK_COL_OK, msg);
		return 1;
	}

	return 0;
}

// ============================================================
//  SYSTEME DE VEHICULES  (spawn avec le moteur DEJA DEMARRE)
// ------------------------------------------------------------
//  /v <id ou nom> [couleur1] [couleur2]   ex : /v 411   /v infernus 0 3
//  /vdel        supprime ton vehicule         /vreparer   repare le vehicule
//  /moteur      moteur on/off (bouton moteur du HUD)
//  /lock        verrouille/deverrouille (bouton cadenas du HUD)
//  (utilise Bank_NextToken du bloc banque ci-dessus)
// ============================================================

