	if (Veh_OnCommand(playerid, cmdtext)) return 1;
	if (Shop_OnCommand(playerid, cmdtext)) return 1;
	if (Job_OnCommand(playerid, cmdtext)) return 1;
	if (Map_OnCommand(playerid, cmdtext)) return 1;
	if (MapObj_OnCommand(playerid, cmdtext)) return 1;
	if (Aide_OnCommand(playerid, cmdtext)) return 1;
	if (Ui_OnCommand(playerid, cmdtext)) return 1;
	if (Gov_OnCommand(playerid, cmdtext)) return 1;
	if (Staff_OnCommand(playerid, cmdtext)) return 1;
	if (Rep_OnCommand(playerid, cmdtext)) return 1;
	if (Garage_OnCommand(playerid, cmdtext)) return 1;
	if (AdmX_OnCommand(playerid, cmdtext)) return 1;
