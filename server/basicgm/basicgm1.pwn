#define VEH_COOLDOWN_MS       3000    // anti-spam entre deux spawns
#define VEH_LOCK_RANGE        8.0     // distance max pour /lock depuis l'exterieur

#define VEH_COL_OK            0x33CC33FF
#define VEH_COL_ERR           0xFF4444FF
#define VEH_COL_INFO          0x33CCFFFF

new g_PlayerVeh[MAX_PLAYERS];
new g_VehOwner[MAX_VEHICLES + 1];
new g_VehLastSpawn[MAX_PLAYERS];

forward Veh_DestroyDelayed(vehicleid, owner);

