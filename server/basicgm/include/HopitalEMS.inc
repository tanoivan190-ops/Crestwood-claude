stock MapImp_HopitalEMSRemove(playerid)
{
	RemoveBuildingForPlayer(playerid, 5403, 2050.0703, -1401.2109, 33.67969, 70.48);   // laehospital1 (d'origine)
	RemoveBuildingForPlayer(playerid, 5579, 2050.0703, -1401.2109, 33.67969, 70.48);   // son LOD
	RemoveBuildingForPlayer(playerid, 5402, 2049.8672, -1400.8906, 20.67969, 90.64);   // laehospground1
	RemoveBuildingForPlayer(playerid, 5578, 2049.8672, -1400.8906, 20.67969, 90.64);   // son LOD
	RemoveBuildingForPlayer(playerid, 673, 2008.2578, -1433.9922, 12.03125, 8.85);     // arbre
	return 1;
}

stock MapHopital_OnInit()
{
	g_MapHopital = MapHopital_Next();
	if (g_MapHopital)
	{
		MapReg_Begin("Hopital EMS");
		MapImp_HopitalEMSBat();
		MapImp_HopitalEMS();
		MapReg_End();
		// ascenseur du toit (helipad) : pickups "i"
		g_HopPickUp = CreatePickup(1318, 1, HOP_ASC_UP_X, HOP_ASC_UP_Y, HOP_ASC_UP_Z, 0);
		g_HopPickDown = CreatePickup(1318, 1, HOP_ASC_DN_X, HOP_ASC_DN_Y, HOP_ASC_DN_Z, 0);
		Create3DTextLabel("Ascenseur\n{9CC1FF}Toit / heliport", 0xFFFFFFFF, HOP_ASC_UP_X, HOP_ASC_UP_Y, HOP_ASC_UP_Z + 0.6, 10.0, 0, 1);
		Create3DTextLabel("Ascenseur\n{9CC1FF}Rez-de-chaussee", 0xFFFFFFFF, HOP_ASC_DN_X, HOP_ASC_DN_Y, HOP_ASC_DN_Z + 0.6, 10.0, 0, 1);
	}
	printf("[MAPPINGS] Hopital EMS : %s", g_MapHopital ? ("ACTIF") : ("en attente des modeles 5402/5403 (/mapdata hopital on)"));
	return 1;
}

stock MapHopital_OnConnect(playerid)
{
	g_HopLastTp[playerid] = 0;
	if (g_MapHopital) MapImp_HopitalEMSRemove(playerid);
	return 1;
}

stock MapHopital_OnPickup(playerid, pickupid)
{
	if (!g_MapHopital || (pickupid != g_HopPickUp && pickupid != g_HopPickDown)) return 0;
	new now = GetTickCount();
	if (g_HopLastTp[playerid] != 0 && now - g_HopLastTp[playerid] < 3000) return 1;
	g_HopLastTp[playerid] = (now == 0 ? 1 : now);
	if (pickupid == g_HopPickUp) SetPlayerPos(playerid, 2036.9576, -1381.2347, 48.3188);
	else SetPlayerPos(playerid, 2079.3496, -1393.2665, 17.2797);
	SetPlayerInterior(playerid, 0);
	return 1;
}

stock MapHopital_Command(playerid, const arg[])
{
	if (Admin_Level(playerid) < 7) return SendClientMessage(playerid, VIE_COL_ERR, "Reserve au staff niveau 7."), 1;
	if (arg[0] && !strcmp(arg, "on", true))
	{
		new File:f = fopen("mappings/hopital_ems_ok.txt", io_write);
		if (!f) return SendClientMessage(playerid, VIE_COL_ERR, "Impossible d'ecrire scriptfiles/mappings/hopital_ems_ok.txt."), 1;
		fwrite(f, "La data du jeu contient les modeles 5402/5403 de l'hopital EMS.\r\n");
		fclose(f);
		return SendClientMessage(playerid, POLL_COL, "Hopital EMS : ACTIF au prochain redemarrage. Seulement si 5402/5403 sont remplaces dans la data !"), 1;
	}
	if (arg[0] && !strcmp(arg, "off", true))
	{
		if (fexist("mappings/hopital_ems_ok.txt")) fremove("mappings/hopital_ems_ok.txt");
		return SendClientMessage(playerid, POLL_COL, "Hopital EMS : desactive au prochain redemarrage."), 1;
	}
	new m[160];
	format(m, sizeof m, "Hopital EMS : %s maintenant, %s au prochain redemarrage. /mapdata hopital on | off", g_MapHopital ? ("actif") : ("inactif"), MapHopital_Next() ? ("actif") : ("inactif"));
	return SendClientMessage(playerid, POLL_COL, m), 1;
}
