<?xml version="1.0" encoding="utf-8"?>
<!-- [Crestwood v36] HUD NATIF (vues Android, plus de HTML) : place SOUS la couche WebView du HUD.
     Rien ici ne capte le toucher : les doigts passent au jeu (ou aux boutons natifs). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cwNativeHud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:visibility="gone">

    <com.crestwood.ui.MinimapView
        android:id="@+id/cwMinimap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start" />

    <com.crestwood.ui.InfoPanelView
        android:id="@+id/cwInfoPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp" />

    <com.crestwood.ui.SpeedoView
        android:id="@+id/cwSpeedo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />
</FrameLayout>
