// Lieux : selectionner une ligne active le GPS
stock Aide_Places(playerid)
{
	new t[1600], line[96];
	t = "Lieu\tType\n";
	for (new i = 0; i < sizeof(g_Places); i++)
	{
		format(line, sizeof line, "{FF6B72}%s\tMapping\n", g_Places[i][plName]);
		strcat(t, line, sizeof t);
	}
	for (new e = 0; e < g_EntryCount; e++)
	{
		format(line, sizeof line, "{FF6B72}%s\tIntérieur\n", g_Entries[e][enName]);
		strcat(t, line, sizeof t);
	}
	for (new j = 1; j <= JOB_COUNT; j++)
	{
		format(line, sizeof line, "{FFCC33}%s\tEmploi\n", g_Jobs[j][jbName]);
		strcat(t, line, sizeof t);
	}
	for (new s = 0; s < g_ShopCount; s++)
	{
		format(line, sizeof line, "{FFB454}%s\tBoutique\n", g_Shops[s][shName]);
		strcat(t, line, sizeof t);
	}
	for (new b = 0; b < g_BankCount; b++)
	{
		format(line, sizeof line, "{33CC33}Banque %d\tBanque\n", b + 1);
		strcat(t, line, sizeof t);
	}
	return ShowPlayerDialog(playerid, AIDE_DIALOG_PLACES, DIALOG_STYLE_TABLIST_HEADERS, "{33CCFF}Aide {FFFFFF}- Lieux & GPS", t, "GPS", "Retour");
}

stock Aide_PlaceGps(playerid, row)
{
	new Float:x, Float:y, name[48];
	if (row < sizeof(g_Places)) { x = g_Places[row][plX]; y = g_Places[row][plY]; format(name, sizeof name, "%s", g_Places[row][plName]); }
	else if ((row -= sizeof(g_Places)) < g_EntryCount) { x = g_Entries[row][enOX]; y = g_Entries[row][enOY]; format(name, sizeof name, "%s", g_Entries[row][enName]); }
	else if ((row -= g_EntryCount) < JOB_COUNT) { x = g_Jobs[row + 1][jbX]; y = g_Jobs[row + 1][jbY]; format(name, sizeof name, "%s", g_Jobs[row + 1][jbName]); }
	else if ((row -= JOB_COUNT) < g_ShopCount) { x = g_Shops[row][shX]; y = g_Shops[row][shY]; format(name, sizeof name, "%s", g_Shops[row][shName]); }
	else if ((row -= g_ShopCount) < g_BankCount) { x = g_BankPos[row][0]; y = g_BankPos[row][1]; format(name, sizeof name, "Banque %d", row + 1); }
	else return 0;
	Gps_Set(playerid, x, y);
	new m[96];
	format(m, sizeof m, "GPS active : %s.", name);
	SendClientMessage(playerid, 0x33CCFFFF, m);
	return 1;
}

stock Aide_OnDialog(playerid, dialogid, response, listitem)
{
	switch (dialogid)
	{
		case AIDE_DIALOG_MAIN:
		{
			if (response && listitem >= 0 && listitem < AIDE_CAT_COUNT) Aide_Cat(playerid, g_AideMap[playerid][listitem]);
			return 1;
		}
		case AIDE_DIALOG_CAT:
		{
			if (response) Aide_Main(playerid);
			return 1;
		}
		case AIDE_DIALOG_PLACES:
		{
			if (!response) Aide_Main(playerid);
			else if (listitem >= 0) Aide_PlaceGps(playerid, listitem);
			return 1;
		}
	}
	return 0;
}

stock Aide_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/aide", true) || !strcmp(cmdtext, "/help", true) || !strcmp(cmdtext, "/commandes", true) || !strcmp(cmdtext, "/cmds", true))
	{
		Aide_Main(playerid);
		return 1;
	}
	return 0;
}

// Mecanicien de Los Santos (Mechanic Center) - 150 objets (ccbd7622-Mapping_Mechanic.txt)
stock MapObj_Mechanic()
{
	new tmpobjid;
	tmpobjid = CreateDynamicObject(18981, 1282.291748, -1805.063720, 10.463249, 0.000000, 180.000000, 0.000000, -1, -1, -1, 300.00, 300.00);
	SetDynamicObjectMaterial(tmpobjid, 0, 18065, "ab_sfammumain", "breezewall", 0x00000000);
