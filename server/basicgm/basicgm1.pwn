// ============================================================
//  TABLETTE RP (assets/rp) : serveur dans include/Rp.inc (etait present mais jamais inclus)
// ============================================================
#include <Rp>
#include <Promo>           // codes promo de la tablette RP
#include <Law>             // centrale police / FBI / armee (tablette + commandes)
#include <Svc>             // station-service + location de vehicules (page assets/svc)
#include <Pts>             // [v13] panneau /mappings : mappings, portails, points
#include <Jbl>             // [v14] enceinte JBL + barre rapide du HUD
#include <Cw15>            // [v15] encheres maisons, zones vertes, invisibilite staff, blesses, ceinture, HUD

// ============================================================
//  RP PLUS (31/10/2026) : chat de proximite, actions RP, services des factions
// ------------------------------------------------------------
//  Chat : le texte normal n'est entendu qu'a RPX_CHAT_DIST metres ("Prenom Nom dit : ...").
//    (prefixe RpX_ : le prefixe Rp_ est celui de la tablette RP, include/Rp.inc)
//    /me action   /do description   /ame action (bulle seulement)   /try action (reussi / rate)
//    /b texte (HRP local)   /s texte (crier)   /c texte (chuchoter)   /pm id texte (message prive HRP)
//  Services (membres de la faction) :
//    Medecin   : /soigner id prix          Mecanicien : /reparer id prix
//    Burger    : /servir id prix           Journaliste : /annonce texte
//    Toutes    : /facturer id prix          Le client repond /accepter ou /refuser
//    Police + FBI + Armee : outils de police (menu, menottes, amendes...)
//    Tueur a gages : /primes ; tout le monde : /prime id montant
//  Appels d'urgence : /112 police|medecin|mecano|taxi message (GPS envoye aux membres)
//  Mort : facture d'hopital (RPX_HOSPITAL_FEE), les medecins sont prevenus.
//  Vestiaire : chaque faction peut avoir le sien ; hors police = uniforme simple (skin SA).
// ============================================================
#define RPX_CHAT_DIST          18.0
#define RPX_SHOUT_DIST         40.0
#define RPX_WHISPER_DIST       3.0
#define RPX_OFFER_DIST         6.0
#define RPX_OFFER_SECONDS      40
#define RPX_MAX_PRICE          100000
#define RPX_HOSPITAL_FEE       250
#define RPX_COL_ME             0xC2A2DAFF
#define RPX_COL_DO             0x9EC4E8FF
#define RPX_COL_OOC            0xAFAFAFFF
#define RPX_COL_INFO           0x33CCFFFF
#define RPX_COL_OK             0x33CC33FF
#define RPX_COL_ERR            0xFF6347FF
#define RPX_COL_NEWS           0x7CC576FF

#define RPX_OFF_HEAL           1
#define RPX_OFF_REPAIR         2
#define RPX_OFF_FOOD           3
#define RPX_OFF_BILL           4

new g_RpXOffFrom[MAX_PLAYERS] = {INVALID_PLAYER_ID, ...};
new g_RpXOffType[MAX_PLAYERS];
new g_RpXOffPrice[MAX_PLAYERS];
new g_RpXOffUntil[MAX_PLAYERS];
new g_RpXBounty[MAX_PLAYERS];
new g_RpXLastAnnonce[MAX_PLAYERS];

// uniformes simples : {homme, femme} par type de faction (0..12)
new const g_RpXUniSkin[13][2] =
{
	{0, 0},       // aucune
	{0, 0},       // police : vestiaire de police (tenues personnalisees)
	{275, 308},   // medecin
	{187, 141},   // journaliste
	{147, 150},   // gouvernement
	{127, 93},    // tueur a gages
	{286, 141},   // FBI
	{50, 192},    // mecanicien
	{121, 41},    // terroriste
	{287, 191},   // armee
	{171, 172},   // concessionnaire
	{205, 205},   // burger
	{255, 263}    // taxi
};

stock RpX_Name(playerid, out[], size)
{
	GetPlayerName(playerid, out, size);
	for (new i = 0; out[i]; i++) if (out[i] == '_') out[i] = ' ';
	return 1;
}

// envoie text a tous les joueurs a moins de dist (meme monde / interieur)
stock RpX_Near(playerid, Float:dist, color, const text[])
{
	new Float:x, Float:y, Float:z, w = GetPlayerVirtualWorld(playerid), in = GetPlayerInterior(playerid);
	GetPlayerPos(playerid, x, y, z);
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (!IsPlayerConnected(i) || !g_AuthLogged[i]) continue;
		if (GetPlayerVirtualWorld(i) != w || GetPlayerInterior(i) != in) continue;
		if (!IsPlayerInRangeOfPoint(i, dist, x, y, z)) continue;
		SendClientMessage(i, color, text);
	}
	return 1;
}

// texte long : coupe en deux lignes (limite SA-MP 144 caracteres)
stock RpX_NearLong(playerid, Float:dist, color, const text[])
{
	if (strlen(text) <= 120) return RpX_Near(playerid, dist, color, text);
	new a[128], b[128];
	strmid(a, text, 0, 118, sizeof a); strcat(a, " ...", sizeof a);
	format(b, sizeof b, "... %s", text[118]);
	RpX_Near(playerid, dist, color, a);
	return RpX_Near(playerid, dist, color, b);
}

stock RpX_OnText(playerid, const text[])
{
	new name[MAX_PLAYER_NAME + 1], msg[200];
	RpX_Name(playerid, name, sizeof name);
	format(msg, sizeof msg, "%s dit : %s", name, text);
	RpX_NearLong(playerid, RPX_CHAT_DIST, 0xE6E6E6FF, msg);
	// [Crestwood] pas de bulle : le message est deja dans le chat HTML
	return 0;   // pas de chat global
}

stock RpX_Arg(const cmdtext[], const cmd[])
{
	// retourne l'index du texte apres "/cmd " (ou -1)
	new l = strlen(cmd);
	if (strcmp(cmdtext, cmd, true, l)) return -1;
	if (cmdtext[l] == 0) return l;
	if (cmdtext[l] != ' ') return -1;
	new i = l;
	while (cmdtext[i] == ' ') i++;
	return i;
}

stock RpX_FacOnline(type)
{
	new n = 0;
	for (new i = 0, m = GetMaxPlayers(); i < m; i++) if (IsPlayerConnected(i) && g_AuthLogged[i] && Fac_Type(i) == type) n++;
	return n;
}

// appel d'urgence vers une faction (law = police/FBI/armee)
stock RpX_CallService(playerid, type, const what[], const text[])
{
	new name[MAX_PLAYER_NAME + 1], msg[180], Float:x, Float:y, Float:z, n = 0;
	RpX_Name(playerid, name, sizeof name);
	GetPlayerPos(playerid, x, y, z);
	format(msg, sizeof msg, "[112 %s] %s (%d) : %s", what, name, playerid, text);
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (!IsPlayerConnected(i) || !g_AuthLogged[i]) continue;
		if (type == FACTION_POLICE ? !Fac_IsLaw(i) : (Fac_Type(i) != type)) continue;
		SendClientMessage(i, RPX_COL_INFO, msg);
		Gps_Set(i, x, y);
		n++;
	}
	if (n == 0) return SendClientMessage(playerid, RPX_COL_ERR, "Personne n'est disponible dans ce service pour le moment.");
	format(msg, sizeof msg, "Appel transmis (%d personne(s) de garde). Reste sur place.", n);
	return SendClientMessage(playerid, RPX_COL_OK, msg);
}

stock RpX_Offer(playerid, const params[], type, need)
{
	if (need != FACTION_NONE && Fac_Type(playerid) != need) return SendClientMessage(playerid, RPX_COL_ERR, "Ce service n'est pas celui de ta faction.");
	if (need == FACTION_NONE && Fac_Type(playerid) == FACTION_NONE) return SendClientMessage(playerid, RPX_COL_ERR, "Il faut etre dans une faction pour facturer.");
	new idx = 0, tok[16];
	if (!Bank_NextToken(params, idx, tok, sizeof tok)) return SendClientMessage(playerid, RPX_COL_INFO, "Utilisation : <id> <prix>");
	new t = strval(tok);
	if (!Bank_NextToken(params, idx, tok, sizeof tok)) return SendClientMessage(playerid, RPX_COL_INFO, "Utilisation : <id> <prix>");
	new price = strval(tok);
	if (t == playerid || t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || !g_AuthLogged[t]) return SendClientMessage(playerid, RPX_COL_ERR, "Joueur introuvable.");
	if (price < 0 || price > RPX_MAX_PRICE) return SendClientMessage(playerid, RPX_COL_ERR, "Prix invalide.");
	new Float:x, Float:y, Float:z;
	GetPlayerPos(t, x, y, z);
	if (!IsPlayerInRangeOfPoint(playerid, RPX_OFFER_DIST, x, y, z)) return SendClientMessage(playerid, RPX_COL_ERR, "Approche-toi de la personne.");
	if (type == RPX_OFF_REPAIR && !IsPlayerInAnyVehicle(t)) return SendClientMessage(playerid, RPX_COL_ERR, "Le client doit etre dans son vehicule.");
	g_RpXOffFrom[t] = playerid; g_RpXOffType[t] = type; g_RpXOffPrice[t] = price; g_RpXOffUntil[t] = gettime() + RPX_OFFER_SECONDS;
	new name[MAX_PLAYER_NAME + 1], msg[150];
	RpX_Name(playerid, name, sizeof name);
	new const what[5][] = {"", "des soins", "une reparation", "un repas", "une facture"};
	format(msg, sizeof msg, "%s te propose %s pour %d FCFA. /accepter ou /refuser (%d s).", name, what[type], price, RPX_OFFER_SECONDS);
	SendClientMessage(t, RPX_COL_INFO, msg);
	format(msg, sizeof msg, "Proposition envoyee (%d FCFA).", price);
	return SendClientMessage(playerid, RPX_COL_OK, msg);
}

stock RpX_Accept(playerid)
{
	new from = g_RpXOffFrom[playerid];
	if (from == INVALID_PLAYER_ID || gettime() > g_RpXOffUntil[playerid]) { g_RpXOffFrom[playerid] = INVALID_PLAYER_ID; return SendClientMessage(playerid, RPX_COL_ERR, "Aucune proposition en attente."); }
	g_RpXOffFrom[playerid] = INVALID_PLAYER_ID;
	if (!IsPlayerConnected(from)) return SendClientMessage(playerid, RPX_COL_ERR, "La personne est partie.");
	new Float:x, Float:y, Float:z;
	GetPlayerPos(from, x, y, z);
	if (!IsPlayerInRangeOfPoint(playerid, RPX_OFFER_DIST + 2.0, x, y, z)) return SendClientMessage(playerid, RPX_COL_ERR, "Vous etes trop loin l'un de l'autre.");
	new price = g_RpXOffPrice[playerid];
	if (GetPlayerMoney(playerid) < price) return SendClientMessage(playerid, RPX_COL_ERR, "Tu n'as pas assez d'argent liquide."), SendClientMessage(from, RPX_COL_ERR, "Le client n'a pas assez d'argent.");
	switch (g_RpXOffType[playerid])
	{
		case RPX_OFF_HEAL: SetPlayerHealth(playerid, 100.0);
		case RPX_OFF_REPAIR:
		{
			new v = GetPlayerVehicleID(playerid);
			if (!v) return SendClientMessage(playerid, RPX_COL_ERR, "Tu dois etre dans ton vehicule.");
			RepairVehicle(v);
		}
		case RPX_OFF_FOOD:
		{
			new Float:h; GetPlayerHealth(playerid, h);
			h += 30.0; if (h > 100.0) h = 100.0;
			SetPlayerHealth(playerid, h);
			Inv_SetQty(playerid, "hamburger", Inv_GetQty(playerid, "hamburger") + 1);
			ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
		}
	}
	if (price > 0) { GivePlayerMoney(playerid, -price); GivePlayerMoney(from, price); }
	new a[MAX_PLAYER_NAME + 1], b[MAX_PLAYER_NAME + 1], msg[150];
	RpX_Name(playerid, a, sizeof a); RpX_Name(from, b, sizeof b);
	format(msg, sizeof msg, "Paiement de %d FCFA a %s : c'est fait.", price, b);
	SendClientMessage(playerid, RPX_COL_OK, msg);
	format(msg, sizeof msg, "%s a accepte : +%d FCFA.", a, price);
	return SendClientMessage(from, RPX_COL_OK, msg);
}

forward RpX_UniformBack(playerid);
public RpX_UniformBack(playerid)
{
	if (IsPlayerConnected(playerid) && g_RpXUni[playerid]) SetPlayerSkin(playerid, g_RpXUni[playerid]);
	return 1;
}

stock RpX_WearUniform(playerid, female)
{
	new t = Fac_Type(playerid);
	if (t <= FACTION_NONE || t > 12) return 0;
	new skin = g_RpXUniSkin[t][female ? 1 : 0];
	if (!skin) return 0;
	g_RpXUni[playerid] = skin;
	SetPlayerSkin(playerid, skin);
	return 1;
}

stock RpX_RemoveUniform(playerid)
{
	g_RpXUni[playerid] = 0;
	if (!g_ClothLoaded[playerid]) Cloth_Load(playerid);
	SetPlayerSkin(playerid, g_ClothSkin[playerid]);
	Cloth_Send(playerid, CLOTH_DIALOG_APPLY);
	Cloth_Broadcast(playerid);
	return 1;
}

stock RpX_OnSpawn(playerid)
{
	if (g_RpXUni[playerid]) SetTimerEx("RpX_UniformBack", 600, false, "i", playerid);   // apres la tenue civile
	return 1;
}

stock RpX_OnConnect(playerid)
{
	g_RpXOffFrom[playerid] = INVALID_PLAYER_ID;
	g_RpXBounty[playerid] = 0;
	g_RpXUni[playerid] = 0;
	g_RpXLastAnnonce[playerid] = 0;
	return 1;
}

stock RpX_OnDeath(playerid, killerid)
{
	new name[MAX_PLAYER_NAME + 1], msg[150], Float:x, Float:y, Float:z;
	RpX_Name(playerid, name, sizeof name);
	// prime sur la tete : payee au tueur a gages
	if (killerid != INVALID_PLAYER_ID && IsPlayerConnected(killerid) && g_RpXBounty[playerid] > 0 && Fac_Type(killerid) == FACTION_HITMAN)
	{
		GivePlayerMoney(killerid, g_RpXBounty[playerid]);
		format(msg, sizeof msg, "Contrat rempli : %s. +%d FCFA.", name, g_RpXBounty[playerid]);
		SendClientMessage(killerid, RPX_COL_OK, msg);
		g_RpXBounty[playerid] = 0;
	}
	// medecins prevenus
	GetPlayerPos(playerid, x, y, z);
	format(msg, sizeof msg, "[URGENCE] Personne inconsciente : %s (%d). Position envoyee au GPS.", name, playerid);
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		if (i != playerid && IsPlayerConnected(i) && g_AuthLogged[i] && Fac_Type(i) == FACTION_MEDIC) { SendClientMessage(i, RPX_COL_INFO, msg); Gps_Set(i, x, y); }
	// facture d'hopital
	new fee = RPX_HOSPITAL_FEE;
	if (GetPlayerMoney(playerid) < fee) fee = GetPlayerMoney(playerid);
	if (fee > 0)
	{
		GivePlayerMoney(playerid, -fee);
		format(msg, sizeof msg, "Hopital : tu as ete soigne. Facture : %d FCFA.", fee);
		SendClientMessage(playerid, RPX_COL_INFO, msg);
	}
	return 1;
}

stock RpX_OnCommand(playerid, const cmdtext[])
{
	if (!g_AuthLogged[playerid]) return 0;
	new a, name[MAX_PLAYER_NAME + 1], msg[200];
	RpX_Name(playerid, name, sizeof name);

	if ((a = RpX_Arg(cmdtext, "/me")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/me <action>"), 1;
		format(msg, sizeof msg, "* %s %s", name, cmdtext[a]);
		RpX_NearLong(playerid, RPX_CHAT_DIST, RPX_COL_ME, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/do")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/do <description>"), 1;
		format(msg, sizeof msg, "* %s (( %s ))", cmdtext[a], name);
		RpX_NearLong(playerid, RPX_CHAT_DIST, RPX_COL_DO, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/ame")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/ame <action>"), 1;
		format(msg, sizeof msg, "* %s", cmdtext[a]);
		format(msg, sizeof msg, "* %s %s", name, cmdtext[a]);
		RpX_NearLong(playerid, RPX_CHAT_DIST, RPX_COL_ME, msg);   // [Crestwood] plus de bulle : comme /me
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/try")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/try <action>"), 1;
		format(msg, sizeof msg, "* %s essaie de %s et %s", name, cmdtext[a], random(2) ? ("reussit.") : ("echoue."));
		RpX_NearLong(playerid, RPX_CHAT_DIST, RPX_COL_ME, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/b")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/b <texte hors RP>"), 1;
		format(msg, sizeof msg, "(( %s [%d] : %s ))", name, playerid, cmdtext[a]);
		RpX_NearLong(playerid, RPX_CHAT_DIST, RPX_COL_OOC, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/s")) != -1 || (a = RpX_Arg(cmdtext, "/crier")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/s <texte crie>"), 1;
		format(msg, sizeof msg, "%s crie : %s !", name, cmdtext[a]);
		RpX_NearLong(playerid, RPX_SHOUT_DIST, 0xFFFFFFFF, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/c")) != -1 || (a = RpX_Arg(cmdtext, "/chuchoter")) != -1)
	{
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/c <texte chuchote>"), 1;
		format(msg, sizeof msg, "%s chuchote : %s", name, cmdtext[a]);
		RpX_NearLong(playerid, RPX_WHISPER_DIST, 0xBBBBBBFF, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/pm")) != -1)
	{
		new idx = a, tok[8];
		if (!Bank_NextToken(cmdtext, idx, tok, sizeof tok)) return SendClientMessage(playerid, RPX_COL_INFO, "/pm <id> <message>"), 1;
		new t = strval(tok);
		while (cmdtext[idx] == ' ') idx++;
		if (!cmdtext[idx] || t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || t == playerid) return SendClientMessage(playerid, RPX_COL_ERR, "/pm <id> <message> (joueur connecte)"), 1;
		new tn[MAX_PLAYER_NAME + 1];
		RpX_Name(t, tn, sizeof tn);
		format(msg, sizeof msg, "(( MP de %s [%d] : %s ))", name, playerid, cmdtext[idx]);
		SendClientMessage(t, 0xFFDC64FF, msg);
		format(msg, sizeof msg, "(( MP a %s [%d] : %s ))", tn, t, cmdtext[idx]);
		SendClientMessage(playerid, 0xFFDC64FF, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/annonce")) != -1)
	{
		if (Fac_Type(playerid) != FACTION_NEWS) return SendClientMessage(playerid, RPX_COL_ERR, "Reserve aux journalistes."), 1;
		if (!cmdtext[a]) return SendClientMessage(playerid, RPX_COL_INFO, "/annonce <texte>"), 1;
		if (gettime() - g_RpXLastAnnonce[playerid] < 30) return SendClientMessage(playerid, RPX_COL_ERR, "Attends 30 secondes entre deux annonces."), 1;
		g_RpXLastAnnonce[playerid] = gettime();
		format(msg, sizeof msg, "[Crestwood News] %s : %s", name, cmdtext[a]);
		SendClientMessageToAll(RPX_COL_NEWS, msg);
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/soigner")) != -1) return RpX_Offer(playerid, cmdtext[a], RPX_OFF_HEAL, FACTION_MEDIC), 1;
	if ((a = RpX_Arg(cmdtext, "/reparer")) != -1) return RpX_Offer(playerid, cmdtext[a], RPX_OFF_REPAIR, FACTION_MECHANIC), 1;
	if ((a = RpX_Arg(cmdtext, "/servir")) != -1) return RpX_Offer(playerid, cmdtext[a], RPX_OFF_FOOD, FACTION_BURGER), 1;
	if ((a = RpX_Arg(cmdtext, "/facturer")) != -1) return RpX_Offer(playerid, cmdtext[a], RPX_OFF_BILL, FACTION_NONE), 1;
	if (!strcmp(cmdtext, "/accepter", true)) return RpX_Accept(playerid), 1;
	if (!strcmp(cmdtext, "/refuser", true))
	{
		new from = g_RpXOffFrom[playerid];
		g_RpXOffFrom[playerid] = INVALID_PLAYER_ID;
		if (from != INVALID_PLAYER_ID && IsPlayerConnected(from)) SendClientMessage(from, RPX_COL_ERR, "Le client a refuse ta proposition.");
		return SendClientMessage(playerid, RPX_COL_INFO, "Proposition refusee."), 1;
	}
	if ((a = RpX_Arg(cmdtext, "/112")) != -1 || (a = RpX_Arg(cmdtext, "/appel")) != -1)
	{
		new idx = a, svc[12];
		if (!Bank_NextToken(cmdtext, idx, svc, sizeof svc)) return SendClientMessage(playerid, RPX_COL_INFO, "/112 police|medecin|mecano|taxi <message>"), 1;
		while (cmdtext[idx] == ' ') idx++;
		new text[100];
		if (cmdtext[idx]) format(text, sizeof text, "%s", cmdtext[idx]);
		else format(text, sizeof text, "Besoin d'aide");
		if (!strcmp(svc, "police", true)) RpX_CallService(playerid, FACTION_POLICE, "POLICE", text);
		else if (!strcmp(svc, "medecin", true) || !strcmp(svc, "samu", true)) RpX_CallService(playerid, FACTION_MEDIC, "MEDECIN", text);
		else if (!strcmp(svc, "mecano", true)) RpX_CallService(playerid, FACTION_MECHANIC, "MECANO", text);
		else if (!strcmp(svc, "taxi", true)) RpX_CallService(playerid, FACTION_TAXIDRIVER, "TAXI", text);
		else SendClientMessage(playerid, RPX_COL_INFO, "/112 police|medecin|mecano|taxi <message>");
		return 1;
	}
	if ((a = RpX_Arg(cmdtext, "/prime")) != -1)
	{
		new idx = a, tok[16];
		if (!Bank_NextToken(cmdtext, idx, tok, sizeof tok)) return SendClientMessage(playerid, RPX_COL_INFO, "/prime <id> <montant> (contrat pour les tueurs a gages)"), 1;
		new t = strval(tok);
		if (!Bank_NextToken(cmdtext, idx, tok, sizeof tok)) return SendClientMessage(playerid, RPX_COL_INFO, "/prime <id> <montant>"), 1;
		new amount = strval(tok);
		if (t == playerid || t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t)) return SendClientMessage(playerid, RPX_COL_ERR, "Joueur introuvable."), 1;
		if (amount < 500 || amount > RPX_MAX_PRICE) return SendClientMessage(playerid, RPX_COL_ERR, "Montant : 500 a 100000 FCFA."), 1;
		if (GetPlayerMoney(playerid) < amount) return SendClientMessage(playerid, RPX_COL_ERR, "Pas assez d'argent liquide."), 1;
		GivePlayerMoney(playerid, -amount);
		g_RpXBounty[t] += amount;
		SendClientMessage(playerid, RPX_COL_OK, "Contrat depose. Les tueurs a gages sont prevenus (anonyme).");
		new tn[MAX_PLAYER_NAME + 1];
		RpX_Name(t, tn, sizeof tn);
		format(msg, sizeof msg, "[CONTRAT] Nouvelle cible : %s (%d) - prime %d FCFA. /primes", tn, t, g_RpXBounty[t]);
		for (new i = 0, m = GetMaxPlayers(); i < m; i++) if (IsPlayerConnected(i) && Fac_Type(i) == FACTION_HITMAN) SendClientMessage(i, RPX_COL_ERR, msg);
		return 1;
	}
	if (!strcmp(cmdtext, "/primes", true))
	{
		if (Fac_Type(playerid) != FACTION_HITMAN) return SendClientMessage(playerid, RPX_COL_ERR, "Reserve aux tueurs a gages."), 1;
		new n = 0, tn[MAX_PLAYER_NAME + 1];
		for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		{
			if (!IsPlayerConnected(i) || g_RpXBounty[i] <= 0) continue;
			RpX_Name(i, tn, sizeof tn);
			format(msg, sizeof msg, "- %s (%d) : %d FCFA", tn, i, g_RpXBounty[i]);
			SendClientMessage(playerid, RPX_COL_INFO, msg);
			n++;
		}
		if (!n) SendClientMessage(playerid, RPX_COL_INFO, "Aucun contrat en cours.");
		return 1;
	}
	// telephone : mon numero / donner son numero a la personne en face
	if (!strcmp(cmdtext, "/numero", true) || !strcmp(cmdtext, "/monnumero", true))
	{
		new pnum[12];
		if (!Phone_GetNumber(playerid, pnum, sizeof pnum)) return SendClientMessage(playerid, RPX_COL_ERR, "Tu n'as pas de numero : utilise une carte SIM (inventaire) ou ouvre ton telephone."), 1;
		format(msg, sizeof msg, "Ton numero de telephone : %s", pnum);
		return SendClientMessage(playerid, RPX_COL_INFO, msg), 1;
	}
	if ((a = RpX_Arg(cmdtext, "/donnernumero")) != -1)
	{
		new t = strval(cmdtext[a]), pnum[12];
		if (!cmdtext[a] || t == playerid || t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || !g_AuthLogged[t]) return SendClientMessage(playerid, RPX_COL_INFO, "/donnernumero <id> (joueur a cote de toi)"), 1;
		new Float:x, Float:y, Float:z;
		GetPlayerPos(t, x, y, z);
		if (!IsPlayerInRangeOfPoint(playerid, 4.0, x, y, z)) return SendClientMessage(playerid, RPX_COL_ERR, "Approche-toi de la personne."), 1;
		if (!Phone_GetNumber(playerid, pnum, sizeof pnum)) return SendClientMessage(playerid, RPX_COL_ERR, "Tu n'as pas encore de numero."), 1;
		if (g_PhDB != DB:0)
		{
			new tname[MAX_PLAYER_NAME + 1], cname[25], q[220];
			GetPlayerName(t, tname, sizeof tname);
			format(cname, sizeof cname, "%s", name);
			format(q, sizeof q, "DELETE FROM contacts WHERE owner = '%s' AND num = '%s'", tname, pnum);
			db_free_result(db_query(g_PhDB, q));
			format(q, sizeof q, "INSERT INTO contacts (owner, num, cname) VALUES ('%s', '%s', '%s')", tname, pnum, cname);
			db_free_result(db_query(g_PhDB, q));
		}
		format(msg, sizeof msg, "%s t'a donne son numero (%s) : il est dans tes contacts.", name, pnum);
		SendClientMessage(t, RPX_COL_OK, msg);
		format(msg, sizeof msg, "* %s donne son numero de telephone.", name);
		RpX_Near(playerid, 10.0, RPX_COL_ME, msg);
		return 1;
	}
	if (!strcmp(cmdtext, "/rpaide", true))
	{
		SendClientMessage(playerid, RPX_COL_INFO, "RP : /me /do /ame /try | /b (HRP) /s (crier) /c (chuchoter) /pm id texte");
		SendClientMessage(playerid, RPX_COL_INFO, "Services : /112 police|medecin|mecano|taxi texte | /accepter /refuser | /prime id montant");
		SendClientMessage(playerid, RPX_COL_INFO, "Factions : /soigner /reparer /servir /facturer id prix | /annonce | /primes | vestiaire (main 3D)");
		SendClientMessage(playerid, RPX_COL_INFO, "Telephone : /numero /donnernumero id | Police-FBI-Armee : /mdt /renfort /m /recherche /effacer /badge /barrage");
		return 1;
	}
	return 0;
}

// ------------------------------------------------------------
//  Icones 3D des points fixes (remplacent les pickups et les textes 3D)
// ------------------------------------------------------------
stock Cw_PushMarks()
{
	for (new i = 0; i < g_BankCount; i++) Mk_Add(6, g_BankPos[i][0], g_BankPos[i][1], g_BankPos[i][2] - 0.95);
	for (new i = 0; i < g_ShopCount; i++) Mk_Add(4, g_Shops[i][shX], g_Shops[i][shY], g_Shops[i][shZ] - 0.95);
	for (new j = 1; j <= JOB_COUNT; j++) if (g_JobPlaced[j]) Mk_Add(7, g_Jobs[j][jbX], g_Jobs[j][jbY], g_Jobs[j][jbZ] - 0.95);
	for (new e = 0; e < g_EntryCount; e++)
	{
		if (!Entry_Ready(e)) continue;
		Mk_Add(8, g_Entries[e][enOX], g_Entries[e][enOY], g_Entries[e][enOZ] - 0.95);
		Mk_Add(9, g_Entries[e][enIX], g_Entries[e][enIY], g_Entries[e][enIZ] - 0.95);
	}
	for (new l = 0; l < LOCKER_MAX; l++) if (g_LkUsed[l]) Mk_Add(5, g_LkX[l], g_LkY[l], g_LkZ[l]);
	return 1;
}

// ------------------------------------------------------------
//  [v13] Identite du personnage : date de naissance, origine, genre (decide le corps)
// ------------------------------------------------------------
stock Id_BodyOf(playerid)
{
	return (g_IdGender[playerid] == 1) ? CLOTH_SKIN_FEMALE : CLOTH_SKIN_MALE;
}

// 1 = identite deja remplie (chargee), 0 = a demander
stock Id_Load(playerid, const user[])
{
	g_IdGender[playerid] = -1; g_IdBirth[playerid][0] = 0; g_IdOrigin[playerid][0] = 0;
	if (g_AuthDB == DB:0) return 1;
	new q[160], f[32];
	format(q, sizeof q, "SELECT gender, birth, origin FROM accounts WHERE name = '%s' LIMIT 1", user);
	new DBResult:r = db_query(g_AuthDB, q);
	if (r == DBResult:0) return 1;
	if (db_num_rows(r) > 0)
	{
		db_get_field(r, 0, f, sizeof f); g_IdGender[playerid] = strval(f);
		db_get_field(r, 1, g_IdBirth[playerid], 12);
		db_get_field(r, 2, g_IdOrigin[playerid], 26);
	}
	db_free_result(r);
	return (g_IdGender[playerid] == 0 || g_IdGender[playerid] == 1) ? 1 : 0;
}

// /authact identity <jj/mm/aaaa> <0|1> <origine>
stock Id_DoSet(playerid, const params[])
{
	if (!g_AuthLogged[playerid] || !g_IdPending[playerid]) return 0;
	new idx = 0, birth[16], gtok[4], origin[32];
	Bank_NextToken(params, idx, birth, sizeof birth);
	Bank_NextToken(params, idx, gtok, sizeof gtok);
	Bank_NextToken(params, idx, origin, sizeof origin);
	new gender = strval(gtok);
	if ((gtok[0] != '0' && gtok[0] != '1') || gtok[1] != 0) return Auth_Reply(playerid, "error", "Genre", "Choisis Homme ou Femme.");
	// date jj/mm/aaaa
	new d = 0, mo = 0, y = 0, part = 0, val = 0, len = strlen(birth);
	for (new i = 0; i <= len; i++)
	{
		if (i == len || birth[i] == '/')
		{
			if (part == 0) d = val; else if (part == 1) mo = val; else y = val;
			part++; val = 0;
		}
		else if (birth[i] >= '0' && birth[i] <= '9') val = val * 10 + (birth[i] - '0');
		else return Auth_Reply(playerid, "error", "Date de naissance", "Format attendu : jj/mm/aaaa.");
	}
	if (part != 3 || d < 1 || d > 31 || mo < 1 || mo > 12 || y < 1930 || y > 2010) return Auth_Reply(playerid, "error", "Date de naissance", "Date invalide (annee entre 1930 et 2010).");
	// origine : lettres, espaces ("_" envoye par l'application), tirets
	new clean[26], j = 0;
	for (new i = 0; origin[i] != 0 && j < sizeof(clean) - 1; i++)
	{
		new c = origin[i];
		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-') clean[j++] = c;
		else if (c == '_') clean[j++] = ' ';
	}
	clean[j] = 0;
	if (j < 2) return Auth_Reply(playerid, "error", "Origine", "Indique ton origine.");
	new name[MAX_PLAYER_NAME + 1], q[220];
	GetPlayerName(playerid, name, sizeof name);
	format(g_IdBirth[playerid], 12, "%02d/%02d/%04d", d, mo, y);
	format(g_IdOrigin[playerid], 26, "%s", clean);
	g_IdGender[playerid] = gender;
	format(q, sizeof q, "UPDATE accounts SET birth = '%s', origin = '%s', gender = %d WHERE name = '%s'", g_IdBirth[playerid], g_IdOrigin[playerid], gender, name);
	db_free_result(db_query(g_AuthDB, q));
	// corps du genre choisi ; si le corps change, tenue par defaut
	if (!g_ClothLoaded[playerid]) Cloth_Load(playerid);
	new body = Id_BodyOf(playerid);
	if (g_ClothSkin[playerid] != body)
	{
		for (new i = 0; i < CLOTH_COUNT; i++) g_ClothV[playerid][i] = g_ClothDefault[i];
		g_ClothSkin[playerid] = body;
	}
	g_ClothSaved[playerid] = 1;   // personnage cree : la tenue se change ensuite dans les boutiques
	Cloth_SaveToDB(playerid);
	g_IdPending[playerid] = 0;
	Auth_Reply(playerid, "success", "Bienvenue", "Personnage cree. Bon jeu !", "", 1);
	SetTimerEx("Auth_Finish", 900, false, "i", playerid);
	return 1;
}
