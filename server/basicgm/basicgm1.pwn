			strcat(t, "{33CCFF}/permis\t{FFFFFF}Tes permis et licences\n", sizeof t);
			strcat(t, "{33CCFF}/tenues\t{FFFFFF}Garde-robe (civile, vestiaire, apparence)\n", sizeof t);
			strcat(t, "{33CCFF}/garage\t{FFFFFF}Tes vehicules (partout, ou la roue du HUD)\n", sizeof t);
			strcat(t, "{33CCFF}/mairie\t{FFFFFF}GPS vers la mairie de Los Santos\n", sizeof t);
			strcat(t, "{33CCFF}/position\t{FFFFFF}Affiche tes coordonnées\n", sizeof t);
			strcat(t, "{33CCFF}/gps\t{FFFFFF}Efface le GPS (ou remet celui de ta mission)", sizeof t);
		}
		case 1:
		{
			strcat(t, "{33CC33}/banque\t{FFFFFF}Ouvre la banque (près d'un point banque)\n", sizeof t);
			strcat(t, "{33CC33}/argent\t{FFFFFF}Affiche ton liquide et ton solde\n", sizeof t);
