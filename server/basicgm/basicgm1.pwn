	RemoveBuildingForPlayer(playerid, 3286, 392.710, 2596.453, 17.632, 0.250);
	RemoveBuildingForPlayer(playerid, 3286, 389.132, 2611.062, 20.171, 0.250);
	RemoveBuildingForPlayer(playerid, 16327, 412.828, 2542.867, 15.539, 0.250);
	RemoveBuildingForPlayer(playerid, 16374, 425.468, 2531.000, 22.554, 0.250);
	RemoveBuildingForPlayer(playerid, 16790, 425.468, 2531.000, 22.554, 0.250);
	RemoveBuildingForPlayer(playerid, 16601, 435.625, 2532.085, 20.179, 0.250);
	return 1;
}

// ============================================================
//  INTERFACES JOUEUR (assets/ui/index.html)
// ------------------------------------------------------------
//  Menu d'interaction avec un joueur, gestion du vehicule, carte
//  d'identite, permis & licences, tenues.
//  serveur -> client : ShowPlayerDialog(9630 ouvrir / 9631 mise a jour /
//                      9632 fermer, caption "@ui", info = JSON {"view":...})
//  client -> serveur : /uiact <action> [arg]
//  Commandes : /interaction (/inter), /vmenu, /papiers, /permis, /tenues
//  Icone de main "Joueur" quand un autre joueur est tout pres.
// ============================================================

#define UI_DIALOG_OPEN        9630
#define UI_DIALOG_UPDATE      9631
#define UI_DIALOG_CLOSE       9632
#define UI_DIALOG_GIVE        9633        // saisie du montant a donner (dialogue SA-MP)
#define UI_DIALOG_ID_AGE      9634        // creation des papiers : age
#define UI_DIALOG_ID_ORIGIN   9635        // creation des papiers : origine

#define UI_PLAYER_RANGE       2.5
#define UI_TAP_RANGE          8.0         // double tap sur un joueur : distance max
#define UI_COOLDOWN_MS        700
#define UI_COL_OK             0x33CC33FF
#define UI_COL_ERR            0xFF4444FF
#define UI_COL_INFO           0x33CCFFFF

new g_UiOpen[MAX_PLAYERS];
new g_UiTarget[MAX_PLAYERS];
new g_UiVeh[MAX_PLAYERS];
new g_UiLast[MAX_PLAYERS];
new g_UiIdAge[MAX_PLAYERS];
new g_UiDoorsOpen[MAX_VEHICLES];

stock Ui_Send(playerid, dialogid, json[])
{
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@ui", json, "OK", "");
}

stock Ui_Close(playerid, notifyClient)
{
	if (!g_UiOpen[playerid]) return 0;
	g_UiOpen[playerid] = 0;
	if (notifyClient) Ui_Send(playerid, UI_DIALOG_CLOSE, "{}");
	return 1;
}

stock Ui_Toast(playerid, ok, const msg[])
{
	if (g_UiOpen[playerid])
	{
		new json[200];
		format(json, sizeof json, "{\"view\":\"\",\"ok\":%d,\"msg\":\"%s\"}", ok, msg);
		Ui_Send(playerid, UI_DIALOG_UPDATE, json);
	}
	else SendClientMessage(playerid, ok ? UI_COL_OK : UI_COL_ERR, msg);
	return 1;
}

// Joueur le plus proche (a pied, meme monde), INVALID_PLAYER_ID sinon
stock Ui_NearestPlayer(playerid, Float:range = UI_PLAYER_RANGE)
{
	new best = INVALID_PLAYER_ID, Float:bd = range, Float:x, Float:y, Float:z, Float:d;
	GetPlayerPos(playerid, x, y, z);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (i == playerid || !IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
		if (GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid) || GetPlayerState(i) == PLAYER_STATE_SPECTATING) continue;
		d = GetPlayerDistanceFromPoint(i, x, y, z);
		if (d <= bd) { bd = d; best = i; }
	}
	return best;
}

stock Ui_TargetValid(playerid, t)
{
	if (t == INVALID_PLAYER_ID || t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || t == playerid) return 0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(t, x, y, z);
	return IsPlayerInRangeOfPoint(playerid, UI_TAP_RANGE, x, y, z);
}

stock Ui_InteractKey(playerid)
{
	if (g_UiOpen[playerid]) return 0;
	if (Ui_NearestPlayer(playerid) == INVALID_PLAYER_ID) return 0;
	return INTERACT_PLAYER * 10;
}

// ------------------------------------------------------------
//  Papiers d'identite (Prenom_Nom + age + origine)
// ------------------------------------------------------------
stock Ui_InitDB()
{
	if (g_JobDB == DB:0) return 0;
	db_free_result(db_query(g_JobDB, "CREATE TABLE IF NOT EXISTS player_ids (name TEXT PRIMARY KEY COLLATE NOCASE, age INTEGER, origin TEXT)"));
	return 1;
}

stock Ui_LoadId(playerid, &age, origin[], osize)
{
	age = 0; origin[0] = 0;
	new name[MAX_PLAYER_NAME + 1], q[160], f[12];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT age, origin FROM player_ids WHERE name = '%s' LIMIT 1", name);
	new DBResult:res = db_query(g_JobDB, q);
	new ok = db_num_rows(res) > 0;
	if (ok)
	{
		db_get_field(res, 0, f, sizeof f); age = strval(f);
		db_get_field(res, 1, origin, osize);
	}
	db_free_result(res);
	return ok;
}

// Prenom / Nom depuis le pseudo Prenom_Nom
stock Ui_SplitName(playerid, first[], fsize, last[], lsize)
{
	new name[MAX_PLAYER_NAME + 1], u = -1;
	GetPlayerName(playerid, name, sizeof name);
	for (new i = 0; name[i]; i++) if (name[i] == '_') { u = i; break; }
	if (u == -1) { format(first, fsize, "%s", name); format(last, lsize, "-"); return 1; }
	name[u] = 0;
	format(first, fsize, "%s", name);
	format(last, lsize, "%s", name[u + 1]);
	return 1;
}

// Affiche les papiers de 'owner' a 'viewer'
stock Ui_ShowId(viewer, owner)
{
	new age, origin[32], first[24], last[24], json[300];
	if (!Ui_LoadId(owner, age, origin, sizeof origin)) return 0;
	Ui_SplitName(owner, first, sizeof first, last, sizeof last);
	new shownBy[MAX_PLAYER_NAME + 1];
	shownBy[0] = 0;
	if (viewer != owner) Fx_RPName(owner, shownBy, sizeof shownBy);
	format(json, sizeof json, "{\"view\":\"id\",\"nom\":\"%s\",\"prenom\":\"%s\",\"age\":%d,\"origine\":\"%s\",\"shownBy\":\"%s\",\"num\":%d}",
		last, first, age, origin, shownBy, 100000 + (Bank_HashPin(age, strlen(first) * 97 + strlen(last)) & 0x7FFFF) % 900000);
	g_UiOpen[viewer] = 1;
	return Ui_Send(viewer, UI_DIALOG_OPEN, json);
}

stock Ui_Papers(playerid)
{
	new age, origin[32];
	if (Ui_LoadId(playerid, age, origin, sizeof origin)) return Ui_ShowId(playerid, playerid);
	return ShowPlayerDialog(playerid, UI_DIALOG_ID_AGE, DIALOG_STYLE_INPUT, "{33CCFF}Carte d'identité {FFFFFF}- Création",
		"Tu n'as pas encore de papiers.\n\nQuel âge a ton personnage ? (16 à 90 ans)", "Suivant", "Annuler");
}

stock Ui_CleanOrigin(const src[], out[], osize)
{
	new j = 0;
	for (new i = 0; src[i] && j < osize - 1; i++)
	{
		new c = src[i];
		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == ' ' || c == '-' || (c >= 0xC0 && c <= 0xFF)) out[j++] = c;
	}
	out[j] = 0;
	return j;
}

// ------------------------------------------------------------
//  Vues
// ------------------------------------------------------------
// target = -1 : le joueur le plus proche ; sinon le joueur touche deux fois a l'ecran (double tap)
stock Ui_OpenPlayer(playerid, target = -1)
{
	if (!g_AuthLogged[playerid]) return 0;
	if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) { SendClientMessage(playerid, UI_COL_ERR, "Interaction : descends de ton vehicule."); return 0; }
	new t = INVALID_PLAYER_ID;
	if (target >= 0)
	{
		if (target < MAX_PLAYERS && IsPlayerConnected(target) && target != playerid && GetPlayerVirtualWorld(target) == GetPlayerVirtualWorld(playerid))
		{
			new Float:x, Float:y, Float:z;
			GetPlayerPos(target, x, y, z);
			if (IsPlayerInRangeOfPoint(playerid, UI_TAP_RANGE, x, y, z)) t = target;
			else { SendClientMessage(playerid, UI_COL_ERR, "Interaction : rapproche-toi de ce joueur."); return 0; }
		}
	}
	else t = Ui_NearestPlayer(playerid);
	if (t == INVALID_PLAYER_ID) { SendClientMessage(playerid, UI_COL_ERR, "Interaction : aucun joueur a cote de toi."); return 0; }
	new tname[MAX_PLAYER_NAME + 1], json[200];
	Fx_RPName(t, tname, sizeof tname);
	g_UiTarget[playerid] = t;
	g_UiOpen[playerid] = 1;
	format(json, sizeof json, "{\"view\":\"player\",\"target\":%d,\"targetName\":\"%s\",\"police\":%d,\"gov\":%d}", t, tname, Fac_IsLaw(playerid) ? 1 : 0, Gov_Is(playerid) ? 1 : 0);
	return Ui_Send(playerid, UI_DIALOG_OPEN, json);
}

// Vehicule concerne : celui ou l'on est, sinon le sien a portee
stock Ui_FindVehicle(playerid)
{
	new v = GetPlayerVehicleID(playerid);
	if (v) return v;
	new own = g_PlayerVeh[playerid];
	if (own != INVALID_VEHICLE_ID && own > 0 && g_VehOwner[own] == playerid)
	{
		new Float:x, Float:y, Float:z;
		GetVehiclePos(own, x, y, z);
		if (IsPlayerInRangeOfPoint(playerid, VEH_LOCK_RANGE, x, y, z)) return own;
	}
	if (g_JobOn[playerid] && g_JobVeh[playerid] != INVALID_VEHICLE_ID)
	{
		new Float:x, Float:y, Float:z;
		GetVehiclePos(g_JobVeh[playerid], x, y, z);
		if (IsPlayerInRangeOfPoint(playerid, VEH_LOCK_RANGE, x, y, z)) return g_JobVeh[playerid];
	}
	return 0;
}

stock Ui_SendVehicle(playerid, dialogid, ok, const msg[])
{
	new v = g_UiVeh[playerid], json[260];
	new engine, lights, alarm, doors, bonnet, boot, objective;
	GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
	format(json, sizeof json, "{\"view\":\"vehicle\",\"model\":%d,\"engine\":%d,\"locked\":%d,\"boot\":%d,\"bonnet\":%d,\"doors\":%d,\"driver\":%d,\"ok\":%d,\"msg\":\"%s\"}",
		GetVehicleModel(v), engine == VEHICLE_PARAMS_ON, doors == VEHICLE_PARAMS_ON, boot == VEHICLE_PARAMS_ON, bonnet == VEHICLE_PARAMS_ON,
		g_UiDoorsOpen[v], (GetPlayerVehicleID(playerid) == v && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) ? 1 : 0, ok, msg);
	return Ui_Send(playerid, dialogid, json);
}

stock Ui_OpenVehicle(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	new v = Ui_FindVehicle(playerid);
	if (!v) { SendClientMessage(playerid, UI_COL_ERR, "Vehicule : monte dans un vehicule ou approche-toi du tien."); return 0; }
	g_UiVeh[playerid] = v;
	g_UiOpen[playerid] = 1;
	return Ui_SendVehicle(playerid, UI_DIALOG_OPEN, 1, "");
}

stock Ui_OpenLicences(playerid)
{
	new ts, json[200];
	new drive = Pol_LicenseInfo(playerid, ts);
	g_UiOpen[playerid] = 1;
	format(json, sizeof json, "{\"view\":\"licences\",\"drive\":\"%s\",\"weapon\":\"%s\",\"truck\":\"%s\",\"boat\":\"%s\"}", drive ? ("valide") : ("retire"),
		Gov_HasLicense(playerid, LIC_WEAPON) ? ("valide") : ("none"), Gov_HasLicense(playerid, LIC_TRUCK) ? ("valide") : ("none"), Gov_HasLicense(playerid, LIC_BOAT) ? ("valide") : ("none"));
	return Ui_Send(playerid, UI_DIALOG_OPEN, json);
}

stock Ui_OpenOutfits(playerid)
{
	new json[160];
	g_UiOpen[playerid] = 1;
	format(json, sizeof json, "{\"view\":\"outfits\",\"police\":%d,\"uniform\":%d}", (Fac_Type(playerid) == FACTION_POLICE) ? 1 : 0, Locker_InUniform(playerid));
	return Ui_Send(playerid, UI_DIALOG_OPEN, json);
}

// ------------------------------------------------------------
//  Actions de la page : /uiact <action> [arg]
// ------------------------------------------------------------
stock Ui_Action(playerid, const params[])
{
	if (!g_AuthLogged[playerid]) return 0;
	new idx = 0, action[16], tok[12], now = GetTickCount();
	Bank_NextToken(params, idx, action, sizeof action);
	Bank_NextToken(params, idx, tok, sizeof tok);

	if (!strcmp(action, "close", true)) { g_UiOpen[playerid] = 0; return 1; }
	if (g_UiLast[playerid] != 0 && now - g_UiLast[playerid] < UI_COOLDOWN_MS) return 1;
	g_UiLast[playerid] = (now == 0 ? 1 : now);

	// ---- Gouvernement (sur le joueur choisi) ----
	if (!strcmp(action, "gov_give", true) || !strcmp(action, "gov_take", true) || !strcmp(action, "gov_check", true))
	{
		Gov_UiAction(playerid, g_UiTarget[playerid], action);
		return 1;
	}

	// ---- Joueur ----
	if (!strcmp(action, "hello", true) || !strcmp(action, "money", true) || !strcmp(action, "papers", true) || !strcmp(action, "police", true))
	{
		new t = g_UiTarget[playerid];
		if (!Ui_TargetValid(playerid, t)) { Ui_Toast(playerid, 0, "Ce joueur n'est plus a cote de toi."); return 1; }
		if (strcmp(action, "hello", true) && strcmp(action, "papers", true))
		{
			new Float:tx, Float:ty, Float:tz;
			GetPlayerPos(t, tx, ty, tz);
			if (!IsPlayerInRangeOfPoint(playerid, UI_PLAYER_RANGE + 1.5, tx, ty, tz)) { Ui_Toast(playerid, 0, "Rapproche-toi du joueur."); return 1; }
		}
		if (!strcmp(action, "hello", true))
		{
			new Float:ax, Float:ay, Float:az, Float:bx, Float:by, Float:bz;
			GetPlayerPos(playerid, ax, ay, az);
			GetPlayerPos(t, bx, by, bz);
			SetPlayerFacingAngle(playerid, atan2(bx - ax, by - ay) * -1.0);
			SetPlayerFacingAngle(t, atan2(ax - bx, ay - by) * -1.0);
			ApplyAnimation(playerid, "GANGS", "hndshkfa", 4.1, 0, 0, 0, 0, 0, 1);
			ApplyAnimation(t, "GANGS", "hndshkfa", 4.1, 0, 0, 0, 0, 0, 1);
			new m[96], n[MAX_PLAYER_NAME + 1];
			Fx_RPName(playerid, n, sizeof n);
			format(m, sizeof m, "%s te salue.", n);
			SendClientMessage(t, UI_COL_INFO, m);
			Ui_Close(playerid, true);
		}
		else if (!strcmp(action, "money", true))
		{
			new n[MAX_PLAYER_NAME + 1], txt[160];
			Fx_RPName(t, n, sizeof n);
			Ui_Close(playerid, true);
			format(txt, sizeof txt, "Combien veux-tu donner à {FFCC33}%s{FFFFFF} ?\n\nArgent liquide : {33CC33}%d $", n, GetPlayerMoney(playerid));
			ShowPlayerDialog(playerid, UI_DIALOG_GIVE, DIALOG_STYLE_INPUT, "{33CCFF}Donner de l'argent", txt, "Donner", "Annuler");
		}
		else if (!strcmp(action, "papers", true))
		{
			new age, origin[32];
			if (!Ui_LoadId(playerid, age, origin, sizeof origin)) { Ui_Toast(playerid, 0, "Tu n'as pas de papiers : fais /papiers d'abord."); return 1; }
			Ui_ShowId(t, playerid);
			Ui_Toast(playerid, 1, "Tu montres tes papiers.");
		}
		else
		{
			if (!Fac_IsLaw(playerid)) { Ui_Toast(playerid, 0, "Reserve aux forces de l'ordre."); return 1; }
			Ui_Close(playerid, true);
			Pol_Open(playerid);
		}
		return 1;
	}

	// ---- Vehicule ----
	if (!strcmp(action, "engine", true) || !strcmp(action, "lock", true) || !strcmp(action, "boot", true) || !strcmp(action, "bonnet", true) || !strcmp(action, "doors", true))
	{
		new v = g_UiVeh[playerid];
		if (!v || Ui_FindVehicle(playerid) != v) { Ui_Toast(playerid, 0, "Tu es trop loin du vehicule."); return 1; }
		new engine, lights, alarm, doors, bonnet, boot, objective, msg[64], ok = 1;
		GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
		if (!strcmp(action, "engine", true))
		{
			if (GetPlayerVehicleID(playerid) != v || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) { ok = 0; format(msg, sizeof msg, "Il faut etre au volant."); }
			else { engine = (engine == VEHICLE_PARAMS_ON) ? VEHICLE_PARAMS_OFF : VEHICLE_PARAMS_ON; format(msg, sizeof msg, (engine == VEHICLE_PARAMS_ON) ? ("Moteur demarre.") : ("Moteur coupe.")); }
		}
		else if (!strcmp(action, "lock", true))
		{
			doors = (doors == VEHICLE_PARAMS_ON) ? VEHICLE_PARAMS_OFF : VEHICLE_PARAMS_ON;
			format(msg, sizeof msg, (doors == VEHICLE_PARAMS_ON) ? ("Vehicule verrouille.") : ("Vehicule deverrouille."));
		}
		else if (!strcmp(action, "boot", true)) { boot = (boot == VEHICLE_PARAMS_ON) ? VEHICLE_PARAMS_OFF : VEHICLE_PARAMS_ON; format(msg, sizeof msg, (boot == VEHICLE_PARAMS_ON) ? ("Coffre ouvert.") : ("Coffre ferme.")); }
		else if (!strcmp(action, "bonnet", true)) { bonnet = (bonnet == VEHICLE_PARAMS_ON) ? VEHICLE_PARAMS_OFF : VEHICLE_PARAMS_ON; format(msg, sizeof msg, (bonnet == VEHICLE_PARAMS_ON) ? ("Capot ouvert.") : ("Capot ferme.")); }
		else
		{
			g_UiDoorsOpen[v] = !g_UiDoorsOpen[v];
			new s = g_UiDoorsOpen[v] ? 1 : 0;
			SetVehicleParamsCarDoors(v, s, s, s, s);
			format(msg, sizeof msg, g_UiDoorsOpen[v] ? ("Portes ouvertes.") : ("Portes fermees."));
		}
		if (ok) SetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
		if (g_UiOpen[playerid]) Ui_SendVehicle(playerid, UI_DIALOG_UPDATE, ok, msg);
		return 1;
	}

	// ---- Tenues ----
	if (!strcmp(action, "civil", true))
	{
		if (Locker_InUniform(playerid)) { Locker_RestoreCivil(playerid); Ui_Toast(playerid, 1, "Tenue civile remise."); }
		else Ui_Toast(playerid, 0, "Tu portes deja ta tenue civile.");
		return 1;
	}
	if (!strcmp(action, "locker", true)) { Ui_Close(playerid, true); Locker_Open(playerid); return 1; }
	if (!strcmp(action, "edit", true)) { Ui_Close(playerid, true); Cloth_OnCommand(playerid, "/vetements"); return 1; }
	if (!strcmp(action, "papers_me", true)) { Ui_Papers(playerid); return 1; }
	return 1;
}

stock Ui_OnDialog(playerid, dialogid, response, const inputtext[])
{
	switch (dialogid)
	{
		case UI_DIALOG_GIVE:
		{
			if (!response) return 1;
			new t = g_UiTarget[playerid], amount = strval(inputtext), cmd[48];
			if (!Ui_TargetValid(playerid, t)) { SendClientMessage(playerid, UI_COL_ERR, "Ce joueur n'est plus a cote de toi."); return 1; }
			format(cmd, sizeof cmd, "/payer %d %d", t, amount);
			Bank_OnCommand(playerid, cmd);
			return 1;
		}
		case UI_DIALOG_ID_AGE:
		{
			if (!response) return 1;
			new age = strval(inputtext);
			if (age < 16 || age > 90)
			{
				ShowPlayerDialog(playerid, UI_DIALOG_ID_AGE, DIALOG_STYLE_INPUT, "{33CCFF}Carte d'identité {FFFFFF}- Création",
					"{FF6B72}Âge invalide.{FFFFFF}\n\nQuel âge a ton personnage ? (16 à 90 ans)", "Suivant", "Annuler");
				return 1;
			}
			g_UiIdAge[playerid] = age;
			ShowPlayerDialog(playerid, UI_DIALOG_ID_ORIGIN, DIALOG_STYLE_INPUT, "{33CCFF}Carte d'identité {FFFFFF}- Création",
				"D'où vient ton personnage ? (ville ou pays, ex : Abidjan, Los Santos, Dakar)", "Valider", "Annuler");
			return 1;
		}
		case UI_DIALOG_ID_ORIGIN:
		{
			if (!response) return 1;
			new origin[28];
			if (Ui_CleanOrigin(inputtext, origin, sizeof origin) < 2)
			{
				ShowPlayerDialog(playerid, UI_DIALOG_ID_ORIGIN, DIALOG_STYLE_INPUT, "{33CCFF}Carte d'identité {FFFFFF}- Création",
					"{FF6B72}Origine invalide (lettres uniquement).{FFFFFF}\n\nD'où vient ton personnage ?", "Valider", "Annuler");
				return 1;
			}
			new name[MAX_PLAYER_NAME + 1], q[200];
			GetPlayerName(playerid, name, sizeof name);
			format(q, sizeof q, "INSERT OR REPLACE INTO player_ids (name, age, origin) VALUES ('%s', %d, '%s')", name, g_UiIdAge[playerid], origin);
			db_free_result(db_query(g_JobDB, q));
			SendClientMessage(playerid, UI_COL_OK, "Tes papiers ont ete crees.");
			Ui_ShowId(playerid, playerid);
			return 1;
		}
	}
	return 0;
}

stock Ui_OnInit()
{
	Ui_InitDB();
	return 1;
}

stock Ui_OnConnect(playerid)
{
	g_UiOpen[playerid] = 0;
	g_UiTarget[playerid] = INVALID_PLAYER_ID;
	g_UiVeh[playerid] = 0;
	g_UiLast[playerid] = 0;
	return 1;
}

stock Ui_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/uiact ", true, 7)) { Ui_Action(playerid, cmdtext[7]); return 1; }
	if (!strcmp(cmdtext, "/interaction ", true, 13)) { Ui_OpenPlayer(playerid, strval(cmdtext[13])); return 1; }   // double tap
	if (!strcmp(cmdtext, "/interaction", true) || !strcmp(cmdtext, "/inter", true)) { Ui_OpenPlayer(playerid); return 1; }
	if (!strcmp(cmdtext, "/vmenu", true) || !strcmp(cmdtext, "/vehmenu", true)) { Ui_OpenVehicle(playerid); return 1; }
	if (!strcmp(cmdtext, "/papiers", true) || !strcmp(cmdtext, "/id", true)) { Ui_Papers(playerid); return 1; }
	if (!strcmp(cmdtext, "/permis", true) || !strcmp(cmdtext, "/licences", true)) { Ui_OpenLicences(playerid); return 1; }
	if (!strcmp(cmdtext, "/tenues", true)) { Ui_OpenOutfits(playerid); return 1; }
	if (!strcmp(cmdtext, "/mairie", true) || !strcmp(cmdtext, "/city", true))
	{
		Gps_Set(playerid, 1481.0, -1745.0);
		SendClientMessage(playerid, UI_COL_INFO, "GPS active vers la mairie de Los Santos.");
		return 1;
	}
	return 0;
}

// Mairie de Los Santos (City Hall) - 131 objets (1421335264_cityhall.pwn, converti en objets streamer)
new g_CHVidro[16];
new g_CHParedeB[36];
new g_CHParedeV[20];
