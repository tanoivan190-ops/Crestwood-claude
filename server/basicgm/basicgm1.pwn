// ============================================================
//  GOUVERNEMENT (factions de type "government")
// ------------------------------------------------------------
//  Commandes (membres d'une faction gouvernement) :
//    /gouv <texte>              annonce gouvernementale a tout le serveur
//    /tresor                    caisse de l'Etat + taux de TVA
//    /taxe <0-30>               TVA appliquee aux achats en boutique   (grade 3+)
//    /subvention <id> <montant> verse de l'argent de la caisse sur le compte bancaire d'un joueur (grade 4+)
//    /delivrer <id> <permis>    delivre un permis : conduire | armes | poidslourds | navire
//    /retirerpermis <id> <permis>
//    /verifier <id>             voir les papiers et les permis d'un joueur proche
//  Aussi depuis le menu d'interaction (double tap sur un joueur ou icone "Joueur").
//  La TVA des boutiques alimente la caisse de l'Etat.
//  Donnees : crestwood_jobs.db (tables gov_settings, gov_licenses)
// ============================================================

stock Gov_Is(playerid) { return Fac_Type(playerid) == FACTION_GOVERNMENT; }

stock Gov_SaveSetting(const key[], value)
{
	if (g_JobDB == DB:0) return 0;
	new q[128];
	format(q, sizeof q, "INSERT OR REPLACE INTO gov_settings (k, v) VALUES ('%s', %d)", key, value);
	db_free_result(db_query(g_JobDB, q));
	return 1;
}

stock Gov_LoadSetting(const key[], def)
{
	new q[96], f[16], v = def;
	format(q, sizeof q, "SELECT v FROM gov_settings WHERE k = '%s' LIMIT 1", key);
	new DBResult:res = db_query(g_JobDB, q);
	if (db_num_rows(res) > 0) { db_get_field(res, 0, f, sizeof f); v = strval(f); }
	db_free_result(res);
	return v;
}

stock Gov_OnInit()
{
	if (g_JobDB == DB:0) return 0;
	db_free_result(db_query(g_JobDB, "CREATE TABLE IF NOT EXISTS gov_settings (k TEXT PRIMARY KEY, v INTEGER)"));
	db_free_result(db_query(g_JobDB, "CREATE TABLE IF NOT EXISTS gov_licenses (name TEXT COLLATE NOCASE, lic INTEGER, ts INTEGER, PRIMARY KEY (name, lic))"));
	g_GovTax = Gov_LoadSetting("tax", 5);
	g_GovTreasury = Gov_LoadSetting("treasury", 0);
	return 1;
}

// Prix TTC d'un article (boutique)
stock Gov_WithTax(price) { return price + (price * g_GovTax) / 100; }

// Appele par la boutique a chaque achat : la part de TVA va dans la caisse
stock Gov_CollectTax(total)
{
	new taxPart = total - (total * 100) / (100 + g_GovTax);
	if (taxPart <= 0) return 0;
	if (g_GovTreasury < 2000000000 - taxPart) g_GovTreasury += taxPart;
	Gov_SaveSetting("treasury", g_GovTreasury);
	return taxPart;
}

stock Gov_LicFromName(const s[])
{
	for (new i = 0; i < LIC_COUNT; i++) if (!strcmp(s, g_LicKey[i], true)) return i;
	if (!strcmp(s, "permis", true) || !strcmp(s, "voiture", true)) return LIC_DRIVE;
	if (!strcmp(s, "arme", true)) return LIC_WEAPON;
	if (!strcmp(s, "camion", true) || !strcmp(s, "pl", true)) return LIC_TRUCK;
	if (!strcmp(s, "bateau", true)) return LIC_BOAT;
	return -1;
}

// 1 = valide, 0 = non possede ; pour le permis de conduire : 2 = retire (module police)
stock Gov_HasLicense(playerid, lic)
{
	if (lic == LIC_DRIVE)
	{
		new ts;
		return Pol_LicenseInfo(playerid, ts) ? 1 : 2;
	}
	new name[MAX_PLAYER_NAME + 1], q[160], ok;
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT 1 FROM gov_licenses WHERE name = '%s' AND lic = %d LIMIT 1", name, lic);
	new DBResult:res = db_query(g_JobDB, q);
	ok = db_num_rows(res) > 0;
	db_free_result(res);
	return ok;
}

stock Gov_SetLicense(officer, target, lic, give)
{
	new oname[MAX_PLAYER_NAME + 1], tname[MAX_PLAYER_NAME + 1], q[200], m[144];
	GetPlayerName(officer, oname, sizeof oname);
	GetPlayerName(target, tname, sizeof tname);
	if (lic == LIC_DRIVE) Pol_SetLicense(target, give ? 0 : 1, oname);
	else
	{
		if (give) format(q, sizeof q, "INSERT OR REPLACE INTO gov_licenses (name, lic, ts) VALUES ('%s', %d, %d)", tname, lic, gettime());
		else format(q, sizeof q, "DELETE FROM gov_licenses WHERE name = '%s' AND lic = %d", tname, lic);
		db_free_result(db_query(g_JobDB, q));
	}
	Fx_RPName(officer, oname, sizeof oname);
	Fx_RPName(target, tname, sizeof tname);
	format(m, sizeof m, "[Gouvernement] %s : %s %s.", oname, g_LicName[lic], give ? ("delivre") : ("retire"));
	SendClientMessage(target, GOV_COL, m);
	format(m, sizeof m, "%s %s a %s.", g_LicName[lic], give ? ("delivre") : ("retire"), tname);
	SendClientMessage(officer, GOV_COL_OK, m);
	return 1;
}

stock Gov_TargetOk(playerid, t)
{
	if (t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || t == playerid) return 0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(t, x, y, z);
	return IsPlayerInRangeOfPoint(playerid, GOV_RANGE, x, y, z);
}

stock Gov_LicenceList(playerid, t, dialogid)
{
	new list[300], line[64];
	for (new i = 0; i < LIC_COUNT; i++)
	{
		new has = Gov_HasLicense(t, i);
		format(line, sizeof line, "%s%s\t%s\n", (has == 1) ? ("{5FDCA0}") : ("{FFFFFF}"), g_LicName[i], (has == 1) ? ("{5FDCA0}Valide") : ((has == 2) ? ("{FF6B72}Retire") : ("{93A4C8}Non possede")));
		strcat(list, line, sizeof list);
	}
	g_GovTarget[playerid] = t;
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_TABLIST, (dialogid == GOV_DIALOG_GIVE) ? ("{FFCC33}Délivrer un permis") : ("{FFCC33}Retirer un permis"), list,
		(dialogid == GOV_DIALOG_GIVE) ? ("Délivrer") : ("Retirer"), "Annuler");
}

// Papiers + permis d'un joueur proche (page assets/ui)
stock Gov_Check(playerid, t)
{
	new age, origin[32];
	if (Ui_LoadId(t, age, origin, sizeof origin)) Ui_ShowId(playerid, t);
	else SendClientMessage(playerid, GOV_COL_ERR, "Ce joueur n'a pas de papiers d'identite.");
	new m[160], n[MAX_PLAYER_NAME + 1];
	Fx_RPName(t, n, sizeof n);
	format(m, sizeof m, "Permis de %s : conduire %s, armes %s, poids lourds %s, navire %s.", n,
		(Gov_HasLicense(t, LIC_DRIVE) == 1) ? ("oui") : ("non"), Gov_HasLicense(t, LIC_WEAPON) ? ("oui") : ("non"),
		Gov_HasLicense(t, LIC_TRUCK) ? ("oui") : ("non"), Gov_HasLicense(t, LIC_BOAT) ? ("oui") : ("non"));
	SendClientMessage(playerid, GOV_COL, m);
	return 1;
}

stock Gov_OnDialog(playerid, dialogid, response, listitem)
{
	if (dialogid != GOV_DIALOG_GIVE && dialogid != GOV_DIALOG_TAKE) return 0;
	if (!response || listitem < 0 || listitem >= LIC_COUNT) return 1;
	new t = g_GovTarget[playerid];
	if (!Gov_Is(playerid)) return 1;
	if (!Gov_TargetOk(playerid, t)) { SendClientMessage(playerid, GOV_COL_ERR, "Ce joueur n'est plus a cote de toi."); return 1; }
	Gov_SetLicense(playerid, t, listitem, dialogid == GOV_DIALOG_GIVE);
	return 1;
}

// Actions du menu d'interaction (page assets/ui) : gov_give / gov_take / gov_check
stock Gov_UiAction(playerid, t, const action[])
{
	if (!Gov_Is(playerid)) { Ui_Toast(playerid, 0, "Reserve au gouvernement."); return 1; }
	if (!Gov_TargetOk(playerid, t)) { Ui_Toast(playerid, 0, "Ce joueur n'est plus a cote de toi."); return 1; }
	Ui_Close(playerid, true);
	if (!strcmp(action, "gov_give", true)) Gov_LicenceList(playerid, t, GOV_DIALOG_GIVE);
	else if (!strcmp(action, "gov_take", true)) Gov_LicenceList(playerid, t, GOV_DIALOG_TAKE);
	else Gov_Check(playerid, t);
	return 1;
}

stock Gov_OnCommand(playerid, const cmdtext[])
{
	new idx = 0;
	if (!strcmp(cmdtext, "/gouv ", true, 6) || !strcmp(cmdtext, "/tresor", true) || !strcmp(cmdtext, "/taxe", true, 5)
		|| !strcmp(cmdtext, "/subvention", true, 11) || !strcmp(cmdtext, "/delivrer", true, 9) || !strcmp(cmdtext, "/retirerpermis", true, 14)
		|| !strcmp(cmdtext, "/verifier", true, 9))
	{
		if (!g_AuthLogged[playerid]) return 1;
		if (!Gov_Is(playerid)) { SendClientMessage(playerid, GOV_COL_ERR, "Reserve aux membres du gouvernement."); return 1; }
	}
	else return 0;

	new m[160], n[MAX_PLAYER_NAME + 1];
	Fx_RPName(playerid, n, sizeof n);
	if (!strcmp(cmdtext, "/gouv ", true, 6))
	{
		idx = 6;
		while (cmdtext[idx] == ' ') idx++;
		if (!cmdtext[idx]) { SendClientMessage(playerid, GOV_COL_ERR, "Usage : /gouv <annonce>"); return 1; }
		SendClientMessageToAll(GOV_COL, "--------------------- [ GOUVERNEMENT DE SAN ANDREAS ] ---------------------");
		format(m, sizeof m, "%s : %s", n, cmdtext[idx]);
		SendClientMessageToAll(0xFFFFFFFF, m);
		return 1;
	}
	if (!strcmp(cmdtext, "/tresor", true))
	{
		format(m, sizeof m, "Caisse de l'Etat : %d $  |  TVA : %d %%", g_GovTreasury, g_GovTax);
		SendClientMessage(playerid, GOV_COL, m);
		return 1;
	}
	if (!strcmp(cmdtext, "/taxe", true, 5))
	{
		if (g_FacRank[playerid] < GOV_RANK_TAX) { format(m, sizeof m, "Il faut le grade %d pour fixer la TVA.", GOV_RANK_TAX); SendClientMessage(playerid, GOV_COL_ERR, m); return 1; }
		if (cmdtext[5] != ' ') { SendClientMessage(playerid, GOV_COL_ERR, "Usage : /taxe <0-30>"); return 1; }
		new t = strval(cmdtext[6]);
		if (t < 0 || t > GOV_TAX_MAX) { SendClientMessage(playerid, GOV_COL_ERR, "TVA : 0 a 30 %."); return 1; }
		g_GovTax = t;
		Gov_SaveSetting("tax", t);
		format(m, sizeof m, "[Gouvernement] La TVA passe a %d %% dans les boutiques (decision de %s).", t, n);
		SendClientMessageToAll(GOV_COL, m);
		return 1;
	}
	if (!strcmp(cmdtext, "/subvention", true, 11))
	{
		if (g_FacRank[playerid] < GOV_RANK_SUBSIDY) { format(m, sizeof m, "Il faut le grade %d pour verser une subvention.", GOV_RANK_SUBSIDY); SendClientMessage(playerid, GOV_COL_ERR, m); return 1; }
		new tok[12], tok2[16];
		idx = 11;
		Bank_NextToken(cmdtext, idx, tok, sizeof tok);
		Bank_NextToken(cmdtext, idx, tok2, sizeof tok2);
		new t = strval(tok), amount = strval(tok2);
		if (!tok[0] || !tok2[0]) { SendClientMessage(playerid, GOV_COL_ERR, "Usage : /subvention <id> <montant>"); return 1; }
		if (t < 0 || t >= MAX_PLAYERS || !IsPlayerConnected(t) || !g_BankLoaded[t]) { SendClientMessage(playerid, GOV_COL_ERR, "Joueur invalide."); return 1; }
		if (amount <= 0 || amount > GOV_SUBSIDY_MAX) { SendClientMessage(playerid, GOV_COL_ERR, "Montant : 1 a 500000."); return 1; }
		if (amount > g_GovTreasury) { SendClientMessage(playerid, GOV_COL_ERR, "La caisse de l'Etat n'a pas assez d'argent."); return 1; }
		if (g_BankBalance[t] > BANK_MAX_MONEY - amount) { SendClientMessage(playerid, GOV_COL_ERR, "Ce compte ne peut pas recevoir autant."); return 1; }
		g_GovTreasury -= amount;
		Gov_SaveSetting("treasury", g_GovTreasury);
		g_BankBalance[t] += amount;
		Bank_AddHistory(t, "Subvention de l'Etat", amount);
		Bank_SavePlayer(t);
		new tn[MAX_PLAYER_NAME + 1];
		Fx_RPName(t, tn, sizeof tn);
		format(m, sizeof m, "[Gouvernement] Tu recois une subvention de %d $ sur ton compte.", amount);
		SendClientMessage(t, GOV_COL, m);
		format(m, sizeof m, "Subvention de %d $ versee a %s. Caisse : %d $.", amount, tn, g_GovTreasury);
		SendClientMessage(playerid, GOV_COL_OK, m);
		return 1;
	}
	// /delivrer <id> <permis> | /retirerpermis <id> <permis> | /verifier <id>
	new give = !strcmp(cmdtext, "/delivrer", true, 9), check = !strcmp(cmdtext, "/verifier", true, 9);
	idx = give ? 9 : (check ? 9 : 14);
	new tok[12], lic[16];
	Bank_NextToken(cmdtext, idx, tok, sizeof tok);
	Bank_NextToken(cmdtext, idx, lic, sizeof lic);
	new t = strval(tok);
	if (!tok[0]) { SendClientMessage(playerid, GOV_COL_ERR, check ? ("Usage : /verifier <id>") : ("Usage : /delivrer|/retirerpermis <id> [conduire|armes|poidslourds|navire]")); return 1; }
	if (!Gov_TargetOk(playerid, t)) { SendClientMessage(playerid, GOV_COL_ERR, "Ce joueur n'est pas a cote de toi."); return 1; }
	if (check) return Gov_Check(playerid, t);
	if (!lic[0]) return Gov_LicenceList(playerid, t, give ? GOV_DIALOG_GIVE : GOV_DIALOG_TAKE);
	new l = Gov_LicFromName(lic);
	if (l == -1) { SendClientMessage(playerid, GOV_COL_ERR, "Permis : conduire, armes, poidslourds ou navire."); return 1; }
	Gov_SetLicense(playerid, t, l, give);
	return 1;
}

// ============================================================
//  SUPPORT / REPORTS  (casque du menu rotatif -> assets/report/index.html)
//  + onglet "Reports" du panneau admin (assets/admin/index.html)
// ------------------------------------------------------------
//  Le joueur ouvre un report (categorie, joueur signale, message) ; tout le
//  staff connecte est prevenu (chat + notification du HUD). Un admin le prend
//  en charge depuis le panneau et discute avec le joueur : les messages
//  arrivent en direct des deux cotes (page report / panneau admin), sinon en
//  notification + message dans le chat.
//
//  serveur -> client (joueur) : ShowPlayerDialog(9640 ouvrir / 9641 mise a jour / 9642 fermer, "@report", JSON)
//     {"open":1,"id":12,"st":1,"c":0,"by":"","tg":"","msgs":[{"f":0,"n":"Nom","t":"texte","h":"12:30"}],"staff":2,"ok":1,"msg":""}
//     {"open":0,"staff":2,"ok":1,"msg":"..."}           (aucun report en cours)
//  serveur -> client (staff)  : ShowPlayerDialog(9643, "@reports", JSON) -> panneau admin
//     {"reports":[{"id":5,"num":12,"n":"Nom","c":0,"st":1,"by":"","u":1,"m":3,"tg":""}],"view":5,"thread":{...},"ok":1,"msg":""}
//  serveur -> client          : ShowPlayerDialog(9644, "@note", {"type":"admin","title":"..","message":"..","duration":8000})
//                               (notification en bas de l'ecran du HUD)
//  client -> serveur : /repact open | hide | new <categorie> <id signale|-1> <texte> | msg <texte> | cancel
//                      /adminact replist 0 | repview <id> | repclaim <id> | repreply <id> <texte> | repclose <id>
//  Commandes : /report (/support) ouvre la page ; staff : /reports (liste dans le chat)
//  Les reports vivent en memoire (pas de base) : ils disparaissent si le joueur se deconnecte.
// ============================================================

#define REP_DIALOG_OPEN       9640
#define REP_DIALOG_UPDATE     9641
#define REP_DIALOG_CLOSE      9642
#define REP_DIALOG_ADMIN      9643
#define NOTE_DIALOG           9644

#define REP_SLOTS             40          // reports ouverts en meme temps (tout le serveur)
#define REP_MSGS              12          // messages gardes par report (les plus anciens sont retires)
#define REP_TEXT              100         // longueur max d'un message
#define REP_CATS              5           // 0 question, 1 bug, 2 joueur, 3 remboursement, 4 autre
#define REP_MSG_COOLDOWN      2           // secondes entre deux messages du joueur
#define REP_NEW_COOLDOWN      30          // secondes entre deux nouveaux reports
#define REP_LIST_MAX          14          // reports listes dans le panneau (taille du dialogue)

#define REP_COL               0xB44DFFFF
#define REP_COL_ERR           0xFF4444FF

new g_RepSlot[MAX_PLAYERS] = {-1, ...};
new g_RepOwner[REP_SLOTS] = {INVALID_PLAYER_ID, ...};
new g_RepNum[REP_SLOTS];
new g_RepCat[REP_SLOTS];
new g_RepTargetName[REP_SLOTS][MAX_PLAYER_NAME + 1];
new g_RepState[REP_SLOTS];                         // 1 en attente, 2 pris en charge
new g_RepStaff[REP_SLOTS] = {INVALID_PLAYER_ID, ...};
new g_RepStaffName[REP_SLOTS][MAX_PLAYER_NAME + 1];
new g_RepCreated[REP_SLOTS];
new g_RepUnread[REP_SLOTS];
new g_RepMsgN[REP_SLOTS];
new g_RepMsgFrom[REP_SLOTS][REP_MSGS];             // 0 joueur, 1 staff, 2 systeme
new g_RepMsgName[REP_SLOTS][REP_MSGS][MAX_PLAYER_NAME + 1];
new g_RepMsgText[REP_SLOTS][REP_MSGS][REP_TEXT + 4];
new g_RepMsgTime[REP_SLOTS][REP_MSGS][6];
new g_RepPage[MAX_PLAYERS];                        // page report ouverte cote joueur
new g_RepView[MAX_PLAYERS] = {-1, ...};            // staff : conversation ouverte dans le panneau
new g_RepLastMsg[MAX_PLAYERS];
new g_RepLastNew[MAX_PLAYERS];
new g_RepCounter;
new g_RepJson[4000];

stock Rep_CatName(cat, out[], size)
{
	switch (cat)
	{
		case 0: format(out, size, "Question");
		case 1: format(out, size, "Bug");
		case 2: format(out, size, "Signalement");
		case 3: format(out, size, "Remboursement");
		default: format(out, size, "Autre");
	}
	return 1;
}

stock Rep_StaffOnline()
{
	new n = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && Admin_Level(i) >= ADMIN_LVL_ADMIN) n++;
	}
	return n;
}

// Notification en bas de l'ecran du HUD (type : admin, success, warning, denied, system)
stock Note_Send(playerid, const type[], const title[], const text[])
{
	new json[300], t[48], m[200];
	Admin_Clean(title, t, sizeof t);
	Admin_Clean(text, m, sizeof m);
	format(json, sizeof json, "{\"type\":\"%s\",\"title\":\"%s\",\"message\":\"%s\",\"duration\":8000}", type, t, m);
	return ShowPlayerDialog(playerid, NOTE_DIALOG, DIALOG_STYLE_MSGBOX, "@note", json, "OK", "");
}

stock Rep_AddMsg(slot, from, const name[], const text[])
{
	new h, mi, s;
	gettime(h, mi, s);
	if (g_RepMsgN[slot] >= REP_MSGS)
	{
		for (new i = 1; i < REP_MSGS; i++)
		{
			g_RepMsgFrom[slot][i - 1] = g_RepMsgFrom[slot][i];
			format(g_RepMsgName[slot][i - 1], MAX_PLAYER_NAME + 1, "%s", g_RepMsgName[slot][i]);
			format(g_RepMsgText[slot][i - 1], REP_TEXT + 4, "%s", g_RepMsgText[slot][i]);
			format(g_RepMsgTime[slot][i - 1], 6, "%s", g_RepMsgTime[slot][i]);
		}
		g_RepMsgN[slot] = REP_MSGS - 1;
	}
	new k = g_RepMsgN[slot]++;
	g_RepMsgFrom[slot][k] = from;
	format(g_RepMsgName[slot][k], MAX_PLAYER_NAME + 1, "%s", name);
	Admin_Clean(text, g_RepMsgText[slot][k], REP_TEXT + 1);
	format(g_RepMsgTime[slot][k], 6, "%02d:%02d", h, mi);
	return 1;
}

// "msgs":[...] (les plus recents gardes si le dialogue est plein)
stock Rep_AppendThread(slot, out[], size, limit)
{
	new part[200];
	strcat(out, "\"msgs\":[", size);
	new first = 0, total = 0;
	for (new i = g_RepMsgN[slot] - 1; i >= 0; i--)
	{
		total += strlen(g_RepMsgText[slot][i]) + strlen(g_RepMsgName[slot][i]) + 36;
		if (strlen(out) + total > limit) { first = i + 1; break; }
	}
	for (new i = first; i < g_RepMsgN[slot]; i++)
	{
		format(part, sizeof part, "%s{\"f\":%d,\"n\":\"%s\",\"t\":\"%s\",\"h\":\"%s\"}", (i > first) ? (",") : (""),
			g_RepMsgFrom[slot][i], g_RepMsgName[slot][i], g_RepMsgText[slot][i], g_RepMsgTime[slot][i]);
		strcat(out, part, size);
	}
	strcat(out, "]", size);
	return 1;
}

stock Rep_SendPlayer(playerid, dialogid, ok, const msg[])
{
	new part[200], safe[150];
	new slot = g_RepSlot[playerid];
	if (slot == -1)
	{
		format(g_RepJson, sizeof g_RepJson, "{\"open\":0,\"staff\":%d,", Rep_StaffOnline());
	}
	else
	{
		format(g_RepJson, sizeof g_RepJson, "{\"open\":1,\"id\":%d,\"st\":%d,\"c\":%d,\"by\":\"%s\",\"tg\":\"%s\",\"staff\":%d,",
			g_RepNum[slot], g_RepState[slot], g_RepCat[slot], g_RepStaffName[slot], g_RepTargetName[slot], Rep_StaffOnline());
		Rep_AppendThread(slot, g_RepJson, sizeof g_RepJson, 3700);
		strcat(g_RepJson, ",", sizeof g_RepJson);
	}
	Admin_Clean(msg, safe, sizeof safe);
	format(part, sizeof part, "\"ok\":%d,\"msg\":\"%s\"}", ok, safe);
	strcat(g_RepJson, part, sizeof g_RepJson);
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@report", g_RepJson, "OK", "");
}

stock Rep_SendAdmin(staffid, ok, const msg[])
{
	new part[200], safe[150], listed = 0, now = gettime();
	format(g_RepJson, sizeof g_RepJson, "{\"reports\":[");
	for (new s = 0; s < REP_SLOTS && listed < REP_LIST_MAX; s++)
	{
		new p = g_RepOwner[s];
		if (p == INVALID_PLAYER_ID) continue;
		new pname[MAX_PLAYER_NAME + 1];
		GetPlayerName(p, pname, sizeof pname);
		format(part, sizeof part, "%s{\"id\":%d,\"num\":%d,\"n\":\"%s\",\"c\":%d,\"st\":%d,\"by\":\"%s\",\"u\":%d,\"m\":%d,\"tg\":\"%s\"}",
			listed ? (",") : (""), p, g_RepNum[s], pname, g_RepCat[s], g_RepState[s], g_RepStaffName[s], g_RepUnread[s],
			(now - g_RepCreated[s]) / 60, g_RepTargetName[s]);
		if (strlen(g_RepJson) + strlen(part) > 1700) break;
		strcat(g_RepJson, part, sizeof g_RepJson);
		listed++;
	}
	new view = g_RepView[staffid];
	if (view != -1 && (view < 0 || view >= MAX_PLAYERS || !IsPlayerConnected(view) || g_RepSlot[view] == -1)) { view = -1; g_RepView[staffid] = -1; }
	format(part, sizeof part, "],\"view\":%d", view);
	strcat(g_RepJson, part, sizeof g_RepJson);
	if (view != -1)
	{
		new slot = g_RepSlot[view], pname[MAX_PLAYER_NAME + 1];
		GetPlayerName(view, pname, sizeof pname);
		format(part, sizeof part, ",\"thread\":{\"id\":%d,\"num\":%d,\"n\":\"%s\",\"c\":%d,\"st\":%d,\"by\":\"%s\",\"tg\":\"%s\",",
			view, g_RepNum[slot], pname, g_RepCat[slot], g_RepState[slot], g_RepStaffName[slot], g_RepTargetName[slot]);
		strcat(g_RepJson, part, sizeof g_RepJson);
		Rep_AppendThread(slot, g_RepJson, sizeof g_RepJson, 3700);
		strcat(g_RepJson, "}", sizeof g_RepJson);
	}
	Admin_Clean(msg, safe, sizeof safe);
	format(part, sizeof part, ",\"ok\":%d,\"msg\":\"%s\"}", ok, safe);
	strcat(g_RepJson, part, sizeof g_RepJson);
	return ShowPlayerDialog(staffid, REP_DIALOG_ADMIN, DIALOG_STYLE_MSGBOX, "@reports", g_RepJson, "OK", "");
}

// Met a jour tous les panneaux admin ouverts
stock Rep_PushAdmins()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && g_AdminOpen[i] && Admin_Level(i) >= ADMIN_LVL_ADMIN) Rep_SendAdmin(i, 1, "");
	}
	return 1;
}

// Previent le staff (tout le staff, ou seulement celui qui gere le report)
stock Rep_NotifyStaff(slot, const title[], const text[], onlyHandler)
{
	new line[180];
	format(line, sizeof line, "[REPORT #%d] %s", g_RepNum[slot], text);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || Admin_Level(i) < ADMIN_LVL_ADMIN) continue;
		if (onlyHandler && g_RepState[slot] == 2 && g_RepStaff[slot] != i) continue;
		SendClientMessage(i, REP_COL, line);
		if (!g_AdminOpen[i]) Note_Send(i, "admin", title, text);
	}
	return 1;
}

// Libere le report d'un joueur (ferme, annule, deconnexion)
stock Rep_Free(playerid)
{
	new slot = g_RepSlot[playerid];
	if (slot == -1) return 0;
	g_RepOwner[slot] = INVALID_PLAYER_ID;
	g_RepStaff[slot] = INVALID_PLAYER_ID;
	g_RepStaffName[slot][0] = 0;
	g_RepTargetName[slot][0] = 0;
	g_RepMsgN[slot] = 0;
	g_RepUnread[slot] = 0;
	g_RepState[slot] = 0;
	g_RepSlot[playerid] = -1;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_RepView[i] == playerid) g_RepView[i] = -1;
	}
	return 1;
}

stock Rep_Open(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	g_RepPage[playerid] = 1;
	return Rep_SendPlayer(playerid, REP_DIALOG_OPEN, 1, "");
}

// Message pour le joueur : en direct sur sa page, sinon notification + chat
stock Rep_TellPlayer(playerid, const title[], const text[])
{
	if (g_RepPage[playerid]) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 1, "");
	new line[180];
	format(line, sizeof line, "[SUPPORT] %s (menu > casque pour repondre)", text);
	SendClientMessage(playerid, REP_COL, line);
	return Note_Send(playerid, "admin", title, text);
}

// /repact ... (page du joueur)
stock Rep_Action(playerid, const params[])
{
	if (!g_AuthLogged[playerid]) return 0;
	new idx = 0, action[12], name[MAX_PLAYER_NAME + 1], text[REP_TEXT + 4], line[180], now = gettime();
	Bank_NextToken(params, idx, action, sizeof action);
	GetPlayerName(playerid, name, sizeof name);

	if (!strcmp(action, "open", true)) return Rep_Open(playerid);
	if (!strcmp(action, "hide", true)) { g_RepPage[playerid] = 0; return 1; }

	if (!strcmp(action, "new", true))
	{
		new ctok[8], ttok[8];
		Bank_NextToken(params, idx, ctok, sizeof ctok);
		Bank_NextToken(params, idx, ttok, sizeof ttok);
		while (params[idx] == ' ') idx++;
		Admin_Clean(params[idx], text, sizeof text);
		new cat = strval(ctok), target = strval(ttok);
		if (cat < 0 || cat >= REP_CATS) cat = REP_CATS - 1;
		if (g_RepSlot[playerid] != -1) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Tu as deja un report en cours.");
		if (strlen(text) < 3) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Explique ton probleme en quelques mots.");
		if (g_RepLastNew[playerid] && now - g_RepLastNew[playerid] < REP_NEW_COOLDOWN) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Patiente un peu avant d'ouvrir un nouveau report.");
		if (cat == 2 && (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target) || target == playerid))
			return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Indique l'ID du joueur a signaler (il doit etre connecte).");
		new slot = -1;
		for (new s = 0; s < REP_SLOTS; s++)
		{
			if (g_RepOwner[s] == INVALID_PLAYER_ID) { slot = s; break; }
		}
		if (slot == -1) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Trop de reports en attente, reessaie dans quelques minutes.");

		g_RepCounter++;
		g_RepOwner[slot] = playerid;
		g_RepSlot[playerid] = slot;
		g_RepNum[slot] = g_RepCounter;
		g_RepCat[slot] = cat;
		g_RepState[slot] = 1;
		g_RepStaff[slot] = INVALID_PLAYER_ID;
		g_RepStaffName[slot][0] = 0;
		g_RepTargetName[slot][0] = 0;
		if (cat == 2) GetPlayerName(target, g_RepTargetName[slot], MAX_PLAYER_NAME + 1);
		g_RepCreated[slot] = now;
		g_RepUnread[slot] = 1;
		g_RepMsgN[slot] = 0;
		g_RepLastNew[playerid] = now;
		g_RepLastMsg[playerid] = now;
		Rep_AddMsg(slot, 0, name, text);

		new cname[16];
		Rep_CatName(cat, cname, sizeof cname);
		if (cat == 2) format(line, sizeof line, "%s (%d) signale %s : %s", name, playerid, g_RepTargetName[slot], text);
		else format(line, sizeof line, "%s (%d) - %s : %s", name, playerid, cname, text);
		Rep_NotifyStaff(slot, "Nouveau report", line, 0);
		printf("[REPORT #%d] %s", g_RepNum[slot], line);
		Rep_PushAdmins();
		if (Rep_StaffOnline() == 0) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 1, "Report envoyé. Aucun membre du staff en ligne pour le moment : il sera traité dès que possible.");
		return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 1, "Report envoyé au staff. Reste sur cette page ou attends la notification.");
	}

	new slot = g_RepSlot[playerid];
	if (!strcmp(action, "msg", true))
	{
		while (params[idx] == ' ') idx++;
		Admin_Clean(params[idx], text, sizeof text);
		if (slot == -1) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Aucun report en cours.");
		if (!text[0]) return 1;
		if (now - g_RepLastMsg[playerid] < REP_MSG_COOLDOWN) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Doucement, un message a la fois.");
		g_RepLastMsg[playerid] = now;
		Rep_AddMsg(slot, 0, name, text);
		g_RepUnread[slot]++;
		format(line, sizeof line, "%s (%d) : %s", name, playerid, text);
		Rep_NotifyStaff(slot, "Message d'un joueur", line, 1);
		Rep_PushAdmins();
		return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 1, "");
	}
	if (!strcmp(action, "cancel", true))
	{
		if (slot == -1) return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 0, "Aucun report en cours.");
		format(line, sizeof line, "%s (%d) a ferme son report.", name, playerid);
		Rep_NotifyStaff(slot, "Report ferme", line, 1);
		Rep_Free(playerid);
		Rep_PushAdmins();
		return Rep_SendPlayer(playerid, REP_DIALOG_UPDATE, 1, "Report fermé. Merci !");
	}
	return 1;
}

// /adminact rep... (panneau admin) ; retourne 1 si l'action a ete traitee
stock Rep_AdminAction(playerid, const action[], const params[])
{
	if (strcmp(action, "rep", true, 3)) return 0;
	if (Admin_Level(playerid) < ADMIN_LVL_ADMIN) return 1;
	new idx = 0, tid[12], text[REP_TEXT + 4], name[MAX_PLAYER_NAME + 1], tname[MAX_PLAYER_NAME + 1], line[180];
	Bank_NextToken(params, idx, tid, sizeof tid);
	while (params[idx] == ' ') idx++;
	Admin_Clean(params[idx], text, sizeof text);
	GetPlayerName(playerid, name, sizeof name);

	if (!strcmp(action, "replist", true)) return Rep_SendAdmin(playerid, 1, "");

	new target = Admin_Target(tid);
	if (target == INVALID_PLAYER_ID || g_RepSlot[target] == -1)
	{
		if (g_RepView[playerid] == target) g_RepView[playerid] = -1;
		return Rep_SendAdmin(playerid, 0, "Ce report n'existe plus.");
	}
	new slot = g_RepSlot[target];
	GetPlayerName(target, tname, sizeof tname);

	if (!strcmp(action, "repview", true))
	{
		g_RepView[playerid] = target;
		g_RepUnread[slot] = 0;
		Rep_PushAdmins();
		return 1;
	}
	if (!strcmp(action, "repclaim", true))
	{
		if (g_RepState[slot] == 2 && g_RepStaff[slot] == playerid) return Rep_SendAdmin(playerid, 1, "Tu geres deja ce report.");
		g_RepState[slot] = 2;
		g_RepStaff[slot] = playerid;
		format(g_RepStaffName[slot], MAX_PLAYER_NAME + 1, "%s", name);
		g_RepView[playerid] = target;
		g_RepUnread[slot] = 0;
		format(line, sizeof line, "%s prend en charge ton report.", name);
		Rep_AddMsg(slot, 2, "Support", line);
		Rep_TellPlayer(target, "Support", line);
		format(line, sizeof line, "%s prend en charge le report de %s.", name, tname);
		Rep_NotifyStaff(slot, "Report pris en charge", line, 0);
		Rep_PushAdmins();
		return 1;
	}
	if (!strcmp(action, "repreply", true))
	{
		if (!text[0]) return Rep_SendAdmin(playerid, 0, "Ecris un message.");
		if (g_RepState[slot] != 2 || g_RepStaff[slot] != playerid)
		{
			// repondre = prendre en charge
			g_RepState[slot] = 2;
			g_RepStaff[slot] = playerid;
			format(g_RepStaffName[slot], MAX_PLAYER_NAME + 1, "%s", name);
		}
		g_RepView[playerid] = target;
		g_RepUnread[slot] = 0;
		Rep_AddMsg(slot, 1, name, text);
		format(line, sizeof line, "%s : %s", name, text);
		Rep_TellPlayer(target, "Réponse du staff", line);
		printf("[REPORT #%d] %s -> %s : %s", g_RepNum[slot], name, tname, text);
		Rep_PushAdmins();
		return 1;
	}
	if (!strcmp(action, "repclose", true))
	{
		format(line, sizeof line, "Ton report #%d a été fermé par %s. Merci !", g_RepNum[slot], name);
		new num = g_RepNum[slot];
		Rep_Free(target);
		if (g_RepPage[target]) Rep_SendPlayer(target, REP_DIALOG_UPDATE, 1, line);
		else Rep_TellPlayer(target, "Support", line);
		format(line, sizeof line, "%s a ferme le report #%d de %s.", name, num, tname);
		for (new i = 0; i < MAX_PLAYERS; i++)
		{
			if (IsPlayerConnected(i) && Admin_Level(i) >= ADMIN_LVL_ADMIN) SendClientMessage(i, REP_COL, line);
		}
		Rep_PushAdmins();
		return 1;
	}
	return Rep_SendAdmin(playerid, 0, "Action inconnue.");
}

stock Rep_OnConnect(playerid)
{
	g_RepSlot[playerid] = -1;
	g_RepPage[playerid] = 0;
	g_RepView[playerid] = -1;
	g_RepLastMsg[playerid] = 0;
	g_RepLastNew[playerid] = 0;
	return 1;
}

stock Rep_OnDisconnect(playerid)
{
	new slot = g_RepSlot[playerid], line[128], name[MAX_PLAYER_NAME + 1];
	if (slot != -1)
	{
		GetPlayerName(playerid, name, sizeof name);
		format(line, sizeof line, "%s s'est deconnecte : report ferme.", name);
		Rep_NotifyStaff(slot, "Report ferme", line, 1);
		Rep_Free(playerid);
	}
	// le staff qui part rend ses reports
	for (new s = 0; s < REP_SLOTS; s++)
	{
		if (g_RepOwner[s] != INVALID_PLAYER_ID && g_RepStaff[s] == playerid)
		{
			g_RepStaff[s] = INVALID_PLAYER_ID;
			g_RepStaffName[s][0] = 0;
			g_RepState[s] = 1;
			Rep_AddMsg(s, 2, "Support", "Le membre du staff s'est deconnecte, ton report repasse en attente.");
			if (IsPlayerConnected(g_RepOwner[s]) && g_RepPage[g_RepOwner[s]]) Rep_SendPlayer(g_RepOwner[s], REP_DIALOG_UPDATE, 1, "");
		}
	}
	g_RepPage[playerid] = 0;
	g_RepView[playerid] = -1;
	Rep_PushAdmins();
	return 1;
}

stock Rep_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/repact ", true, 8))
	{
		Rep_Action(playerid, cmdtext[8]);
		return 1;
	}
	if (!strcmp(cmdtext, "/report", true) || !strcmp(cmdtext, "/support", true))
	{
		Rep_Open(playerid);
		return 1;
	}
	if (!strcmp(cmdtext, "/reports", true))
	{
		if (Admin_Level(playerid) < ADMIN_LVL_ADMIN) return 0;
		new line[160], pname[MAX_PLAYER_NAME + 1], cname[16], n = 0;
		SendClientMessage(playerid, REP_COL, "Reports ouverts (panneau admin > onglet Reports pour repondre) :");
		for (new s = 0; s < REP_SLOTS; s++)
		{
			if (g_RepOwner[s] == INVALID_PLAYER_ID) continue;
			GetPlayerName(g_RepOwner[s], pname, sizeof pname);
			Rep_CatName(g_RepCat[s], cname, sizeof cname);
			new who[MAX_PLAYER_NAME + 1];
			if (g_RepState[s] == 2) format(who, sizeof who, "%s", g_RepStaffName[s]);
			else format(who, sizeof who, "en attente");
			format(line, sizeof line, "  #%d %s (%d) - %s - %s", g_RepNum[s], pname, g_RepOwner[s], cname, who);
			SendClientMessage(playerid, 0xFFFFFFFF, line);
			n++;
		}
		if (!n) SendClientMessage(playerid, 0xFFFFFFFF, "  Aucun report ouvert.");
		return 1;
	}
	return 0;
}

// ============================================================
//  OBJECTIFS DE MISSION (panneau en haut a droite du HUD)
// ------------------------------------------------------------
//  serveur -> client : ShowPlayerDialog(9650, "@obj", JSON)
//     {"show":1,"t":"Livreur","s":"Tournee 3 - Niveau 1","l":[["Monte dans le camion",2],["Livre les colis 1/4",1],["Retourne au depot",0]]}
//     {"show":0}
//  etat d'une ligne : 0 a faire, 1 en cours, 2 terminee
//  Utilisation (n'importe quel module) :
//     Obj_Begin("Titre", "Sous-titre"); Obj_Line("Etape 1", 2); Obj_Line("Etape 2", 1); Obj_Send(playerid);
//     Obj_Hide(playerid);
//  Branche sur les 5 metiers (EMPLOIS) : mis a jour a chaque etape.
// ============================================================

#define OBJ_DIALOG            9650

new g_ObjJson[900];
new g_ObjN;
new g_ObjShown[MAX_PLAYERS];

stock Obj_Begin(const title[], const sub[])
{
	new t[48], s[64];
	Admin_Clean(title, t, sizeof t);
	Admin_Clean(sub, s, sizeof s);
	format(g_ObjJson, sizeof g_ObjJson, "{\"show\":1,\"t\":\"%s\",\"s\":\"%s\",\"l\":[", t, s);
	g_ObjN = 0;
	return 1;
}

stock Obj_Line(const text[], st)
{
	new part[96], t[64];
	if (g_ObjN >= 8) return 0;
	Admin_Clean(text, t, sizeof t);
	format(part, sizeof part, "%s[\"%s\",%d]", g_ObjN ? (",") : (""), t, st);
	strcat(g_ObjJson, part, sizeof g_ObjJson);
	g_ObjN++;
	return 1;
}

stock Obj_Send(playerid)
{
	strcat(g_ObjJson, "]}", sizeof g_ObjJson);
	g_ObjShown[playerid] = 1;
	return ShowPlayerDialog(playerid, OBJ_DIALOG, DIALOG_STYLE_MSGBOX, "@obj", g_ObjJson, "OK", "");
}

stock Obj_Hide(playerid)
{
	if (!g_ObjShown[playerid] || !IsPlayerConnected(playerid)) return 0;
	g_ObjShown[playerid] = 0;
	return ShowPlayerDialog(playerid, OBJ_DIALOG, DIALOG_STYLE_MSGBOX, "@obj", "{\"show\":0}", "OK", "");
}

// Objectifs du metier en cours (appele a chaque etape, en montant / descendant du vehicule)
stock Job_SendObjectives(playerid)
{
	if (!g_JobOn[playerid]) return Obj_Hide(playerid);
	new job = g_JobOf[playerid];
	if (!Job_Valid(job)) return 0;
	new step = g_JobStep[playerid];
	new curKind = g_JobSteps[g_JobFirst[job] + step][jsKind];
	new nCut = 0, nDrop = 0, nStop = 0, dCut = 0, dDrop = 0, dStop = 0;
	for (new i = 0; i < g_JobNum[job]; i++)
	{
		new k = g_JobSteps[g_JobFirst[job] + i][jsKind];
		if (k == JK_CUT) { nCut++; if (i < step) dCut++; }
		else if (k == JK_DROP) { nDrop++; if (i < step) dDrop++; }
		else if (k == JK_STOP) { nStop++; if (i < step) dStop++; }
	}
	new sub[64], line[64];
	format(sub, sizeof sub, "Tournée %d · Niveau %d · +%d FCFA", g_JobRoutes[playerid] + 1, Job_Level(g_JobRoutes[playerid]), g_JobShift[playerid]);
	Obj_Begin(g_Jobs[job][jbName], sub);

	if (job == JOB_LUMBER)
	{
		format(line, sizeof line, "Coupe un arbre %d/%d", dCut, nCut);
		Obj_Line(line, (dCut >= nCut) ? 2 : ((curKind == JK_CUT) ? 1 : 0));
		format(line, sizeof line, "Dépose le bois à la scie %d/%d", dDrop, nDrop);
		Obj_Line(line, (dDrop >= nDrop) ? 2 : ((curKind == JK_DROP) ? 1 : 0));
		return Obj_Send(playerid);
	}

	new veh[32], stopTxt[32], back[32];
	switch (job)
	{
		case JOB_DELIVERY: { format(veh, sizeof veh, "ton camion de livraison"); format(stopTxt, sizeof stopTxt, "Livre les colis"); format(back, sizeof back, "Retourne au dépôt"); }
		case JOB_BUS:      { format(veh, sizeof veh, "ton bus"); format(stopTxt, sizeof stopTxt, "Dessers les arrêts"); format(back, sizeof back, "Retourne au terminus"); }
		case JOB_GARBAGE:  { format(veh, sizeof veh, "le camion-poubelle"); format(stopTxt, sizeof stopTxt, "Ramasse les poubelles"); format(back, sizeof back, "Va à la décharge"); }
		default:           { format(veh, sizeof veh, "ton scooter"); format(stopTxt, sizeof stopTxt, "Livre les pizzas"); format(back, sizeof back, "Retourne à la pizzeria"); }
	}
	new inVeh = (g_JobVeh[playerid] != INVALID_VEHICLE_ID && IsPlayerInVehicle(playerid, g_JobVeh[playerid])) ? 1 : 0;
	format(line, sizeof line, "Monte dans %s", veh);
	Obj_Line(line, inVeh ? 2 : 1);
	format(line, sizeof line, "%s %d/%d", stopTxt, dStop, nStop);
	Obj_Line(line, (dStop >= nStop) ? 2 : ((inVeh && curKind == JK_STOP) ? 1 : 0));
	Obj_Line(back, (inVeh && curKind == JK_DRIVE) ? 1 : 0);
	return Obj_Send(playerid);
}

stock Obj_OnConnect(playerid)
{
	g_ObjShown[playerid] = 0;
	return 1;
}

// Monter / descendre du vehicule de service : l'etape "Monte dans..." change
stock Obj_OnStateChange(playerid, newstate, oldstate)
{
	if (!g_JobOn[playerid]) return 0;
	if (newstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER || oldstate == PLAYER_STATE_PASSENGER)
		Job_SendObjectives(playerid);
	return 1;
}

// ============================================================
//  STAFF : /makeadmin, /admins, /a (chat staff), muet, observation
// ------------------------------------------------------------
//  /makeadmin <id> <0-10>  niveaux du panneau (1 Assistant ... 9 Developpeur, 10 Fondateur)
//     autorise : proprietaire (ADMIN_OWNER_NAME), connecte en RCON (/rcon login),
//                ou Developpeur (niveaux 0 a 2 seulement)
//  /admins                staff connecte
//  /a <texte>             chat reserve au staff
// ============================================================

// Chat du staff : en jeu (/a) et dans le panneau admin (onglet Staff)
stock Staff_Chat(playerid, const text[])
{
	new line[160], clean[112], name[MAX_PLAYER_NAME + 1], h, mi, sec;
	GetPlayerName(playerid, name, sizeof name);
	gettime(h, mi, sec);
	format(line, sizeof line, "[STAFF] %s : %s", name, text);
	Fx_StaffMsg(line);
	format(line, sizeof line, "%02d:%02d %s : %s", h, mi, name, text);
	Admin_Clean(line, clean, sizeof clean);
	if (g_StaffChatN < STAFF_CHAT_LINES) format(g_StaffChat[g_StaffChatN++], 112, "%s", clean);
	else
	{
		for (new i = 1; i < STAFF_CHAT_LINES; i++) format(g_StaffChat[i - 1], 112, "%s", g_StaffChat[i]);
		format(g_StaffChat[STAFF_CHAT_LINES - 1], 112, "%s", clean);
	}
	// mise a jour en direct des panneaux admin ouverts
	new json[1400];
	json = "{\"chat\":[";
	Staff_AppendChat(json, sizeof json, sizeof json - 4);
	strcat(json, "]}", sizeof json);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && g_AdminOpen[i] && Admin_Level(i) >= ADMIN_LVL_ADMIN)
			ShowPlayerDialog(i, ADMIN_DIALOG_UPDATE, DIALOG_STYLE_MSGBOX, "@admin", json, "OK", "");
	}
	return 1;
}

stock Staff_AppendChat(out[], size, limit)
{
	new part[120];
	for (new i = 0; i < g_StaffChatN; i++)
	{
		format(part, sizeof part, "%s\"%s\"", i ? (",") : (""), g_StaffChat[i]);
		if (strlen(out) + strlen(part) > limit) break;
		strcat(out, part, size);
	}
	return 1;
}

stock Staff_SetLevel(playerid, target, newLevel, msg[], msgsize)
{
	// Proprietaire / RCON : tous les niveaux. Sinon niveau 7 (Gestionnaire) mini, et uniquement
	// en dessous de son propre niveau, sur un membre de niveau inferieur au sien.
	new rcon = IsPlayerAdmin(playerid), owner = Admin_IsOwner(playerid), lvl = Admin_Level(playerid);
	new boss = rcon || owner;
	if (!boss && lvl < 7) { format(msg, msgsize, "Reserve au niveau 7 (Gestionnaire) et plus."); return 0; }
	if (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target)) { format(msg, msgsize, "Joueur introuvable."); return 0; }
	if (newLevel < 0 || newLevel > ADMIN_LVL_MAX) { format(msg, msgsize, "Niveau : 0 (joueur) a 10 (Fondateur)."); return 0; }
	if (Admin_IsOwner(target)) { format(msg, msgsize, "Ce joueur est intouchable."); return 0; }
	if (target == playerid && !boss) { format(msg, msgsize, "Tu ne peux pas modifier ton propre niveau."); return 0; }
	if (!g_AuthLogged[target]) { format(msg, msgsize, "Ce joueur n'est pas encore connecte a son compte."); return 0; }
	if (!boss && newLevel >= lvl) { format(msg, msgsize, "Tu peux seulement donner un niveau inferieur au tien (%d).", lvl); return 0; }
	if (!boss && Admin_Level(target) >= lvl) { format(msg, msgsize, "Ce membre a un niveau egal ou superieur au tien."); return 0; }
	if (g_AdminDB == DB:0) { format(msg, msgsize, "Base admin indisponible."); return 0; }

	new tname[MAX_PLAYER_NAME + 1], q[128], role[24], line[96];
	GetPlayerName(target, tname, sizeof tname);
	if (newLevel == 0) format(q, sizeof q, "DELETE FROM admins WHERE name = '%s'", tname);
	else format(q, sizeof q, "INSERT OR REPLACE INTO admins (name, level) VALUES ('%s', %d)", tname, newLevel);
	db_free_result(db_query(g_AdminDB, q));
	g_AdminLoaded[target] = 1;
	g_AdminLevel[target] = newLevel;
	Admin_RoleName(newLevel, role, sizeof role);
	format(line, sizeof line, "Ton role staff est maintenant : %s (niveau %d).", role, newLevel);
	SendClientMessage(target, ADMIN_COL_OK, line);
	format(msg, msgsize, "%s : %s (niveau %d).", tname, role, newLevel);
	return 1;
}

stock Staff_OnSpawn(playerid)
{
	if (g_AdmSpec[playerid] == 2)
	{
		g_AdmSpec[playerid] = 0;
		SetPlayerInterior(playerid, g_AdmSpecInt[playerid]);
		SetPlayerVirtualWorld(playerid, g_AdmSpecWorld[playerid]);
		SetPlayerPos(playerid, g_AdmSpecPos[playerid][0], g_AdmSpecPos[playerid][1], g_AdmSpecPos[playerid][2]);
	}
	return 1;
}

stock Staff_OnConnect(playerid)
{
	g_AdmMuted[playerid] = 0;
	g_AdmWarns[playerid] = 0;
	g_AdmSpec[playerid] = 0;
	return 1;
}

// Retourne 0 si le joueur est muet (le message est bloque)
stock Staff_OnText(playerid)
{
	if (g_AdmMuted[playerid])
	{
		SendClientMessage(playerid, ADMIN_COL_ERR, "Tu es muet : le staff t'a retire la parole.");
		return 0;
	}
	return 1;
}

stock Staff_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/makeadmin", true, 10) || !strcmp(cmdtext, "/setadmin", true, 9))
	{
		new idx = (cmdtext[4] == 'e' && cmdtext[5] == 'a') ? 10 : 9;   // /makeadmin ou /setadmin
		if (!strcmp(cmdtext, "/setadmin", true, 9)) idx = 9; else idx = 10;
		new tok[12], tok2[8], msg[128];
		Bank_NextToken(cmdtext, idx, tok, sizeof tok);
		Bank_NextToken(cmdtext, idx, tok2, sizeof tok2);
		if (!tok[0] || !tok2[0]) { SendClientMessage(playerid, ADMIN_COL_INFO, "Usage : /makeadmin <id> <0 joueur | 1 Admin | 2 Rcon | 3 Developpeur>"); return 1; }
		new ok = Staff_SetLevel(playerid, strval(tok), strval(tok2), msg, sizeof msg);
		SendClientMessage(playerid, ok ? ADMIN_COL_OK : ADMIN_COL_ERR, msg);
		if (ok)
		{
			new name[MAX_PLAYER_NAME + 1];
			GetPlayerName(playerid, name, sizeof name);
			printf("[ADMIN] %s : makeadmin %s %s", name, tok, tok2);
		}
		return 1;
	}
	if (!strcmp(cmdtext, "/admins", true))
	{
		new line[96], name[MAX_PLAYER_NAME + 1], role[24], n = 0;
		SendClientMessage(playerid, ADMIN_COL_INFO, "Staff connecte :");
		for (new i = 0; i < MAX_PLAYERS; i++)
		{
			if (!IsPlayerConnected(i) || Admin_Level(i) < ADMIN_LVL_ADMIN) continue;
			GetPlayerName(i, name, sizeof name);
			Admin_RoleName(Admin_Level(i), role, sizeof role);
			format(line, sizeof line, "  %s (%d) - %s", name, i, role);
			SendClientMessage(playerid, 0xFFFFFFFF, line);
			n++;
		}
		if (!n) SendClientMessage(playerid, 0xFFFFFFFF, "  Aucun membre du staff en ligne.");
		return 1;
	}
	if (!strcmp(cmdtext, "/a ", true, 3))
	{
		if (Admin_Level(playerid) < ADMIN_LVL_ADMIN) return 0;
		new idx = 3;
		while (cmdtext[idx] == ' ') idx++;
		if (!cmdtext[idx]) return 1;
		Staff_Chat(playerid, cmdtext[idx]);
		return 1;
	}
	return 0;
}

// ============================================================
//  GARAGES DES JOUEURS + MARQUEURS 3D FLOTTANTS
//  Relie a la page de l'application : assets/garage/index.html
// ------------------------------------------------------------
//  serveur -> client :
//     ShowPlayerDialog(9750 ouvrir / 9751 mise a jour / 9752 fermer, caption "@garage", JSON)
//        {"garage":"Garage Central","cash":5000,"maxOut":2,"msg":"","ok":1,
//         "veh":[{"id":12,"m":411,"n":"Infernus","plate":"CW-0012","hp":100,"fuel":100,"out":0,"sell":57000}]}
//     ShowPlayerDialog(9760, caption "@marks", JSON)  -> marqueurs 3D dessines par le moteur
//        [{"t":2,"x":..,"y":..,"z":..,"n":"Garage Central"},{"t":1,"x":..,"y":..,"z":..,"n":"Vetements"}]
//        t = 1 : t-shirt blanc flottant (magasin de vetements)   t = 2 : epingle + anneau (garage)
//  client -> serveur : /garact refresh | take <id> | store <id> | sell <id> | gps <id> | close
//  Joueur : main d'interaction "Garage" / "Vetements" pres d'un point, ou /garage
//  Staff  : /garageadd [nom]   /garagedel <id>   /garagespawn <id> (au volant)   /garages
//           /donnerveh <joueur> <modele> [prix]   (donne un vehicule, range dans le garage)
//  Donnees : SQLite  scriptfiles/crestwood_garage.db  (garages, points vetements, vehicules)
// ============================================================

#define GAR_DIALOG_OPEN       9750
#define GAR_DIALOG_UPDATE     9751
#define GAR_DIALOG_CLOSE      9752
#define MARK_DIALOG           9760

#define GAR_MAX               24          // garages
#define VET_MAX               24          // points vetements
#define GAR_LIST_MAX          14          // vehicules envoyes a la page
#define GAR_MAX_OUT           2           // vehicules sortis en meme temps
#define GAR_USE_RANGE         2.2         // distance pour ouvrir le garage (main d'interaction)
#define GAR_STORE_RANGE       35.0        // le vehicule doit etre a moins de 35 m du garage pour etre range
#define GAR_SELL_PCT          60          // revente : 60 % du prix
#define GAR_DEFAULT_PRICE     50000
#define GAR_DELIVERY_FEE      500         // [v15b] livraison du vehicule hors garage (/garage partout)
#define GAR_VALET_RANGE       25.0        // [v15b] ranger hors garage : vehicule a moins de 25 m de toi
#define VET_USE_RANGE         1.8

#define INTERACT_GARAGE       9           // cle 90

#define GAR_COL_OK            0x33CC33FF
#define GAR_COL_ERR           0xFF4444FF
#define GAR_COL_INFO          0x33CCFFFF

new DB:g_GarDB;

new g_GarCount;
new g_GarId[GAR_MAX];
new g_GarName[GAR_MAX][32];
new Float:g_GarPos[GAR_MAX][3];          // point a pied (epingle)
new Float:g_GarSpawn[GAR_MAX][4];        // sortie des vehicules (x, y, z, angle)

new g_VetCount;
new g_VetId[VET_MAX];
new Float:g_VetPos[VET_MAX][3];

new g_GarVehDb[MAX_VEHICLES + 1];        // id en base du vehicule de garage (0 = pas un vehicule de garage)
new g_GarVehOwner[MAX_VEHICLES + 1];
new g_GarOpen[MAX_PLAYERS];
new g_GarAt[MAX_PLAYERS];                // index du garage ouvert (-1 = aucun)

forward Gar_DestroyDead(vehicleid, dbid);

stock Gar_Msg(playerid, color, const text[])
{
	return SendClientMessage(playerid, color, text);
}

// Garde lettres, chiffres, espace, tiret, apostrophe (pas de guillemets dans le JSON ni de quote SQL)
stock Gar_CleanName(const in[], out[], outsize)
{
	new j = 0;
	for (new i = 0; in[i] != 0 && j < outsize - 1; i++)
	{
		new c = in[i];
		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' ' || c == '-') out[j++] = c;
	}
	out[j] = 0;
	return j;
}

// ------------------------------------------------------------
//  Base de donnees
// ------------------------------------------------------------
stock Gar_Load()
{
	g_GarCount = 0;
	g_VetCount = 0;
	if (g_GarDB == DB:0) return 0;
	new f[32], DBResult:res = db_query(g_GarDB, "SELECT id, name, x, y, z, sx, sy, sz, sa FROM garages ORDER BY id");
	if (res != DBResult:0)
	{
		new rows = db_num_rows(res);
		for (new r = 0; r < rows && g_GarCount < GAR_MAX; r++)
		{
			new i = g_GarCount;
			db_get_field(res, 0, f, sizeof f); g_GarId[i] = strval(f);
			db_get_field(res, 1, g_GarName[i], 32);
			for (new k = 0; k < 3; k++) { db_get_field(res, 2 + k, f, sizeof f); g_GarPos[i][k] = floatstr(f); }
			for (new k = 0; k < 4; k++) { db_get_field(res, 5 + k, f, sizeof f); g_GarSpawn[i][k] = floatstr(f); }
			g_GarCount++;
			db_next_row(res);
		}
		db_free_result(res);
	}
	res = db_query(g_GarDB, "SELECT id, x, y, z FROM vetpoints ORDER BY id");
	if (res != DBResult:0)
	{
		new rows = db_num_rows(res);
		for (new r = 0; r < rows && g_VetCount < VET_MAX; r++)
		{
			new i = g_VetCount;
			db_get_field(res, 0, f, sizeof f); g_VetId[i] = strval(f);
			for (new k = 0; k < 3; k++) { db_get_field(res, 1 + k, f, sizeof f); g_VetPos[i][k] = floatstr(f); }
			g_VetCount++;
			db_next_row(res);
		}
		db_free_result(res);
	}
	return 1;
}

stock Gar_InitDB()
{
	g_GarDB = db_open("crestwood_garage.db");
	if (g_GarDB == DB:0)
	{
		print("[GARAGE] ERREUR : impossible d'ouvrir crestwood_garage.db");
		return 0;
	}
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS garages (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL DEFAULT 'Garage', x REAL, y REAL, z REAL, sx REAL, sy REAL, sz REAL, sa REAL)"));
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS vetpoints (id INTEGER PRIMARY KEY AUTOINCREMENT, x REAL, y REAL, z REAL)"));
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS vehicles (id INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT COLLATE NOCASE NOT NULL, model INTEGER NOT NULL, c1 INTEGER DEFAULT 1, c2 INTEGER DEFAULT 1, price INTEGER DEFAULT 50000, hp REAL DEFAULT 1000, fuel INTEGER DEFAULT 100)"));
	Gar_Load();
	printf("[GARAGE] Base prete : %d garage(s), %d point(s) vetements.", g_GarCount, g_VetCount);
	return 1;
}

// ------------------------------------------------------------
//  Marqueurs 3D envoyes au client (icones dessinees dans le monde + main d'interaction)
//  Types : 1 vetements, 2 garage, 3 epingle, 4 boutique 24/7, 5 vestiaire, 6 banque, 7 emploi,
//          8 entree, 9 sortie, 10 peche, 11 maison, 12 braquage, 13 accessoires, 14 barbier, 15 tatouage
//  Envoi en plusieurs morceaux : 9760 = nouvelle liste, 9761 = suite (le client les ajoute).
// ------------------------------------------------------------
#define MARK_DIALOG_MORE      9761
new g_MkBuf[3700];
new g_MkTo = INVALID_PLAYER_ID;
new g_MkChunk;
new g_MkN;

stock Mk_Flush()
{
	strcat(g_MkBuf, "]", sizeof g_MkBuf);
	ShowPlayerDialog(g_MkTo, g_MkChunk == 0 ? MARK_DIALOG : MARK_DIALOG_MORE, DIALOG_STYLE_MSGBOX, "@marks", g_MkBuf, "OK", "");
	g_MkChunk++;
	g_MkN = 0;
	g_MkBuf = "[";
	return 1;
}

stock Mk_Add(type, Float:x, Float:y, Float:z)
{
	new part[64];
	format(part, sizeof part, "%s{\"t\":%d,\"x\":%.2f,\"y\":%.2f,\"z\":%.2f}", g_MkN ? (",") : (""), type, x, y, z);
	if (strlen(g_MkBuf) + strlen(part) > sizeof(g_MkBuf) - 4) { Mk_Flush(); format(part, sizeof part, "{\"t\":%d,\"x\":%.2f,\"y\":%.2f,\"z\":%.2f}", type, x, y, z); }
	strcat(g_MkBuf, part, sizeof g_MkBuf);
	g_MkN++;
	return 1;
}

stock Marks_Send(playerid)
{
	if (!IsPlayerConnected(playerid) || !g_AuthLogged[playerid]) return 0;
	g_MkTo = playerid; g_MkChunk = 0; g_MkN = 0; g_MkBuf = "[";
	for (new i = 0; i < g_GarCount; i++) Mk_Add(2, g_GarPos[i][0], g_GarPos[i][1], g_GarPos[i][2] - 0.95);
	Fish_PushMarks();
	House_PushMarks();
	Rob_PushMarks();
	Cw_PushMarks();          // banques, boutiques, emplois, entrees, vestiaires (fin du fichier)
	Svc_PushMarks();         // pompes a essence (16) + location (17)
	if (g_MkChunk == 0 || g_MkN > 0) Mk_Flush();
	g_MkTo = INVALID_PLAYER_ID;
	return 1;
}

stock Marks_SendAll()
{
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (IsPlayerConnected(i) && g_AuthLogged[i]) Marks_Send(i);
	}
	return 1;
}

// ------------------------------------------------------------
//  Vehicules
// ------------------------------------------------------------
stock Gar_VehName(model, out[], outsize)
{
	if (model >= 400 && model <= 611) format(out, outsize, "%s", g_VehName[model - 400]);
	else format(out, outsize, "Vehicule");
	return 1;
}

// vehicleid du vehicule de garage "dbid" s'il est sorti, sinon 0
stock Gar_FindOut(dbid)
{
	if (dbid <= 0) return 0;
	for (new v = 1; v <= MAX_VEHICLES; v++)
	{
		if (g_GarVehDb[v] == dbid) return v;
	}
	return 0;
}

stock Gar_CountOut(playerid)
{
	new n = 0;
	for (new v = 1; v <= MAX_VEHICLES; v++)
	{
		if (g_GarVehDb[v] && g_GarVehOwner[v] == playerid) n++;
	}
	return n;
}

stock Gar_NearGarage(playerid, Float:range)
{
	for (new i = 0; i < g_GarCount; i++)
	{
		if (IsPlayerInRangeOfPoint(playerid, range, g_GarPos[i][0], g_GarPos[i][1], g_GarPos[i][2])) return i;
	}
	return -1;
}

stock Gar_NearVet(playerid)
{
	for (new i = 0; i < g_VetCount; i++)
	{
		if (IsPlayerInRangeOfPoint(playerid, VET_USE_RANGE, g_VetPos[i][0], g_VetPos[i][1], g_VetPos[i][2])) return i;
	}
	return -1;
}

// Charge une ligne "vehicles" appartenant au joueur. Retourne 1 si trouvee.
stock Gar_GetRow(playerid, dbid, &model, &price, &Float:hp, &fuel)
{
	if (g_GarDB == DB:0 || dbid <= 0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[160], f[24];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT model, price, hp, fuel FROM vehicles WHERE id = %d AND owner = '%s'", dbid, name);
	new DBResult:res = db_query(g_GarDB, q);
	if (res == DBResult:0) return 0;
	new ok = db_num_rows(res) > 0;
	if (ok)
	{
		db_get_field(res, 0, f, sizeof f); model = strval(f);
		db_get_field(res, 1, f, sizeof f); price = strval(f);
		db_get_field(res, 2, f, sizeof f); hp = floatstr(f);
		db_get_field(res, 3, f, sizeof f); fuel = strval(f);
	}
	db_free_result(res);
	return ok;
}

// Sauvegarde l'etat d'un vehicule sorti puis le supprime du monde
stock Gar_StoreVehicle(vehicleid)
{
	if (vehicleid <= 0 || vehicleid > MAX_VEHICLES) return 0;
	new dbid = g_GarVehDb[vehicleid];
	if (!dbid) return 0;
	new Float:hp, q[96];
	GetVehicleHealth(vehicleid, hp);
	if (hp < 300.0) hp = 300.0;
	if (hp > 1000.0) hp = 1000.0;
	format(q, sizeof q, "UPDATE vehicles SET hp = %.1f, fuel = %d WHERE id = %d", hp, floatround(g_CwFuel[vehicleid]), dbid);
	if (g_GarDB != DB:0) db_free_result(db_query(g_GarDB, q));
	g_GarVehDb[vehicleid] = 0;
	g_GarVehOwner[vehicleid] = INVALID_PLAYER_ID;
	if (g_VehOwner[vehicleid] != INVALID_PLAYER_ID && g_PlayerVeh[g_VehOwner[vehicleid]] != vehicleid) g_VehOwner[vehicleid] = INVALID_PLAYER_ID;
	DestroyVehicle(vehicleid);
	return 1;
}

// ------------------------------------------------------------
//  Page garage
// ------------------------------------------------------------
stock Gar_Send(playerid, dialogid, ok = 1, const msg[] = "")
{
	if (g_GarDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[180], json[3000], part[200], f[24], vname[32];
	GetPlayerName(playerid, name, sizeof name);
	new gi = g_GarAt[playerid];
	if (Gar_NearGarage(playerid, GAR_USE_RANGE + 4.0) < 0) gi = -1;
	format(json, sizeof json, "{\"garage\":\"%s\",\"at\":%d,\"deliv\":%d,\"cash\":%d,\"bank\":%d,\"maxOut\":%d,\"ok\":%d,\"msg\":\"%s\",\"veh\":[",
		(gi >= 0 && gi < g_GarCount) ? g_GarName[gi] : ("Mes vehicules"), (gi >= 0 && gi < g_GarCount) ? 1 : 0, GAR_DELIVERY_FEE, GetPlayerMoney(playerid), g_BankBalance[playerid], GAR_MAX_OUT, ok, msg);
	format(q, sizeof q, "SELECT id, model, price, hp, fuel FROM vehicles WHERE owner = '%s' ORDER BY id LIMIT %d", name, GAR_LIST_MAX);
	new DBResult:res = db_query(g_GarDB, q);
	if (res != DBResult:0)
	{
		new rows = db_num_rows(res);
		for (new r = 0; r < rows; r++)
		{
			db_get_field(res, 0, f, sizeof f); new id = strval(f);
			db_get_field(res, 1, f, sizeof f); new model = strval(f);
			db_get_field(res, 2, f, sizeof f); new price = strval(f);
			db_get_field(res, 3, f, sizeof f); new Float:hp = floatstr(f);
			db_get_field(res, 4, f, sizeof f); new fuel = strval(f);
			new v = Gar_FindOut(id);
			if (v) GetVehicleHealth(v, hp);
			new pct = floatround((hp - 250.0) / 7.5);
			if (pct < 0) pct = 0;
			if (pct > 100) pct = 100;
			Gar_VehName(model, vname, sizeof vname);
			format(part, sizeof part, "%s{\"id\":%d,\"m\":%d,\"n\":\"%s\",\"plate\":\"CW-%04d\",\"hp\":%d,\"fuel\":%d,\"out\":%d,\"sell\":%d}",
				r ? (",") : (""), id, model, vname, id, pct, fuel, v ? 1 : 0, price / 100 * GAR_SELL_PCT);
			strcat(json, part, sizeof json);
			db_next_row(res);
		}
		db_free_result(res);
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@garage", json, "OK", "");
}

stock Garage_Open(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	// [v15b] /garage et la roue ouvrent le garage PARTOUT : pres d'un garage le vehicule sort a la sortie
	// du garage, ailleurs il est livre a cote de toi (GAR_DELIVERY_FEE).
	g_GarAt[playerid] = Gar_NearGarage(playerid, GAR_USE_RANGE + 4.0);
	g_GarOpen[playerid] = 1;
	return Gar_Send(playerid, GAR_DIALOG_OPEN);
}

stock Gar_Close(playerid, notify)
{
	if (!g_GarOpen[playerid]) return 0;
	g_GarOpen[playerid] = 0;
	if (notify) ShowPlayerDialog(playerid, GAR_DIALOG_CLOSE, DIALOG_STYLE_MSGBOX, "@garage", "{}", "OK", "");
	return 1;
}

stock Gar_Take(playerid, dbid)
{
	new gi = Gar_NearGarage(playerid, GAR_USE_RANGE + 4.0);
	new model, price, Float:hp, fuel;
	if (!Gar_GetRow(playerid, dbid, model, price, hp, fuel)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Vehicule introuvable.");
	if (Gar_FindOut(dbid)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Ce vehicule est deja sorti.");
	if (Gar_CountOut(playerid) >= GAR_MAX_OUT) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Range d'abord un de tes vehicules.");
	new Float:sx, Float:sy, Float:sz, Float:sa, deliv = 0;
	if (gi >= 0)
	{
		sx = g_GarSpawn[gi][0]; sy = g_GarSpawn[gi][1]; sz = g_GarSpawn[gi][2]; sa = g_GarSpawn[gi][3];
	}
	else
	{
		if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0 || IsPlayerInAnyVehicle(playerid))
			return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Sors dehors (a pied) pour te faire livrer le vehicule.");
		if (GetPlayerMoney(playerid) < GAR_DELIVERY_FEE && (!g_BankLoaded[playerid] || g_BankBalance[playerid] < GAR_DELIVERY_FEE))
			return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Livraison : 500 FCFA (liquide ou banque).");
		GetPlayerPos(playerid, sx, sy, sz);
		GetPlayerFacingAngle(playerid, sa);
		sx += 4.0 * floatcos(sa, degrees);
		sy += 4.0 * floatsin(sa, degrees);
		sz += 0.6;
		deliv = 1;
	}
	new c1 = 1, c2 = 1, q[96], f[12];
	format(q, sizeof q, "SELECT c1, c2 FROM vehicles WHERE id = %d", dbid);
	new DBResult:res = db_query(g_GarDB, q);
	if (res != DBResult:0)
	{
		if (db_num_rows(res) > 0)
		{
			db_get_field(res, 0, f, sizeof f); c1 = strval(f);
			db_get_field(res, 1, f, sizeof f); c2 = strval(f);
		}
		db_free_result(res);
	}
	new v = CreateVehicle(model, sx, sy, sz, sa, c1, c2, -1);
	if (v == INVALID_VEHICLE_ID || v <= 0 || v > MAX_VEHICLES) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Impossible de sortir le vehicule (limite atteinte).");
	new plate[12];
	format(plate, sizeof plate, "CW-%04d", dbid);
	SetVehicleNumberPlate(v, plate);
	SetVehicleToRespawn(v);   // applique la plaque
	SetVehicleHealth(v, hp < 300.0 ? 300.0 : hp);
	SetVehicleVirtualWorld(v, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(v, GetPlayerInterior(playerid));
	SetVehicleParamsEx(v, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF);
	g_GarVehDb[v] = dbid;
	g_CwFuel[v] = float(fuel);   // carburant enregistre
	g_GarVehOwner[v] = playerid;
	g_VehOwner[v] = playerid;   // verrouillage / moteur du HUD
	new vname[32], msg[96];
	Gar_VehName(model, vname, sizeof vname);
	if (deliv)
	{
		if (GetPlayerMoney(playerid) >= GAR_DELIVERY_FEE) GivePlayerMoney(playerid, -GAR_DELIVERY_FEE);
		else { g_BankBalance[playerid] -= GAR_DELIVERY_FEE; Bank_AddHistory(playerid, "Livraison de vehicule", -GAR_DELIVERY_FEE); Bank_SavePlayer(playerid); }
		format(msg, sizeof msg, "Garage : ton %s a ete livre a cote de toi (-%d FCFA).", vname, GAR_DELIVERY_FEE);
		Gar_Msg(playerid, GAR_COL_OK, msg);
	}
	else
	{
		format(msg, sizeof msg, "Garage : ton %s t'attend a la sortie du garage.", vname);
		Gar_Msg(playerid, GAR_COL_OK, msg);
		Gps_Set(playerid, sx, sy);
	}
	Gar_Close(playerid, 1);
	return 1;
}

stock Gar_Store(playerid, dbid)
{
	new gi = Gar_NearGarage(playerid, GAR_USE_RANGE + 4.0);
	new model, price, Float:hp, fuel;
	if (!Gar_GetRow(playerid, dbid, model, price, hp, fuel)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Vehicule introuvable.");
	new v = Gar_FindOut(dbid);
	if (!v) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Ce vehicule est deja au garage.");
	new Float:x, Float:y, Float:z;
	GetVehiclePos(v, x, y, z);
	if (gi >= 0)
	{
		new Float:dx = x - g_GarPos[gi][0], Float:dy = y - g_GarPos[gi][1], Float:dz = z - g_GarPos[gi][2];
		if (dx * dx + dy * dy + dz * dz > GAR_STORE_RANGE * GAR_STORE_RANGE)
			return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Ramene d'abord le vehicule devant le garage.");
	}
	else if (GetPlayerVirtualWorld(playerid) != GetVehicleVirtualWorld(v) || !IsPlayerInRangeOfPoint(playerid, GAR_VALET_RANGE, x, y, z))
		return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Le vehicule doit etre a moins de 25 m de toi (ou devant un garage).");
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (IsPlayerConnected(i) && IsPlayerInVehicle(i, v))
			return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Le vehicule doit etre vide pour etre range.");
	}
	Gar_StoreVehicle(v);
	return Gar_Send(playerid, GAR_DIALOG_UPDATE, 1, "Vehicule range au garage.");
}

stock Gar_Sell(playerid, dbid)
{
	new model, price, Float:hp, fuel;
	if (!Gar_GetRow(playerid, dbid, model, price, hp, fuel)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Vehicule introuvable.");
	if (Gar_FindOut(dbid)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Range d'abord le vehicule avant de le vendre.");
	new q[64], amount = price / 100 * GAR_SELL_PCT;
	format(q, sizeof q, "DELETE FROM vehicles WHERE id = %d", dbid);
	db_free_result(db_query(g_GarDB, q));
	GivePlayerMoney(playerid, amount);
	new vname[32], msg[96];
	Gar_VehName(model, vname, sizeof vname);
	format(msg, sizeof msg, "%s vendu pour %d FCFA.", vname, amount);
	return Gar_Send(playerid, GAR_DIALOG_UPDATE, 1, msg);
}

stock Gar_Locate(playerid, dbid)
{
	new model, price, Float:hp, fuel;
	if (!Gar_GetRow(playerid, dbid, model, price, hp, fuel)) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Vehicule introuvable.");
	new v = Gar_FindOut(dbid);
	if (!v) return Gar_Send(playerid, GAR_DIALOG_UPDATE, 0, "Ce vehicule est au garage.");
	new Float:x, Float:y, Float:z;
	GetVehiclePos(v, x, y, z);
	Gps_Set(playerid, x, y);
	return Gar_Send(playerid, GAR_DIALOG_UPDATE, 1, "Position du vehicule marquee sur ton GPS.");
}

// ------------------------------------------------------------
//  Interaction (main du HUD) : 90 garage
// ------------------------------------------------------------
stock Garage_InteractKey(playerid)
{
	if (!g_AuthLogged[playerid] || g_GarOpen[playerid]) return 0;
	if (Gar_NearGarage(playerid, GAR_USE_RANGE) >= 0) return INTERACT_GARAGE * 10;
	new k = House_InteractKey(playerid);   // 120 porte de maison, 121 sortie (a l'interieur)
	if (k) return k;
	return Fish_InteractKey(playerid);      // 110 ponton de peche
}

stock Vet_InRange(playerid, slot, Float:range)
{
	if (slot < 0 || slot >= g_VetCount) return 0;
	return IsPlayerInRangeOfPoint(playerid, range, g_VetPos[slot][0], g_VetPos[slot][1], g_VetPos[slot][2]);
}

// ------------------------------------------------------------
//  Evenements
// ------------------------------------------------------------
stock Garage_OnInit()
{
	for (new v = 0; v <= MAX_VEHICLES; v++) { g_GarVehDb[v] = 0; g_GarVehOwner[v] = INVALID_PLAYER_ID; }
	return Gar_InitDB();
}

stock Garage_OnExit()
{
	for (new v = 1; v <= MAX_VEHICLES; v++) if (g_GarVehDb[v]) Gar_StoreVehicle(v);
	if (g_GarDB != DB:0) db_close(g_GarDB);
	return 1;
}

stock Garage_OnConnect(playerid)
{
	g_GarOpen[playerid] = 0;
	g_GarAt[playerid] = -1;
	return 1;
}

// A la deconnexion, les vehicules sortis retournent au garage (etat sauvegarde)
stock Garage_OnDisconnect(playerid)
{
	for (new v = 1; v <= MAX_VEHICLES; v++)
	{
		if (g_GarVehDb[v] && g_GarVehOwner[v] == playerid) Gar_StoreVehicle(v);
	}
	g_GarOpen[playerid] = 0;
	g_GarAt[playerid] = -1;
	return 1;
}

stock Garage_OnSpawn(playerid)
{
	return Marks_Send(playerid);
}

// Vehicule de garage detruit : remorque au garage (assurance), repare
stock Garage_OnVehicleDeath(vehicleid)
{
	if (vehicleid <= 0 || vehicleid > MAX_VEHICLES) return 0;
	new dbid = g_GarVehDb[vehicleid];
	if (!dbid) return 0;
	new owner = g_GarVehOwner[vehicleid], q[80];
	format(q, sizeof q, "UPDATE vehicles SET hp = 1000 WHERE id = %d", dbid);
	if (g_GarDB != DB:0) db_free_result(db_query(g_GarDB, q));
	g_GarVehDb[vehicleid] = 0;
	g_GarVehOwner[vehicleid] = INVALID_PLAYER_ID;
	g_VehOwner[vehicleid] = INVALID_PLAYER_ID;   // pas de double suppression par Veh_OnDeath
	SetTimerEx("Gar_DestroyDead", 3000, false, "ii", vehicleid, dbid);
	if (owner != INVALID_PLAYER_ID && IsPlayerConnected(owner))
		Gar_Msg(owner, GAR_COL_INFO, "Garage : ton vehicule a ete detruit, l'assurance l'a remorque au garage.");
	return 1;
}

public Gar_DestroyDead(vehicleid, dbid)
{
	if (vehicleid <= 0 || vehicleid > MAX_VEHICLES) return 0;
	if (g_GarVehDb[vehicleid] != 0) return 0;              // l'id a deja ete reutilise par un vehicule de garage
	if (g_VehOwner[vehicleid] != INVALID_PLAYER_ID) return 0; // ... ou par un /v
	DestroyVehicle(vehicleid);
	return 1;
}

// ------------------------------------------------------------
//  Commandes
// ------------------------------------------------------------
stock Garage_OnCommand(playerid, const cmdtext[])
{
	new idx, tok[32];
	if (!strcmp(cmdtext, "/garact ", true, 8))
	{
		if (!g_AuthLogged[playerid]) return 1;
		idx = 8;
		Bank_NextToken(cmdtext, idx, tok, sizeof tok);
		new arg[16];
		Bank_NextToken(cmdtext, idx, arg, sizeof arg);
		new id = strval(arg);
		if (!strcmp(tok, "close", true)) { g_GarOpen[playerid] = 0; return 1; }
		if (!g_GarOpen[playerid]) return 1;
		if (!strcmp(tok, "refresh", true)) Gar_Send(playerid, GAR_DIALOG_UPDATE);
		else if (!strcmp(tok, "take", true)) Gar_Take(playerid, id);
		else if (!strcmp(tok, "store", true)) Gar_Store(playerid, id);
		else if (!strcmp(tok, "sell", true)) Gar_Sell(playerid, id);
		else if (!strcmp(tok, "gps", true)) Gar_Locate(playerid, id);
		return 1;
	}
	if (!strcmp(cmdtext, "/garage", true))
	{
		Garage_Open(playerid);
		return 1;
	}

	// ---------------- staff ----------------
	if (!strcmp(cmdtext, "/garageadd", true, 10) && (cmdtext[10] == 0 || cmdtext[10] == ' '))
	{
		if (Admin_Level(playerid) < 6) return 0;
		if (g_GarCount >= GAR_MAX) return Gar_Msg(playerid, GAR_COL_ERR, "Garage : nombre maximum de garages atteint.");
		if (IsPlayerInAnyVehicle(playerid)) return Gar_Msg(playerid, GAR_COL_ERR, "Garage : descends du vehicule (le point est pose a tes pieds).");
		new name[32];
		if (!Gar_CleanName(cmdtext[cmdtext[10] ? 11 : 10], name, sizeof name)) format(name, sizeof name, "Garage %d", g_GarCount + 1);
		new Float:x, Float:y, Float:z, Float:a;
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, a);
		new Float:sx = x + 6.0 * floatsin(-a, degrees), Float:sy = y + 6.0 * floatcos(-a, degrees);
		new q[256];
		format(q, sizeof q, "INSERT INTO garages (name, x, y, z, sx, sy, sz, sa) VALUES ('%s', %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.2f)", name, x, y, z, sx, sy, z + 0.4, a);
		db_free_result(db_query(g_GarDB, q));
		Gar_Load();
		Marks_SendAll();
		format(q, sizeof q, "Garage \"%s\" cree. Les vehicules sortiront 6 m devant toi (/garagespawn <id> au volant pour changer).", name);
		return Gar_Msg(playerid, GAR_COL_OK, q);
	}
	if (!strcmp(cmdtext, "/garagedel ", true, 11))
	{
		if (Admin_Level(playerid) < 6) return 0;
		new id = strval(cmdtext[11]), q[64];
		format(q, sizeof q, "DELETE FROM garages WHERE id = %d", id);
		db_free_result(db_query(g_GarDB, q));
		Gar_Load();
		Marks_SendAll();
		return Gar_Msg(playerid, GAR_COL_OK, "Garage supprime (s'il existait).");
	}
	if (!strcmp(cmdtext, "/garagespawn ", true, 13))
	{
		if (Admin_Level(playerid) < 6) return 0;
		if (!IsPlayerInAnyVehicle(playerid)) return Gar_Msg(playerid, GAR_COL_ERR, "Garage : mets-toi au volant a l'endroit de sortie voulu.");
		new id = strval(cmdtext[13]), v = GetPlayerVehicleID(playerid), Float:x, Float:y, Float:z, Float:a, q[160];
		GetVehiclePos(v, x, y, z);
		GetVehicleZAngle(v, a);
		format(q, sizeof q, "UPDATE garages SET sx = %.3f, sy = %.3f, sz = %.3f, sa = %.2f WHERE id = %d", x, y, z + 0.2, a, id);
		db_free_result(db_query(g_GarDB, q));
		Gar_Load();
		return Gar_Msg(playerid, GAR_COL_OK, "Sortie du garage mise a jour.");
	}
	if (!strcmp(cmdtext, "/garages", true))
	{
		if (Admin_Level(playerid) < 6) return 0;
		new line[96];
		if (!g_GarCount) Gar_Msg(playerid, GAR_COL_INFO, "Aucun garage. /garageadd [nom] pour en creer un.");
		for (new i = 0; i < g_GarCount; i++)
		{
			format(line, sizeof line, "  #%d  %s  (%.0f, %.0f, %.0f)", g_GarId[i], g_GarName[i], g_GarPos[i][0], g_GarPos[i][1], g_GarPos[i][2]);
			Gar_Msg(playerid, 0xFFFFFFFF, line);
		}
		return 1;
	}
	if (!strcmp(cmdtext, "/donnerveh ", true, 11))
	{
		if (Admin_Level(playerid) < 8) return 0;
		idx = 11;
		new sTarget[8], sModel[24], sPrice[12];
		Bank_NextToken(cmdtext, idx, sTarget, sizeof sTarget);
		Bank_NextToken(cmdtext, idx, sModel, sizeof sModel);
		Bank_NextToken(cmdtext, idx, sPrice, sizeof sPrice);
		new target = strval(sTarget), model = Veh_FindModel(sModel), price = sPrice[0] ? strval(sPrice) : GAR_DEFAULT_PRICE;
		if (!sTarget[0] || !IsPlayerConnected(target) || !g_AuthLogged[target]) return Gar_Msg(playerid, GAR_COL_ERR, "Usage : /donnerveh <id joueur> <modele ou nom> [prix]");
		if (!model || Veh_IsBlocked(model)) return Gar_Msg(playerid, GAR_COL_ERR, "Garage : modele invalide.");
		if (price < 0) price = 0;
		new name[MAX_PLAYER_NAME + 1], q[200], vname[32];
		GetPlayerName(target, name, sizeof name);
		format(q, sizeof q, "INSERT INTO vehicles (owner, model, c1, c2, price) VALUES ('%s', %d, %d, %d, %d)", name, model, random(127), random(127), price);
		db_free_result(db_query(g_GarDB, q));
		Gar_VehName(model, vname, sizeof vname);
		format(q, sizeof q, "Garage : %s a recu un %s (range dans son garage).", name, vname);
		Gar_Msg(playerid, GAR_COL_OK, q);
		format(q, sizeof q, "Tu as recu un %s ! Il t'attend dans n'importe quel garage.", vname);
		Gar_Msg(target, GAR_COL_OK, q);
		return 1;
	}
	return 0;
}

// ============================================================
//  ADMINISTRATION (suite) : actions du panneau admin qui manquaient
// ------------------------------------------------------------
//  - Niveaux 0 a 10 (memes noms que ROLES dans assets/admin/admin.js), Adm_Need() = niveau requis
//    pour chaque action du panneau (meme valeur que "lvl" dans admin.js).
//  - Bannissements geres par le gamemode (table bans de crestwood_admins.db) : ban avec duree,
//    ban hors ligne, debannir. Verifies a la connexion (nom ou IP).
//  - Journal des actions staff (table adminlog), envoye a l'onglet Staff.
//  - Gangs : Cold Blooded, Jungle Boys, Silent Killers, Royal Vipers (membres, grades, points, saisons).
//  Donnees supplementaires envoyees au panneau (dialogue 9541, champ "x") :
//    {"x":"fac",...} {"x":"gang",...} {"x":"ban",...} {"x":"log",...}
// ============================================================

#define GANG_COUNT            4
#define GANG_RANK_MAX         4
#define ADMX_BAN_LIST         14
#define ADMX_LOG_LIST         16

new const g_GangName[GANG_COUNT + 1][16] = { "", "Cold Blooded", "Jungle Boys", "Silent Killers", "Royal Vipers" };
new const g_GangTag[GANG_COUNT + 1][4] = { "", "CB", "JB", "SK", "RV" };
new const g_GangColor[GANG_COUNT + 1][8] = { "", "#4da8ff", "#3ddc97", "#ff4d4d", "#a855f7" };
new const g_GangRankName[GANG_RANK_MAX + 1][12] = { "", "Recrue", "Soldat", "Lieutenant", "Chef" };

new g_GangOf[MAX_PLAYERS];
new g_GangRank[MAX_PLAYERS];
new g_GangPts[GANG_COUNT + 1];
new g_GangSeason = 1;
new g_AdmGod[MAX_PLAYERS];

// Niveau staff requis par action du panneau (identique a admin.js)
stock Adm_Need(const action[])
{
	new cwn = Cw_AdminNeed(action);   // [v15] invisible, zones vertes, pompes, encheres
	if (cwn) return cwn;
	static const lv2[][] = { "heal", "bring", "freeze", "slap", "mute", "warn", "sethp", "armour", "announce", "screen", "clearchat" };
	static const lv3[][] = { "kick", "jail", "unjail", "disarm", "kill", "resetwarns", "setvw", "setint" };
	static const lv4[][] = { "setfaction", "setrank", "setgang", "setgangrank", "setskin", "god", "tpxyz", "healall",
		"lockeradd", "lockerdel", "lockergoto" };
	static const lv5[][] = { "ban", "givegun", "jetpack", "delveh", "vehicle", "weather", "time", "freezeall", "unfreezeall", "unban" };
	static const lv6[][] = { "banoff", "createfac", "removefac", "setentree", "setprison", "prisonexit", "gangpts" };
	static const lv7[][] = { "makeadmin", "setadmin" };
	static const lv8[][] = { "givemoney", "givebank" };
	static const lv9[][] = { "gmx", "gangseason" };
	for (new i = 0; i < sizeof lv9; i++) if (!strcmp(action, lv9[i], true)) return 9;
	for (new i = 0; i < sizeof lv8; i++) if (!strcmp(action, lv8[i], true)) return 8;
	for (new i = 0; i < sizeof lv7; i++) if (!strcmp(action, lv7[i], true)) return 7;
	for (new i = 0; i < sizeof lv6; i++) if (!strcmp(action, lv6[i], true)) return 6;
	for (new i = 0; i < sizeof lv5; i++) if (!strcmp(action, lv5[i], true)) return 5;
	for (new i = 0; i < sizeof lv4; i++) if (!strcmp(action, lv4[i], true)) return 4;
	for (new i = 0; i < sizeof lv3; i++) if (!strcmp(action, lv3[i], true)) return 3;
	for (new i = 0; i < sizeof lv2; i++) if (!strcmp(action, lv2[i], true)) return 2;
	return 1;
}

// ------------------------------------------------------------
//  Base : bans, journal, gangs (dans crestwood_admins.db)
// ------------------------------------------------------------
stock AdmX_InitDB()
{
	if (g_AdminDB == DB:0) return 0;
	db_free_result(db_query(g_AdminDB, "CREATE TABLE IF NOT EXISTS bans (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT COLLATE NOCASE, ip TEXT, reason TEXT, by TEXT, until INTEGER DEFAULT 0, at INTEGER DEFAULT 0)"));
	db_free_result(db_query(g_AdminDB, "CREATE TABLE IF NOT EXISTS adminlog (id INTEGER PRIMARY KEY AUTOINCREMENT, at INTEGER, name TEXT, txt TEXT, ok INTEGER, lvl INTEGER)"));
	db_free_result(db_query(g_AdminDB, "CREATE TABLE IF NOT EXISTS gang_members (name TEXT PRIMARY KEY COLLATE NOCASE, gang INTEGER, rank INTEGER)"));
	db_free_result(db_query(g_AdminDB, "CREATE TABLE IF NOT EXISTS gang_state (id INTEGER PRIMARY KEY, pts INTEGER DEFAULT 0)"));
	db_free_result(db_query(g_AdminDB, "CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v INTEGER)"));

	// Migration des anciens niveaux (1 Admin, 2 Rcon, 3 Developpeur) vers 0..10 (une seule fois)
	new DBResult:res = db_query(g_AdminDB, "SELECT v FROM meta WHERE k = 'levels10'");
	new done = (res != DBResult:0 && db_num_rows(res) > 0);
	if (res != DBResult:0) db_free_result(res);
	if (!done)
	{
		db_free_result(db_query(g_AdminDB, "UPDATE admins SET level = CASE level WHEN 1 THEN 4 WHEN 2 THEN 6 WHEN 3 THEN 9 ELSE level END"));
		db_free_result(db_query(g_AdminDB, "INSERT OR REPLACE INTO meta (k, v) VALUES ('levels10', 1)"));
		print("[ADMIN] Niveaux staff convertis : Admin -> 4, Rcon -> 6, Developpeur -> 9.");
	}

	new f[16];
	res = db_query(g_AdminDB, "SELECT v FROM meta WHERE k = 'gang_season'");
	if (res != DBResult:0)
	{
		if (db_num_rows(res) > 0) { db_get_field(res, 0, f, sizeof f); g_GangSeason = strval(f); }
		db_free_result(res);
	}
	if (g_GangSeason < 1) g_GangSeason = 1;
	for (new g = 1; g <= GANG_COUNT; g++) g_GangPts[g] = 0;
	res = db_query(g_AdminDB, "SELECT id, pts FROM gang_state");
	if (res != DBResult:0)
	{
		new rows = db_num_rows(res);
		for (new r = 0; r < rows; r++)
		{
			db_get_field(res, 0, f, sizeof f); new g = strval(f);
			db_get_field(res, 1, f, sizeof f);
			if (g >= 1 && g <= GANG_COUNT) g_GangPts[g] = strval(f);
			db_next_row(res);
		}
		db_free_result(res);
	}
	return 1;
}

stock AdmX_Now()
{
	return gettime();
}

stock AdmX_Log(playerid, const txt[], ok, lvl)
{
	if (g_AdminDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], clean[100], q[260];
	GetPlayerName(playerid, name, sizeof name);
	Admin_Clean(txt, clean, sizeof clean);
	for (new i = 0; clean[i] != 0; i++) if (clean[i] == '\'') clean[i] = ' ';
	format(q, sizeof q, "INSERT INTO adminlog (at, name, txt, ok, lvl) VALUES (%d, '%s', '%s', %d, %d)", AdmX_Now(), name, clean, ok, lvl);
	db_free_result(db_query(g_AdminDB, q));
	return 1;
}

// ------------------------------------------------------------
//  Bans
// ------------------------------------------------------------
stock AdmX_AddBan(const name[], const ip[], const reason[], const by[], days)
{
	if (g_AdminDB == DB:0) return 0;
	new r[64], q[300];
	Admin_Clean(reason, r, sizeof r);
	for (new i = 0; r[i] != 0; i++) if (r[i] == '\'') r[i] = ' ';
	new until = days > 0 ? AdmX_Now() + days * 86400 : 0;
	format(q, sizeof q, "INSERT INTO bans (name, ip, reason, by, until, at) VALUES ('%s', '%s', '%s', '%s', %d, %d)", name, ip, r, by, until, AdmX_Now());
	db_free_result(db_query(g_AdminDB, q));
	return 1;
}

// A la connexion : banni (nom ou IP) -> message + expulsion. Retourne 1 si banni.
stock AdmX_CheckBan(playerid)
{
	if (g_AdminDB == DB:0 || IsPlayerNPC(playerid)) return 0;
	new name[MAX_PLAYER_NAME + 1], ip[20], q[260], f[96];
	GetPlayerName(playerid, name, sizeof name);
	GetPlayerIp(playerid, ip, sizeof ip);
	if (!strcmp(name, ADMIN_OWNER_NAME, true)) return 0;
	format(q, sizeof q, "SELECT reason, until FROM bans WHERE (name = '%s' OR (ip = '%s' AND ip != '')) AND (until = 0 OR until > %d) ORDER BY id DESC LIMIT 1", name, ip, AdmX_Now());
	new DBResult:res = db_query(g_AdminDB, q);
	if (res == DBResult:0) return 0;
	new banned = db_num_rows(res) > 0;
	if (banned)
	{
		new reason[64], line[160];
		db_get_field(res, 0, reason, sizeof reason);
		db_get_field(res, 1, f, sizeof f);
		new until = strval(f);
		if (until) format(line, sizeof line, "Tu es banni de Crestwood RP (%s) encore %d jour(s).", reason, (until - AdmX_Now()) / 86400 + 1);
		else format(line, sizeof line, "Tu es banni definitivement de Crestwood RP (%s).", reason);
		SendClientMessage(playerid, ADMIN_COL_ERR, line);
		SetTimerEx("Admin_DelayedKick", 800, false, "iis", playerid, 0, "banni");
	}
	db_free_result(res);
	return banned;
}

// ------------------------------------------------------------
//  Gangs
// ------------------------------------------------------------
stock Gang_Load(playerid)
{
	g_GangOf[playerid] = 0;
	g_GangRank[playerid] = 0;
	if (g_AdminDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[128], f[12];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT gang, rank FROM gang_members WHERE name = '%s'", name);
	new DBResult:res = db_query(g_AdminDB, q);
	if (res == DBResult:0) return 0;
	if (db_num_rows(res) > 0)
	{
		db_get_field(res, 0, f, sizeof f); g_GangOf[playerid] = strval(f);
		db_get_field(res, 1, f, sizeof f); g_GangRank[playerid] = strval(f);
		if (g_GangOf[playerid] < 0 || g_GangOf[playerid] > GANG_COUNT) g_GangOf[playerid] = 0;
		if (g_GangRank[playerid] < 1 || g_GangRank[playerid] > GANG_RANK_MAX) g_GangRank[playerid] = 1;
	}
	db_free_result(res);
	return 1;
}

stock Gang_Set(playerid, gang, rank)
{
	new name[MAX_PLAYER_NAME + 1], q[160];
	GetPlayerName(playerid, name, sizeof name);
	if (gang <= 0) format(q, sizeof q, "DELETE FROM gang_members WHERE name = '%s'", name);
	else format(q, sizeof q, "INSERT OR REPLACE INTO gang_members (name, gang, rank) VALUES ('%s', %d, %d)", name, gang, rank);
	if (g_AdminDB != DB:0) db_free_result(db_query(g_AdminDB, q));
	g_GangOf[playerid] = gang > 0 ? gang : 0;
	g_GangRank[playerid] = gang > 0 ? rank : 0;
	return 1;
}

stock Gang_SavePts(gang)
{
	new q[96];
	format(q, sizeof q, "INSERT OR REPLACE INTO gang_state (id, pts) VALUES (%d, %d)", gang, g_GangPts[gang]);
	if (g_AdminDB != DB:0) db_free_result(db_query(g_AdminDB, q));
	return 1;
}

stock Gang_MemberCount(gang)
{
	new n = 0, q[80], f[12];
	format(q, sizeof q, "SELECT COUNT(*) FROM gang_members WHERE gang = %d", gang);
	new DBResult:res = db_query(g_AdminDB, q);
	if (res != DBResult:0)
	{
		if (db_num_rows(res) > 0) { db_get_field(res, 0, f, sizeof f); n = strval(f); }
		db_free_result(res);
	}
	return n;
}

// ------------------------------------------------------------
//  Donnees supplementaires du panneau
// ------------------------------------------------------------
stock AdmX_SendFac(playerid)
{
	new json[3900], part[200], n = 0, on[MAX_FACTIONS];
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (!IsPlayerConnected(i)) continue;
		new f = Fac_Get(i);
		if (f > 0 && f < MAX_FACTIONS) on[f]++;
	}
	json = "{\"x\":\"fac\",\"fac\":[";
	for (new f = 1; f < MAX_FACTIONS; f++)
	{
		if (!Fac_Exists(f)) continue;
		new nm[48];
		Admin_Clean(g_FxName[f], nm, sizeof nm);
		format(part, sizeof part, "%s{\"id\":%d,\"n\":\"%s\",\"t\":%d,\"c\":\"#%06x\",\"on\":%d,\"rk\":[", n ? (",") : (""), f, nm, g_FxType[f], (g_FxColor[f] >>> 8) & 0xFFFFFF, on[f]);
		if (strlen(json) + strlen(part) > 3700) break;
		strcat(json, part, sizeof json);
		for (new r = 1; r <= g_FxRankCount[f] && r <= MAX_FACTION_RANKS; r++)
		{
			new rn[32], rc[32];
			Fac_RankName(f, r, rn, sizeof rn);
			Admin_Clean(rn, rc, sizeof rc);
			format(part, sizeof part, "%s\"%s\"", r > 1 ? (",") : (""), rc);
			if (strlen(json) + strlen(part) > 3820) break;
			strcat(json, part, sizeof json);
		}
		strcat(json, "]}", sizeof json);
		n++;
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, ADMIN_DIALOG_UPDATE, DIALOG_STYLE_MSGBOX, "@admin", json, "OK", "");
}

stock AdmX_SendGang(playerid)
{
	new json[2000], part[160], on[GANG_COUNT + 1], n = 0;
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		if (IsPlayerConnected(i) && g_GangOf[i] >= 1 && g_GangOf[i] <= GANG_COUNT) on[g_GangOf[i]]++;
	format(json, sizeof json, "{\"x\":\"gang\",\"season\":%d,\"gangs\":[", g_GangSeason);
	for (new g = 1; g <= GANG_COUNT; g++)
	{
		format(part, sizeof part, "%s{\"id\":%d,\"n\":\"%s\",\"tag\":\"%s\",\"c\":\"%s\",\"pts\":%d,\"m\":%d,\"on\":%d,\"z\":0}",
			g > 1 ? (",") : (""), g, g_GangName[g], g_GangTag[g], g_GangColor[g], g_GangPts[g], Gang_MemberCount(g), on[g]);
		strcat(json, part, sizeof json);
	}
	strcat(json, "],\"online\":[", sizeof json);
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (!IsPlayerConnected(i) || g_GangOf[i] <= 0) continue;
		format(part, sizeof part, "%s[%d,%d,%d]", n ? (",") : (""), i, g_GangOf[i], g_GangRank[i]);
		if (strlen(json) + strlen(part) > 1960) break;
		strcat(json, part, sizeof json);
		n++;
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, ADMIN_DIALOG_UPDATE, DIALOG_STYLE_MSGBOX, "@admin", json, "OK", "");
}

stock AdmX_SendBans(playerid)
{
	new json[3000], part[220], n = 0, q[160], f[100];
	format(json, sizeof json, "{\"x\":\"ban\",\"now\":%d,\"bans\":[", AdmX_Now());
	if (g_AdminDB != DB:0)
	{
		format(q, sizeof q, "SELECT id, name, reason, by, until, at FROM bans WHERE until = 0 OR until > %d ORDER BY id DESC LIMIT %d", AdmX_Now(), ADMX_BAN_LIST);
		new DBResult:res = db_query(g_AdminDB, q);
		if (res != DBResult:0)
		{
			new rows = db_num_rows(res);
			for (new r = 0; r < rows; r++)
			{
				new id, nm[MAX_PLAYER_NAME + 1], reason[64], by[MAX_PLAYER_NAME + 1], until, at;
				db_get_field(res, 0, f, sizeof f); id = strval(f);
				db_get_field(res, 1, nm, sizeof nm);
				db_get_field(res, 2, f, sizeof f); Admin_Clean(f, reason, sizeof reason);
				db_get_field(res, 3, by, sizeof by);
				db_get_field(res, 4, f, sizeof f); until = strval(f);
				db_get_field(res, 5, f, sizeof f); at = strval(f);
				format(part, sizeof part, "%s[%d,\"%s\",\"%s\",\"%s\",%d,%d]", n ? (",") : (""), id, nm, reason, by, until, at);
				if (strlen(json) + strlen(part) > 2960) break;
				strcat(json, part, sizeof json);
				n++;
				db_next_row(res);
			}
			db_free_result(res);
		}
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, ADMIN_DIALOG_UPDATE, DIALOG_STYLE_MSGBOX, "@admin", json, "OK", "");
}

stock AdmX_SendLog(playerid)
{
	new json[3200], part[220], n = 0, f[110];
	format(json, sizeof json, "{\"x\":\"log\",\"now\":%d,\"log\":[", AdmX_Now());
	if (g_AdminDB != DB:0)
	{
		new q[96];
		format(q, sizeof q, "SELECT at, name, txt, ok, lvl FROM adminlog ORDER BY id DESC LIMIT %d", ADMX_LOG_LIST);
		new DBResult:res = db_query(g_AdminDB, q);
		if (res != DBResult:0)
		{
			new rows = db_num_rows(res);
			for (new r = 0; r < rows; r++)
			{
				new at, nm[MAX_PLAYER_NAME + 1], txt[100], ok, lv;
				db_get_field(res, 0, f, sizeof f); at = strval(f);
				db_get_field(res, 1, nm, sizeof nm);
				db_get_field(res, 2, f, sizeof f); Admin_Clean(f, txt, sizeof txt);
				db_get_field(res, 3, f, sizeof f); ok = strval(f);
				db_get_field(res, 4, f, sizeof f); lv = strval(f);
				format(part, sizeof part, "%s[%d,\"%s\",\"%s\",%d,%d]", n ? (",") : (""), at, nm, txt, ok, lv);
				if (strlen(json) + strlen(part) > 3150) break;
				strcat(json, part, sizeof json);
				n++;
				db_next_row(res);
			}
			db_free_result(res);
		}
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, ADMIN_DIALOG_UPDATE, DIALOG_STYLE_MSGBOX, "@admin", json, "OK", "");
}

stock AdmX_SendExtras(playerid)
{
	AdmX_SendFac(playerid);
	AdmX_SendGang(playerid);
	if (Admin_Level(playerid) >= 5) AdmX_SendBans(playerid);
	AdmX_SendLog(playerid);
	Cw_AdminSendWorld(playerid);   // [v15] onglet Monde
	return 1;
}

// ------------------------------------------------------------
//  Actions du panneau qui manquaient. Retourne 1 si l'action a ete traitee.
//  (le niveau requis est deja verifie par Adm_Need dans Admin_Action)
// ------------------------------------------------------------
stock AdmX_Action(playerid, const action[], const tid[], target, const arg[], msg[], msgsize, &ok)
{
	new name[MAX_PLAYER_NAME + 1], tname[MAX_PLAYER_NAME + 1], line[180];
	GetPlayerName(playerid, name, sizeof name);
	if (target != INVALID_PLAYER_ID) GetPlayerName(target, tname, sizeof tname);
	if (Cw_AdminAction(playerid, action, tid, target, arg, msg, msgsize, ok)) return 1;   // [v15]

	if (!strcmp(action, "setadmin", true) || !strcmp(action, "makeadmin", true))
	{
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else ok = Staff_SetLevel(playerid, target, strval(arg), msg, msgsize);
		return 1;
	}
	if (!strcmp(action, "screen", true))
	{
		if (!arg[0]) format(msg, msgsize, "Ecris un message.");
		else
		{
			format(line, sizeof line, "~w~%s", arg);
			GameTextForAll(line, 6000, 3);
			format(msg, msgsize, "Message affiche a l'ecran de tous les joueurs.");
			ok = 1;
		}
		return 1;
	}
	if (!strcmp(action, "kill", true))
	{
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (!Admin_CanPunish(playerid, target, msg, msgsize)) { }
		else
		{
			g_AdmGod[target] = 0;
			SetPlayerHealth(target, 0.0);
			format(msg, msgsize, "%s a ete tue.", tname);
			ok = 1;
		}
		return 1;
	}
	if (!strcmp(action, "resetwarns", true))
	{
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else { g_AdmWarns[target] = 0; format(msg, msgsize, "Avertissements de %s remis a 0.", tname); ok = 1; }
		return 1;
	}
	if (!strcmp(action, "setvw", true) || !strcmp(action, "setint", true))
	{
		new vw = !strcmp(action, "setvw", true), v = strval(arg);
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (!arg[0] || v < 0 || v > (vw ? 9999 : 255)) format(msg, msgsize, vw ? ("Monde : 0 a 9999.") : ("Interieur : 0 a 255."));
		else
		{
			if (vw) SetPlayerVirtualWorld(target, v); else SetPlayerInterior(target, v);
			format(msg, msgsize, "%s : %s %d.", tname, vw ? ("monde") : ("interieur"), v);
			ok = 1;
		}
		return 1;
	}
	if (!strcmp(action, "god", true))
	{
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else
		{
			g_AdmGod[target] = !g_AdmGod[target];
			SetPlayerHealth(target, g_AdmGod[target] ? 100000.0 : 100.0);
			SendClientMessage(target, ADMIN_COL_INFO, g_AdmGod[target] ? ("Mode invincible ACTIVE par le staff.") : ("Mode invincible coupe."));
			format(msg, msgsize, "%s : invincible %s.", tname, g_AdmGod[target] ? ("active") : ("coupe"));
			ok = 1;
		}
		return 1;
	}
	if (!strcmp(action, "jetpack", true))
	{
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (GetPlayerState(target) != PLAYER_STATE_ONFOOT) format(msg, msgsize, "Le joueur doit etre a pied.");
		else { SetPlayerSpecialAction(target, SPECIAL_ACTION_USEJETPACK); format(msg, msgsize, "Jetpack donne a %s.", tname); ok = 1; }
		return 1;
	}
	if (!strcmp(action, "tpxyz", true))
	{
		new idx = 0, a[16], b[16], c[16];
		Bank_NextToken(arg, idx, a, sizeof a);
		Bank_NextToken(arg, idx, b, sizeof b);
		Bank_NextToken(arg, idx, c, sizeof c);
		if (!a[0] || !b[0] || !c[0]) format(msg, msgsize, "Coordonnees : X Y Z (ex : 1481 -1771 18).");
		else
		{
			new Float:x = floatstr(a), Float:y = floatstr(b), Float:z = floatstr(c);
			if (x < -3500.0 || x > 3500.0 || y < -3500.0 || y > 3500.0 || z < -100.0 || z > 2000.0) format(msg, msgsize, "Coordonnees hors de la carte.");
			else { Admin_Teleport(playerid, x, y, z, 0, 0); format(msg, msgsize, "Teleporte en %.0f %.0f %.0f.", x, y, z); ok = 1; }
		}
		return 1;
	}
	if (!strcmp(action, "freezeall", true) || !strcmp(action, "unfreezeall", true))
	{
		new fr = !strcmp(action, "freezeall", true), n = 0;
		for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		{
			if (!IsPlayerConnected(i) || i == playerid || Admin_Level(i) >= 1) continue;
			TogglePlayerControllable(i, fr ? 0 : 1);
			n++;
		}
		format(line, sizeof line, "[ADMIN] %s a %s tous les joueurs.", name, fr ? ("gele") : ("degele"));
		SendClientMessageToAll(ADMIN_COL_ANN, line);
		format(msg, msgsize, "%d joueur(s) %s (le staff n'est pas touche).", n, fr ? ("geles") : ("degeles"));
		ok = 1;
		return 1;
	}

	// ---------------- Bannissements ----------------
	if (!strcmp(action, "ban", true))
	{
		new idx = 0, d[8];
		Bank_NextToken(arg, idx, d, sizeof d);
		new days = strval(d);
		while (arg[idx] == ' ') idx++;
		new reason[64];
		format(reason, sizeof reason, "%s", arg[idx]);
		if (d[0] && (d[0] < '0' || d[0] > '9')) { format(reason, sizeof reason, "%s", arg); days = 0; }
		if (!reason[0]) format(reason, sizeof reason, "Reglement");
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (!Admin_CanPunish(playerid, target, msg, msgsize)) { }
		else if (days < 0 || days > 3650) format(msg, msgsize, "Duree : 0 (definitif) a 3650 jours.");
		else
		{
			new ip[20];
			GetPlayerIp(target, ip, sizeof ip);
			AdmX_AddBan(tname, ip, reason, name, days);
			if (days) format(line, sizeof line, "[ADMIN] %s a ete banni %d jour(s) par %s (%s).", tname, days, name, reason);
			else format(line, sizeof line, "[ADMIN] %s a ete banni definitivement par %s (%s).", tname, name, reason);
			SendClientMessageToAll(ADMIN_COL_ERR, line);
			SetTimerEx("Admin_DelayedKick", 500, false, "iis", target, 0, reason);
			format(msg, msgsize, "%s banni.", tname);
			ok = 1;
			AdmX_SendBans(playerid);
		}
		return 1;
	}
	if (!strcmp(action, "banoff", true))
	{
		new idx = 0, who[MAX_PLAYER_NAME + 1], d[8], reason[64];
		Bank_NextToken(arg, idx, who, sizeof who);
		Bank_NextToken(arg, idx, d, sizeof d);
		while (arg[idx] == ' ') idx++;
		format(reason, sizeof reason, "%s", arg[idx]);
		if (!reason[0]) format(reason, sizeof reason, "Reglement");
		new days = strval(d), valid = strlen(who) >= 3;
		for (new i = 0; who[i] != 0; i++)
		{
			new c = who[i];
			if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '[' || c == ']')) valid = 0;
		}
		if (!valid) format(msg, msgsize, "Format : Prenom_Nom jours raison.");
		else if (!strcmp(who, ADMIN_OWNER_NAME, true)) format(msg, msgsize, "Ce joueur est intouchable.");
		else if (days < 0 || days > 3650) format(msg, msgsize, "Duree : 0 (definitif) a 3650 jours.");
		else
		{
			AdmX_AddBan(who, "", reason, name, days);
			for (new i = 0, m = GetMaxPlayers(); i < m; i++)
			{
				new pn[MAX_PLAYER_NAME + 1];
				if (!IsPlayerConnected(i)) continue;
				GetPlayerName(i, pn, sizeof pn);
				if (!strcmp(pn, who, true)) SetTimerEx("Admin_DelayedKick", 500, false, "iis", i, 0, reason);
			}
			format(msg, msgsize, "%s banni hors ligne (%s).", who, days ? ("temporaire") : ("definitif"));
			ok = 1;
			AdmX_SendBans(playerid);
		}
		return 1;
	}
	if (!strcmp(action, "unban", true))
	{
		new id = strval(tid), q[80];
		if (id <= 0 || g_AdminDB == DB:0) format(msg, msgsize, "Bannissement introuvable.");
		else
		{
			format(q, sizeof q, "DELETE FROM bans WHERE id = %d", id);
			db_free_result(db_query(g_AdminDB, q));
			format(msg, msgsize, "Bannissement #%d leve.", id);
			ok = 1;
			AdmX_SendBans(playerid);
		}
		return 1;
	}

	// ---------------- Gangs ----------------
	if (!strcmp(action, "setgang", true))
	{
		new idx = 0, g[8], r[8];
		Bank_NextToken(arg, idx, g, sizeof g);
		Bank_NextToken(arg, idx, r, sizeof r);
		new gang = strval(g), rank = r[0] ? strval(r) : 1;
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (!g[0] || gang < 0 || gang > GANG_COUNT) format(msg, msgsize, "Gang : 0 (aucun) a 4.");
		else if (rank < 1 || rank > GANG_RANK_MAX) format(msg, msgsize, "Grade : 1 a 4.");
		else if (!g_AuthLogged[target]) format(msg, msgsize, "Ce joueur n'est pas encore connecte.");
		else
		{
			Gang_Set(target, gang, rank);
			if (gang)
			{
				format(line, sizeof line, "Tu fais maintenant partie des %s (%s).", g_GangName[gang], g_GangRankName[rank]);
				SendClientMessage(target, ADMIN_COL_OK, line);
				format(msg, msgsize, "%s : %s (%s).", tname, g_GangName[gang], g_GangRankName[rank]);
			}
			else
			{
				SendClientMessage(target, ADMIN_COL_INFO, "Tu ne fais plus partie d'un gang.");
				format(msg, msgsize, "%s retire de son gang.", tname);
			}
			ok = 1;
			AdmX_SendGang(playerid);
		}
		return 1;
	}
	if (!strcmp(action, "setgangrank", true))
	{
		new rank = strval(arg);
		if (target == INVALID_PLAYER_ID) format(msg, msgsize, "Joueur introuvable.");
		else if (g_GangOf[target] <= 0) format(msg, msgsize, "Ce joueur n'est dans aucun gang.");
		else if (rank < 1 || rank > GANG_RANK_MAX) format(msg, msgsize, "Grade : 1 a 4.");
		else
		{
			Gang_Set(target, g_GangOf[target], rank);
			format(line, sizeof line, "Ton grade de gang est maintenant : %s.", g_GangRankName[rank]);
			SendClientMessage(target, ADMIN_COL_OK, line);
			format(msg, msgsize, "%s : %s.", tname, g_GangRankName[rank]);
			ok = 1;
			AdmX_SendGang(playerid);
		}
		return 1;
	}
	if (!strcmp(action, "gangpts", true))
	{
		new gang = strval(tid), delta = strval(arg);
		if (gang < 1 || gang > GANG_COUNT) format(msg, msgsize, "Gang introuvable.");
		else if (!arg[0] || delta < -1000000 || delta > 1000000) format(msg, msgsize, "Points invalides.");
		else
		{
			g_GangPts[gang] += delta;
			if (g_GangPts[gang] < 0) g_GangPts[gang] = 0;
			Gang_SavePts(gang);
			format(msg, msgsize, "%s : %d points.", g_GangName[gang], g_GangPts[gang]);
			ok = 1;
			AdmX_SendGang(playerid);
		}
		return 1;
	}
	if (!strcmp(action, "gangseason", true))
	{
		new best = 1;
		for (new g = 2; g <= GANG_COUNT; g++) if (g_GangPts[g] > g_GangPts[best]) best = g;
		format(line, sizeof line, "[GANGS] Fin de la saison %d : les %s gagnent avec %d points ! Nouvelle saison.", g_GangSeason, g_GangName[best], g_GangPts[best]);
		SendClientMessageToAll(0xFFCC33FF, line);
		for (new g = 1; g <= GANG_COUNT; g++) { g_GangPts[g] = 0; Gang_SavePts(g); }
		g_GangSeason++;
		new q[96];
		format(q, sizeof q, "INSERT OR REPLACE INTO meta (k, v) VALUES ('gang_season', %d)", g_GangSeason);
		if (g_AdminDB != DB:0) db_free_result(db_query(g_AdminDB, q));
		format(msg, msgsize, "Saison terminee : %s vainqueurs. Saison %d lancee.", g_GangName[best], g_GangSeason);
		ok = 1;
		AdmX_SendGang(playerid);
		return 1;
	}

	return 0;
}

stock AdmX_OnInit()
{
	return AdmX_InitDB();
}

stock AdmX_OnConnect(playerid)
{
	g_AdmGod[playerid] = 0;
	Gang_Load(playerid);
	AdmX_CheckBan(playerid);
	return 1;
}

stock AdmX_OnDisconnect(playerid)
{
	g_AdmGod[playerid] = 0;
	g_GangOf[playerid] = 0;
	g_GangRank[playerid] = 0;
	return 1;
}

// Garde l'invincibilite apres un respawn
stock AdmX_OnSpawn(playerid)
{
	if (g_AdmGod[playerid]) SetPlayerHealth(playerid, 100000.0);
	return 1;
}

// ------------------------------------------------------------
//  Commandes listees dans l'onglet "Commandes" du panneau
// ------------------------------------------------------------
stock AdmX_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/debloquer", true))
	{
		if (!g_AuthLogged[playerid]) return 1;
		if (g_PolJailUntil[playerid] > 0) return SendClientMessage(playerid, ADMIN_COL_ERR, "Tu es en prison : impossible de te debloquer.");
		TogglePlayerControllable(playerid, 1);
		ClearAnimations(playerid);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		SetCameraBehindPlayer(playerid);
		if (IsPlayerInAnyVehicle(playerid)) { new Float:x, Float:y, Float:z; GetPlayerPos(playerid, x, y, z); SetPlayerPos(playerid, x, y, z + 1.5); }
		return SendClientMessage(playerid, ADMIN_COL_OK, "Personnage debloque. Si ca continue, ouvre un report (/report).");
	}
	if (!strcmp(cmdtext, "/vocal", true))
	{
		SendClientMessage(playerid, ADMIN_COL_INFO, "Vocal de proximite : maintiens le bouton VOCAL du HUD pour parler (double appui = verrouiller le micro).");
		return SendClientMessage(playerid, ADMIN_COL_INFO, "Les joueurs proches t'entendent ; plus ils sont loin, moins ils t'entendent.");
	}
	if (!strcmp(cmdtext, "/wanted", true))
	{
		if (Admin_Level(playerid) < 1 && !Fac_IsLaw(playerid)) return 0;
		new line[96], name[MAX_PLAYER_NAME + 1], n = 0;
		SendClientMessage(playerid, ADMIN_COL_INFO, "Avis de recherche :");
		for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		{
			if (!IsPlayerConnected(i) || GetPlayerWantedLevel(i) <= 0) continue;
			GetPlayerName(i, name, sizeof name);
			format(line, sizeof line, "  %s (%d) : %d etoile(s)", name, i, GetPlayerWantedLevel(i));
			SendClientMessage(playerid, 0xFFFFFFFF, line);
			n++;
		}
		if (!n) SendClientMessage(playerid, 0xFFFFFFFF, "  Personne n'est recherche.");
		return 1;
	}
	if (!strcmp(cmdtext, "/leveravis", true, 10) && (cmdtext[10] == 0 || cmdtext[10] == ' '))
	{
		if (Admin_Level(playerid) < 1) return 0;
		new target = Admin_Target(cmdtext[cmdtext[10] ? 11 : 10]), name[MAX_PLAYER_NAME + 1], line[96];
		if (target == INVALID_PLAYER_ID) return SendClientMessage(playerid, ADMIN_COL_ERR, "Usage : /leveravis <id joueur>");
		SetPlayerWantedLevel(target, 0);
		GetPlayerName(target, name, sizeof name);
		SendClientMessage(target, ADMIN_COL_OK, "Ton avis de recherche a ete leve.");
		format(line, sizeof line, "Avis de recherche de %s leve.", name);
		return SendClientMessage(playerid, ADMIN_COL_OK, line);
	}
	if (!strcmp(cmdtext, "/setgang ", true, 9))
	{
		if (Admin_Level(playerid) < 4) return 0;
		new idx = 9, who[24], g[8], r[8], target = INVALID_PLAYER_ID;
		Bank_NextToken(cmdtext, idx, who, sizeof who);
		Bank_NextToken(cmdtext, idx, g, sizeof g);
		Bank_NextToken(cmdtext, idx, r, sizeof r);
		target = Admin_Target(who);
		if (target == INVALID_PLAYER_ID)
		{
			new pn[MAX_PLAYER_NAME + 1];
			for (new i = 0, m = GetMaxPlayers(); i < m; i++)
			{
				if (!IsPlayerConnected(i)) continue;
				GetPlayerName(i, pn, sizeof pn);
				if (!strcmp(pn, who, true)) { target = i; break; }
			}
		}
		new msg[144], ok = 0, arg[24], tid[8];
		format(arg, sizeof arg, "%s %s", g, r[0] ? r : ("1"));
		format(tid, sizeof tid, "%d", target);
		if (!g[0]) return SendClientMessage(playerid, ADMIN_COL_ERR, "Usage : /setgang <id ou pseudo> <gang 0-4> [grade 1-4]");
		AdmX_Action(playerid, "setgang", tid, target, arg, msg, sizeof msg, ok);
		AdmX_Log(playerid, cmdtext[1], ok, Admin_Level(playerid));
		return SendClientMessage(playerid, ok ? ADMIN_COL_OK : ADMIN_COL_ERR, msg);
	}
	return 0;
}

// ============================================================
//  PECHE  (page assets/fish/index.html, "@fish" 9740 ouvrir / 9741 mise a jour / 9742 fermer)
// ------------------------------------------------------------
//  Pontons crees par le staff : /creerpeche (niveau 6), /supprpeche <id>, /pontons
//  Joueur : main "Pecher" sur un ponton (ou /peche) -> page : acheter une canne, lancer,
//           ferrer au bon moment (jauge), glaciere, revente.
//  client -> serveur : /fishact refresh | buyrod | cast | cancel | sell | hook <precision 0-100> | close
//  Le serveur verifie le temps d'attente : ferrer avant la touche fait fuir le poisson.
//  Donnees : crestwood_garage.db (tables fishspots, fishers)
// ============================================================

#define FISH_DIALOG_OPEN      9740
#define FISH_DIALOG_UPDATE    9741
#define FISH_DIALOG_CLOSE     9742
#define FISH_MAX_SPOTS        16
#define FISH_COOLER_MAX       20
#define FISH_ROD_PRICE        500
#define FISH_RANGE            4.0
#define INTERACT_FISH         11          // cle 110

// meme ordre que KINDS dans assets/fish/fish.js : prix FCFA / kg, rarete, poids mini / maxi (g)
new const g_FishPrice[9]  = { 60, 90, 110, 130, 180, 220, 300, 350, 480 };
new const g_FishRare[9]   = { 0, 0, 0, 1, 1, 1, 2, 2, 3 };
new const g_FishMinG[9]   = { 100, 300, 400, 1000, 1000, 800, 3000, 5000, 15000 };
new const g_FishMaxG[9]   = { 400, 1200, 2000, 6000, 5000, 4000, 25000, 40000, 60000 };

new g_FishSpotCount;
new g_FishSpotId[FISH_MAX_SPOTS];
new Float:g_FishSpot[FISH_MAX_SPOTS][3];

new g_FishOpen[MAX_PLAYERS];
new g_FishLoaded[MAX_PLAYERS];
new g_FishRod[MAX_PLAYERS];
new g_FishKg[MAX_PLAYERS];               // total peche, en grammes
new g_FishBestK[MAX_PLAYERS];
new g_FishBestG[MAX_PLAYERS];
new g_FishCoolK[MAX_PLAYERS][FISH_COOLER_MAX];
new g_FishCoolG[MAX_PLAYERS][FISH_COOLER_MAX];
new g_FishCoolN[MAX_PLAYERS];
new g_FishCastAt[MAX_PLAYERS];            // 0 = pas de ligne a l'eau
new g_FishWait[MAX_PLAYERS];

stock Fish_InitDB()
{
	if (g_GarDB == DB:0) return 0;
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS fishspots (id INTEGER PRIMARY KEY AUTOINCREMENT, x REAL, y REAL, z REAL)"));
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS fishers (name TEXT PRIMARY KEY COLLATE NOCASE, rod INTEGER DEFAULT 0, kg INTEGER DEFAULT 0, bestk INTEGER DEFAULT -1, bestg INTEGER DEFAULT 0, cooler TEXT DEFAULT '')"));
	return Fish_LoadSpots();
}

stock Fish_LoadSpots()
{
	g_FishSpotCount = 0;
	if (g_GarDB == DB:0) return 0;
	new f[24], DBResult:res = db_query(g_GarDB, "SELECT id, x, y, z FROM fishspots ORDER BY id");
	if (res == DBResult:0) return 0;
	new rows = db_num_rows(res);
	for (new r = 0; r < rows && g_FishSpotCount < FISH_MAX_SPOTS; r++)
	{
		new i = g_FishSpotCount;
		db_get_field(res, 0, f, sizeof f); g_FishSpotId[i] = strval(f);
		for (new k = 0; k < 3; k++) { db_get_field(res, 1 + k, f, sizeof f); g_FishSpot[i][k] = floatstr(f); }
		g_FishSpotCount++;
		db_next_row(res);
	}
	db_free_result(res);
	return 1;
}

stock Fish_NearSpot(playerid)
{
	if (GetPlayerVirtualWorld(playerid) != 0) return -1;
	for (new i = 0; i < g_FishSpotCount; i++)
		if (IsPlayerInRangeOfPoint(playerid, FISH_RANGE, g_FishSpot[i][0], g_FishSpot[i][1], g_FishSpot[i][2])) return i;
	return -1;
}

stock Fish_Load(playerid)
{
	g_FishLoaded[playerid] = 1;
	g_FishRod[playerid] = 0; g_FishKg[playerid] = 0; g_FishBestK[playerid] = -1; g_FishBestG[playerid] = 0; g_FishCoolN[playerid] = 0;
	if (g_GarDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[140], f[24], cool[200];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT rod, kg, bestk, bestg, cooler FROM fishers WHERE name = '%s'", name);
	new DBResult:res = db_query(g_GarDB, q);
	if (res == DBResult:0) return 0;
	if (db_num_rows(res) > 0)
	{
		db_get_field(res, 0, f, sizeof f); g_FishRod[playerid] = strval(f);
		db_get_field(res, 1, f, sizeof f); g_FishKg[playerid] = strval(f);
		db_get_field(res, 2, f, sizeof f); g_FishBestK[playerid] = strval(f);
		db_get_field(res, 3, f, sizeof f); g_FishBestG[playerid] = strval(f);
		db_get_field(res, 4, cool, sizeof cool);
		// "k:g k:g ..."
		new idx = 0, tok[16];
		while (g_FishCoolN[playerid] < FISH_COOLER_MAX && Bank_NextToken(cool, idx, tok, sizeof tok))
		{
			new c = strfind(tok, ":");
			if (c <= 0) continue;
			tok[c] = 0;
			new k = strval(tok), g = strval(tok[c + 1]);
			if (k < 0 || k > 8 || g <= 0) continue;
			g_FishCoolK[playerid][g_FishCoolN[playerid]] = k;
			g_FishCoolG[playerid][g_FishCoolN[playerid]] = g;
			g_FishCoolN[playerid]++;
		}
	}
	db_free_result(res);
	return 1;
}

stock Fish_Save(playerid)
{
	if (g_GarDB == DB:0 || !g_FishLoaded[playerid]) return 0;
	new name[MAX_PLAYER_NAME + 1], q[400], cool[220], part[16];
	GetPlayerName(playerid, name, sizeof name);
	cool[0] = 0;
	for (new i = 0; i < g_FishCoolN[playerid]; i++)
	{
		format(part, sizeof part, "%s%d:%d", i ? (" ") : (""), g_FishCoolK[playerid][i], g_FishCoolG[playerid][i]);
		strcat(cool, part, sizeof cool);
	}
	format(q, sizeof q, "INSERT OR REPLACE INTO fishers (name, rod, kg, bestk, bestg, cooler) VALUES ('%s', %d, %d, %d, %d, '%s')",
		name, g_FishRod[playerid], g_FishKg[playerid], g_FishBestK[playerid], g_FishBestG[playerid], cool);
	db_free_result(db_query(g_GarDB, q));
	return 1;
}

stock Fish_CoolerValue(playerid)
{
	new v = 0;
	for (new i = 0; i < g_FishCoolN[playerid]; i++) v += g_FishCoolG[playerid][i] * g_FishPrice[g_FishCoolK[playerid][i]] / 1000;
	return v;
}

// caughtK = -1 : pas de prise a afficher
stock Fish_Send(playerid, dialogid, ok, const msg[], caughtK = -1, caughtG = 0)
{
	if (!g_FishLoaded[playerid]) Fish_Load(playerid);
	new json[1400], part[48];
	format(json, sizeof json, "{\"rod\":%d,\"rodPrice\":%d,\"cash\":%d,\"state\":\"%s\",\"wait\":%d,\"max\":%d,\"kg\":%d,\"best\":[%d,%d],\"spot\":%d,\"ok\":%d,\"msg\":\"%s\",\"value\":%d,\"cooler\":[",
		g_FishRod[playerid], FISH_ROD_PRICE, GetPlayerMoney(playerid), g_FishCastAt[playerid] ? ("cast") : ("idle"),
		g_FishCastAt[playerid] ? g_FishWait[playerid] : 0, FISH_COOLER_MAX, g_FishKg[playerid], g_FishBestK[playerid], g_FishBestG[playerid],
		Fish_NearSpot(playerid) >= 0 ? 1 : 0, ok, msg, Fish_CoolerValue(playerid));
	for (new i = 0; i < g_FishCoolN[playerid]; i++)
	{
		format(part, sizeof part, "%s[%d,%d]", i ? (",") : (""), g_FishCoolK[playerid][i], g_FishCoolG[playerid][i]);
		strcat(json, part, sizeof json);
	}
	if (caughtK >= 0) format(part, sizeof part, "],\"caught\":[%d,%d]}", caughtK, caughtG);
	else format(part, sizeof part, "],\"caught\":0}");
	strcat(json, part, sizeof json);
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@fish", json, "OK", "");
}

stock Fish_Open(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	if (Fish_NearSpot(playerid) < 0) return SendClientMessage(playerid, 0xFF4444FF, "Peche : va sur un ponton de peche.");
	g_FishOpen[playerid] = 1;
	g_FishCastAt[playerid] = 0;
	return Fish_Send(playerid, FISH_DIALOG_OPEN, 1, "");
}

stock Fish_Action(playerid, const params[])
{
	new idx = 0, act[12], arg[12];
	Bank_NextToken(params, idx, act, sizeof act);
	Bank_NextToken(params, idx, arg, sizeof arg);
	if (!strcmp(act, "close", true)) { g_FishOpen[playerid] = 0; g_FishCastAt[playerid] = 0; return 1; }
	if (!g_FishOpen[playerid]) return 1;
	if (!g_FishLoaded[playerid]) Fish_Load(playerid);

	if (!strcmp(act, "refresh", true)) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, "");
	if (!strcmp(act, "buyrod", true))
	{
		if (g_FishRod[playerid]) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Tu as deja une canne.");
		if (GetPlayerMoney(playerid) < FISH_ROD_PRICE) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Pas assez d'argent liquide.");
		GivePlayerMoney(playerid, -FISH_ROD_PRICE);
		g_FishRod[playerid] = 1;
		Fish_Save(playerid);
		return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, "Canne a peche achetee. Bonne peche !");
	}
	if (!strcmp(act, "cast", true))
	{
		if (!g_FishRod[playerid]) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Il te faut une canne.");
		if (Fish_NearSpot(playerid) < 0) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Rapproche-toi du ponton.");
		if (g_FishCoolN[playerid] >= FISH_COOLER_MAX) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Ta glaciere est pleine : vends tes poissons.");
		g_FishWait[playerid] = 2500 + random(5000);
		g_FishCastAt[playerid] = GetTickCount();
		if (!g_FishCastAt[playerid]) g_FishCastAt[playerid] = 1;
		ApplyAnimation(playerid, "SWORD", "sword_block", 4.1, 0, 0, 0, 1, 0, 1);
		return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, "");
	}
	if (!strcmp(act, "cancel", true))
	{
		g_FishCastAt[playerid] = 0;
		ClearAnimations(playerid);
		return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, "Ligne remontee.");
	}
	if (!strcmp(act, "hook", true))
	{
		if (!g_FishCastAt[playerid]) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Lance d'abord ta ligne.");
		new elapsed = GetTickCount() - g_FishCastAt[playerid], q = strval(arg);
		g_FishCastAt[playerid] = 0;
		ClearAnimations(playerid);
		if (elapsed + 300 < g_FishWait[playerid]) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Trop tot ! Le poisson a fui.");
		if (elapsed > g_FishWait[playerid] + 6000) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Trop tard, le poisson est reparti.");
		if (q < 30) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Rate ! Le poisson s'est decroche.");
		if (q > 100) q = 100;
		// plus le ferrage est precis, plus le poisson peut etre rare
		new roll = random(100) + (q - 50) / 2, tier = 0;
		if (roll >= 105) tier = 3; else if (roll >= 82) tier = 2; else if (roll >= 52) tier = 1;
		new cand[9], nc = 0;
		for (new k = 0; k < 9; k++) if (g_FishRare[k] == tier) cand[nc++] = k;
		new k = cand[random(nc)];
		new g = g_FishMinG[k] + random(g_FishMaxG[k] - g_FishMinG[k] + 1);
		g = g * (80 + q / 5) / 100;
		if (g < g_FishMinG[k]) g = g_FishMinG[k];
		new n = g_FishCoolN[playerid];
		g_FishCoolK[playerid][n] = k;
		g_FishCoolG[playerid][n] = g;
		g_FishCoolN[playerid]++;
		g_FishKg[playerid] += g;
		if (g_FishBestK[playerid] < 0 || g * g_FishPrice[k] > g_FishBestG[playerid] * g_FishPrice[g_FishBestK[playerid]]) { g_FishBestK[playerid] = k; g_FishBestG[playerid] = g; }
		Fish_Save(playerid);
		return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, tier >= 2 ? ("Belle prise !") : ("Poisson attrape."), k, g);
	}
	if (!strcmp(act, "sell", true))
	{
		new v = Fish_CoolerValue(playerid), msg[64];
		if (!g_FishCoolN[playerid]) return Fish_Send(playerid, FISH_DIALOG_UPDATE, 0, "Ta glaciere est vide.");
		GivePlayerMoney(playerid, v);
		g_FishCoolN[playerid] = 0;
		Fish_Save(playerid);
		format(msg, sizeof msg, "Poissons vendus : +%d FCFA.", v);
		return Fish_Send(playerid, FISH_DIALOG_UPDATE, 1, msg);
	}
	return 1;
}

stock Fish_InteractKey(playerid)
{
	if (!g_AuthLogged[playerid] || g_FishOpen[playerid]) return 0;
	return Fish_NearSpot(playerid) >= 0 ? INTERACT_FISH * 10 : 0;
}

stock Fish_PushMarks()
{
	for (new i = 0; i < g_FishSpotCount; i++) Mk_Add(10, g_FishSpot[i][0], g_FishSpot[i][1], g_FishSpot[i][2] - 0.95);
	return 1;
}

stock Fish_AppendMarks(json[], size, &n)
{
	new part[96];
	for (new i = 0; i < g_FishSpotCount; i++, n++)
	{
		format(part, sizeof part, "%s{\"t\":3,\"x\":%.2f,\"y\":%.2f,\"z\":%.2f,\"n\":\"Peche\"}", n ? (",") : (""), g_FishSpot[i][0], g_FishSpot[i][1], g_FishSpot[i][2] - 0.95);
		if (strlen(json) + strlen(part) > size - 8) return 0;
		strcat(json, part, size);
	}
	return 1;
}

stock Fish_OnConnect(playerid)
{
	g_FishOpen[playerid] = 0; g_FishLoaded[playerid] = 0; g_FishCastAt[playerid] = 0; g_FishCoolN[playerid] = 0;
	return 1;
}

stock Fish_OnDisconnect(playerid)
{
	if (g_FishLoaded[playerid]) Fish_Save(playerid);
	g_FishLoaded[playerid] = 0;
	g_FishOpen[playerid] = 0;
	return 1;
}

stock Fish_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/fishact ", true, 9)) { Fish_Action(playerid, cmdtext[9]); return 1; }
	if (!strcmp(cmdtext, "/peche", true)) { Fish_Open(playerid); return 1; }
	if (!strcmp(cmdtext, "/creerpeche", true))
	{
		if (Admin_Level(playerid) < 6) return 0;
		if (g_FishSpotCount >= FISH_MAX_SPOTS) return SendClientMessage(playerid, 0xFF4444FF, "Peche : nombre maximum de pontons atteint.");
		new Float:x, Float:y, Float:z, q[160];
		GetPlayerPos(playerid, x, y, z);
		format(q, sizeof q, "INSERT INTO fishspots (x, y, z) VALUES (%.3f, %.3f, %.3f)", x, y, z);
		db_free_result(db_query(g_GarDB, q));
		Fish_LoadSpots();
		Marks_SendAll();
		format(q, sizeof q, "Ponton de peche #%d cree a ta position.", g_FishSpotCount ? g_FishSpotId[g_FishSpotCount - 1] : 0);
		return SendClientMessage(playerid, 0x33CC33FF, q);
	}
	if (!strcmp(cmdtext, "/supprpeche ", true, 12))
	{
		if (Admin_Level(playerid) < 6) return 0;
		new q[64];
		format(q, sizeof q, "DELETE FROM fishspots WHERE id = %d", strval(cmdtext[12]));
		db_free_result(db_query(g_GarDB, q));
		Fish_LoadSpots();
		Marks_SendAll();
		return SendClientMessage(playerid, 0x33CC33FF, "Ponton supprime (s'il existait).");
	}
	if (!strcmp(cmdtext, "/pontons", true))
	{
		if (Admin_Level(playerid) < 4) return 0;
		new line[80];
		if (!g_FishSpotCount) SendClientMessage(playerid, 0x33CCFFFF, "Aucun ponton. /creerpeche pour en creer un.");
		for (new i = 0; i < g_FishSpotCount; i++)
		{
			format(line, sizeof line, "  #%d  (%.0f, %.0f, %.0f)", g_FishSpotId[i], g_FishSpot[i][0], g_FishSpot[i][1], g_FishSpot[i][2]);
			SendClientMessage(playerid, 0xFFFFFFFF, line);
		}
		return 1;
	}
	return 0;
}

// ============================================================
//  IMMOBILIER : maisons des joueurs
//  (page assets/house/index.html, "@house" 9730 ouvrir / 9731 mise a jour / 9732 fermer)
// ------------------------------------------------------------
//  Staff : /creermaison <type 1-5> <prix>   (porte a ta position, niveau 6)
//          /allermaison <id> (niveau 4)   /supprmaison <id> (niveau 6)   /maisons
//  Joueur : main "Maison" devant la porte (ou /maison) -> acheter (compte bancaire), entrer / visiter,
//           fermer a cle, coffre-fort (a l'interieur), vendre a l'Etat (60 % + coffre), GPS.
//           A l'interieur, la main "Sortir" pres de la porte ramene dehors.
//  client -> serveur : /houseact refresh | buy | sell | lock | enter | view <door|list> | gps <id> | deposit <n> | withdraw <n> | close
//  Chaque maison a son monde virtuel (1000 + id) : les interieurs ne se melangent pas.
//  Donnees : crestwood_garage.db (table houses)
// ============================================================

#define HOUSE_DIALOG_OPEN     9730
#define HOUSE_DIALOG_UPDATE   9731
#define HOUSE_DIALOG_CLOSE    9732
#define HOUSE_MAX             60
#define HOUSE_MAX_OWNED       2
#define HOUSE_SELL_PCT        60
#define HOUSE_RANGE           2.2
#define HOUSE_VW_BASE         1000
#define INTERACT_HOUSE        12          // cle 120 (porte) / 121 (sortie, a l'interieur)

// interieur par type (1 Studio ... 5 Villa) : interieur, x, y, z, angle
new const g_HouseIntId[6] = { 0, 1, 5, 2, 15, 5 };
new const Float:g_HouseInt[6][4] =
{
	{ 0.0, 0.0, 0.0, 0.0 },
	{ 223.0430, 1287.2599, 1082.1410, 0.0 },     // studio
	{ 2233.6919, -1112.8107, 1050.8828, 0.0 },   // appartement
	{ 2468.8411, -1698.2754, 1013.5078, 90.0 },  // maison
	{ 295.0400, 1472.2600, 1080.2578, 0.0 },     // grande maison
	{ 1260.6603, -785.4005, 1091.9063, 270.0 }   // villa
};

new g_HouseCount;
new g_HouseId[HOUSE_MAX];
new g_HouseType[HOUSE_MAX];
new g_HousePrice[HOUSE_MAX];
new g_HouseOwner[HOUSE_MAX][MAX_PLAYER_NAME + 1];
new g_HouseLock[HOUSE_MAX];
new g_HouseSafe[HOUSE_MAX];
new Float:g_HouseDoor[HOUSE_MAX][4];
new g_HouseOpen[MAX_PLAYERS];
new g_HouseView[MAX_PLAYERS];             // 0 porte, 1 liste
// [v15] encheres (include/Cw15.inc) : offre actuelle, meilleur encherisseur, fin (timestamp)
new g_HouseAucBid[HOUSE_MAX];
new g_HouseAucBidder[HOUSE_MAX][MAX_PLAYER_NAME + 1];
new g_HouseAucEnd[HOUSE_MAX];

stock House_InitDB()
{
	if (g_GarDB == DB:0) return 0;
	db_free_result(db_query(g_GarDB, "CREATE TABLE IF NOT EXISTS houses (id INTEGER PRIMARY KEY AUTOINCREMENT, type INTEGER, price INTEGER, owner TEXT COLLATE NOCASE DEFAULT '', locked INTEGER DEFAULT 1, safe INTEGER DEFAULT 0, x REAL, y REAL, z REAL, a REAL)"));
	return House_Load();
}

stock House_Load()
{
	g_HouseCount = 0;
	if (g_GarDB == DB:0) return 0;
	new f[32], DBResult:res = db_query(g_GarDB, "SELECT id, type, price, owner, locked, safe, x, y, z, a FROM houses ORDER BY id");
	if (res == DBResult:0) return 0;
	new rows = db_num_rows(res);
	for (new r = 0; r < rows && g_HouseCount < HOUSE_MAX; r++)
	{
		new i = g_HouseCount;
		db_get_field(res, 0, f, sizeof f); g_HouseId[i] = strval(f);
		db_get_field(res, 1, f, sizeof f); g_HouseType[i] = strval(f);
		db_get_field(res, 2, f, sizeof f); g_HousePrice[i] = strval(f);
		db_get_field(res, 3, g_HouseOwner[i], MAX_PLAYER_NAME + 1);
		db_get_field(res, 4, f, sizeof f); g_HouseLock[i] = strval(f);
		db_get_field(res, 5, f, sizeof f); g_HouseSafe[i] = strval(f);
		for (new k = 0; k < 4; k++) { db_get_field(res, 6 + k, f, sizeof f); g_HouseDoor[i][k] = floatstr(f); }
		if (g_HouseType[i] < 1 || g_HouseType[i] > 5) g_HouseType[i] = 3;
		g_HouseCount++;
		db_next_row(res);
	}
	db_free_result(res);
	Auc_LoadAll();   // [v15] encheres (index des maisons recalcules)
	return 1;
}

stock House_SaveSlot(i)
{
	new q[200];
	format(q, sizeof q, "UPDATE houses SET owner = '%s', locked = %d, safe = %d, price = %d WHERE id = %d", g_HouseOwner[i], g_HouseLock[i], g_HouseSafe[i], g_HousePrice[i], g_HouseId[i]);
	if (g_GarDB != DB:0) db_free_result(db_query(g_GarDB, q));
	return 1;
}

stock House_SlotById(id)
{
	for (new i = 0; i < g_HouseCount; i++) if (g_HouseId[i] == id) return i;
	return -1;
}

stock House_IsMine(playerid, i)
{
	new name[MAX_PLAYER_NAME + 1];
	GetPlayerName(playerid, name, sizeof name);
	return g_HouseOwner[i][0] && !strcmp(g_HouseOwner[i], name, true);
}

stock House_CountMine(playerid)
{
	new n = 0;
	for (new i = 0; i < g_HouseCount; i++) if (House_IsMine(playerid, i)) n++;
	return n;
}

// maison devant laquelle se trouve le joueur (dehors), ou dans laquelle il se trouve
stock House_AtDoor(playerid)
{
	if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return -1;
	for (new i = 0; i < g_HouseCount; i++)
		if (IsPlayerInRangeOfPoint(playerid, HOUSE_RANGE, g_HouseDoor[i][0], g_HouseDoor[i][1], g_HouseDoor[i][2])) return i;
	return -1;
}

stock House_Inside(playerid)
{
	new vw = GetPlayerVirtualWorld(playerid) - HOUSE_VW_BASE;
	if (vw <= 0) return -1;
	return House_SlotById(vw);
}

stock House_NearExit(playerid)
{
	new i = House_Inside(playerid);
	if (i < 0) return -1;
	new t = g_HouseType[i];
	return IsPlayerInRangeOfPoint(playerid, HOUSE_RANGE + 0.8, g_HouseInt[t][0], g_HouseInt[t][1], g_HouseInt[t][2]) ? i : -1;
}

stock House_Send(playerid, dialogid, ok = 1, const msg[] = "")
{
	new json[3600], part[200], auc[200], i = House_Inside(playerid), inside = 1;
	if (i < 0) { i = House_AtDoor(playerid); inside = 0; }
	format(json, sizeof json, "{\"v\":\"%s\",\"cash\":%d,\"bank\":%d,\"mine\":%d,\"max\":%d,\"sellPct\":%d,\"ok\":%d,\"msg\":\"%s\",\"now\":%d,\"atop\":%d,\"h\":",
		g_HouseView[playerid] ? ("list") : ("door"), GetPlayerMoney(playerid), g_BankBalance[playerid], House_CountMine(playerid), HOUSE_MAX_OWNED, HOUSE_SELL_PCT, ok, msg, gettime(), Auc_CountTop(playerid));
	if (i >= 0)
	{
		Auc_JsonFields(playerid, i, auc, sizeof auc);   // [v15] enchere en cours
		format(part, sizeof part, "{\"id\":%d,\"t\":%d,\"price\":%d,\"owner\":\"%s\",\"me\":%d,\"lock\":%d,\"safe\":%d,\"in\":%d%s}",
			g_HouseId[i], g_HouseType[i], g_HousePrice[i], g_HouseOwner[i], House_IsMine(playerid, i), g_HouseLock[i], House_IsMine(playerid, i) ? g_HouseSafe[i] : 0, inside, auc);
		strcat(json, part, sizeof json);
	}
	else strcat(json, "null", sizeof json);
	strcat(json, ",\"list\":[", sizeof json);
	new n = 0, Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);
	for (new k = 0; k < g_HouseCount; k++)
	{
		new mine = House_IsMine(playerid, k);
		if (g_HouseOwner[k][0] && !mine) continue;   // seulement les maisons a vendre + les siennes
		new Float:dx = g_HouseDoor[k][0] - px, Float:dy = g_HouseDoor[k][1] - py;
		// [v15] + enchere : offre actuelle, fin (timestamp), mise de depart
		format(part, sizeof part, "%s[%d,%d,%d,\"%s\",%d,%d,%d,%d,%d,%d]", n ? (",") : (""), g_HouseId[k], g_HouseType[k], g_HousePrice[k], g_HouseOwner[k], g_HouseLock[k], mine, floatround(floatsqroot(dx * dx + dy * dy)),
			g_HouseAucBid[k], g_HouseAucEnd[k], Auc_Opening(k));
		if (strlen(json) + strlen(part) > 3500) break;
		strcat(json, part, sizeof json);
		n++;
	}
	strcat(json, "]}", sizeof json);
	return ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "@house", json, "OK", "");
}

stock House_Open(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	g_HouseOpen[playerid] = 1;
	g_HouseView[playerid] = (House_AtDoor(playerid) < 0 && House_Inside(playerid) < 0) ? 1 : 0;
	return House_Send(playerid, HOUSE_DIALOG_OPEN);
}

stock House_Close(playerid)
{
	if (!g_HouseOpen[playerid]) return 0;
	g_HouseOpen[playerid] = 0;
	ShowPlayerDialog(playerid, HOUSE_DIALOG_CLOSE, DIALOG_STYLE_MSGBOX, "@house", "{}", "OK", "");
	return 1;
}

stock House_Enter(playerid, i)
{
	new t = g_HouseType[i];
	SetPlayerInterior(playerid, g_HouseIntId[t]);
	SetPlayerVirtualWorld(playerid, HOUSE_VW_BASE + g_HouseId[i]);
	SetPlayerPos(playerid, g_HouseInt[t][0], g_HouseInt[t][1], g_HouseInt[t][2]);
	SetPlayerFacingAngle(playerid, g_HouseInt[t][3]);
	SetCameraBehindPlayer(playerid);
	return 1;
}

stock House_Exit(playerid, i)
{
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid, g_HouseDoor[i][0], g_HouseDoor[i][1], g_HouseDoor[i][2]);
	SetPlayerFacingAngle(playerid, g_HouseDoor[i][3] + 180.0);
	SetCameraBehindPlayer(playerid);
	return 1;
}

stock House_Action(playerid, const params[])
{
	new idx = 0, act[12], arg[16], msg[96];
	Bank_NextToken(params, idx, act, sizeof act);
	Bank_NextToken(params, idx, arg, sizeof arg);
	if (!strcmp(act, "close", true)) { g_HouseOpen[playerid] = 0; return 1; }
	if (!g_HouseOpen[playerid]) return 1;

	new inside = House_Inside(playerid), door = House_AtDoor(playerid), i = inside >= 0 ? inside : door;
	if (!strcmp(act, "refresh", true)) return House_Send(playerid, HOUSE_DIALOG_UPDATE);
	if (!strcmp(act, "view", true)) { g_HouseView[playerid] = !strcmp(arg, "list", true); return House_Send(playerid, HOUSE_DIALOG_UPDATE); }
	if (!strcmp(act, "gps", true))
	{
		new s = House_SlotById(strval(arg));
		if (s < 0) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Maison introuvable.");
		Gps_Set(playerid, g_HouseDoor[s][0], g_HouseDoor[s][1]);
		format(msg, sizeof msg, "GPS : maison #%d marquee sur ta carte.", g_HouseId[s]);
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 1, msg);
	}
	if (i < 0) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Va devant la porte d'une maison.");

	// [v15] les maisons a vendre partent aux encheres (24 h, 500 000 a 50 000 000 FCFA)
	if (!strcmp(act, "bid", true))
	{
		new bmsg[170], bok = Auc_Bid(playerid, i, strval(arg), bmsg, sizeof bmsg);
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, bok, bmsg);
	}
	if (!strcmp(act, "buy", true))
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Les maisons se vendent aux encheres : fais une offre.");
	if (!strcmp(act, "buy_direct_off", true))
	{
		if (g_HouseOwner[i][0]) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Cette maison n'est pas a vendre.");
		if (House_CountMine(playerid) >= HOUSE_MAX_OWNED) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Tu possedes deja le maximum de maisons.");
		if (!g_BankLoaded[playerid] || g_BankBalance[playerid] < g_HousePrice[i]) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Solde bancaire insuffisant.");
		g_BankBalance[playerid] -= g_HousePrice[i];
		Bank_AddHistory(playerid, "Achat d'une maison", -g_HousePrice[i]);
		Bank_SavePlayer(playerid);
		GetPlayerName(playerid, g_HouseOwner[i], MAX_PLAYER_NAME + 1);
		g_HouseLock[i] = 1;
		g_HouseSafe[i] = 0;
		House_SaveSlot(i);
		Marks_SendAll();
		format(msg, sizeof msg, "Felicitations, la maison #%d est a toi !", g_HouseId[i]);
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 1, msg);
	}
	if (!strcmp(act, "enter", true))
	{
		if (inside >= 0) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Tu es deja a l'interieur.");
		if (g_HouseOwner[i][0] && g_HouseLock[i] && !House_IsMine(playerid, i)) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "La porte est fermee a cle.");
		House_Close(playerid);
		House_Enter(playerid, i);
		return SendClientMessage(playerid, 0x33CCFFFF, g_HouseOwner[i][0] ? ("Tu entres. Pres de la porte, la main \"Sortir\" te ramene dehors.") : ("Visite de la maison. Pres de la porte, la main \"Sortir\" te ramene dehors."));
	}
	if (!House_IsMine(playerid, i)) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Ce n'est pas ta maison.");
	if (!strcmp(act, "lock", true))
	{
		g_HouseLock[i] = !g_HouseLock[i];
		House_SaveSlot(i);
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 1, g_HouseLock[i] ? ("Porte fermee a cle.") : ("Porte ouverte."));
	}
	if (!strcmp(act, "deposit", true) || !strcmp(act, "withdraw", true))
	{
		new amount = strval(arg), dep = !strcmp(act, "deposit", true);
		if (inside < 0) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Le coffre est a l'interieur.");
		if (amount <= 0 || amount > 100000000) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Montant invalide.");
		if (dep)
		{
			if (GetPlayerMoney(playerid) < amount) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Pas assez d'argent liquide.");
			if (g_HouseSafe[i] > 1000000000 - amount) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Le coffre est plein.");
			GivePlayerMoney(playerid, -amount);
			g_HouseSafe[i] += amount;
		}
		else
		{
			if (g_HouseSafe[i] < amount) return House_Send(playerid, HOUSE_DIALOG_UPDATE, 0, "Le coffre ne contient pas autant.");
			GivePlayerMoney(playerid, amount);
			g_HouseSafe[i] -= amount;
		}
		House_SaveSlot(i);
		format(msg, sizeof msg, "%d FCFA %s le coffre.", amount, dep ? ("ranges dans") : ("retires du"));
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 1, msg);
	}
	if (!strcmp(act, "sell", true))
	{
		new back = g_HousePrice[i] / 100 * HOUSE_SELL_PCT + g_HouseSafe[i];
		g_BankBalance[playerid] += back;
		Bank_AddHistory(playerid, "Vente d'une maison", back);
		Bank_SavePlayer(playerid);
		g_HouseOwner[i][0] = 0;
		g_HouseLock[i] = 1;
		g_HouseSafe[i] = 0;
		House_SaveSlot(i);
		Marks_SendAll();
		if (inside >= 0) House_Exit(playerid, i);
		format(msg, sizeof msg, "Maison vendue : +%d FCFA sur ton compte.", back);
		return House_Send(playerid, HOUSE_DIALOG_UPDATE, 1, msg);
	}
	return 1;
}

stock House_InteractKey(playerid)
{
	if (!g_AuthLogged[playerid] || g_HouseOpen[playerid]) return 0;
	if (House_NearExit(playerid) >= 0) return INTERACT_HOUSE * 10 + 1;
	if (House_AtDoor(playerid) >= 0) return INTERACT_HOUSE * 10;
	return 0;
}

stock House_InteractDo(playerid)
{
	new i = House_NearExit(playerid);
	if (i >= 0) return House_Exit(playerid, i);
	return House_Open(playerid);
}

stock House_PushMarks()
{
	for (new i = 0; i < g_HouseCount; i++) Mk_Add(11, g_HouseDoor[i][0], g_HouseDoor[i][1], g_HouseDoor[i][2] - 0.95);
	// [fix sortie] marqueur 3D "Sortir" (type 9 : porte + fleche) au point de sortie de chaque type d'interieur utilise.
	// Sans lui, la main d'interaction n'apparaissait jamais a l'interieur (le client ne la dessine que pres d'un marqueur).
	new used[6];
	for (new i = 0; i < g_HouseCount; i++) used[g_HouseType[i]] = 1;
	for (new k = 1; k <= 5; k++) if (used[k]) Mk_Add(9, g_HouseInt[k][0], g_HouseInt[k][1], g_HouseInt[k][2] - 0.95);
	return 1;
}

stock House_AppendMarks(json[], size, &n)
{
	new part[110];
	for (new i = 0; i < g_HouseCount; i++, n++)
	{
		format(part, sizeof part, "%s{\"t\":3,\"x\":%.2f,\"y\":%.2f,\"z\":%.2f,\"n\":\"%s #%d\"}", n ? (",") : (""),
			g_HouseDoor[i][0], g_HouseDoor[i][1], g_HouseDoor[i][2] - 0.95, g_HouseOwner[i][0] ? ("Maison") : ("A vendre"), g_HouseId[i]);
		if (strlen(json) + strlen(part) > size - 8) return 0;
		strcat(json, part, size);
	}
	return 1;
}

stock House_OnConnect(playerid)
{
	g_HouseOpen[playerid] = 0;
	g_HouseView[playerid] = 0;
	return 1;
}

stock House_OnCommand(playerid, const cmdtext[])
{
	if (!strcmp(cmdtext, "/houseact ", true, 10)) { House_Action(playerid, cmdtext[10]); return 1; }
	if (!strcmp(cmdtext, "/maison", true)) { House_Open(playerid); return 1; }
	if (!strcmp(cmdtext, "/creermaison", true, 12) && (cmdtext[12] == 0 || cmdtext[12] == ' '))
	{
		if (Admin_Level(playerid) < 6) return 0;
		new idx = 12, t[8], p[16];
		Bank_NextToken(cmdtext, idx, t, sizeof t);
		Bank_NextToken(cmdtext, idx, p, sizeof p);
		new type = strval(t), price = strval(p);
		if (type < 1 || type > 5 || price <= 0 || price > 1000000000) return SendClientMessage(playerid, 0xFF4444FF, "Usage : /creermaison <type 1-5> <prix>  (1 Studio, 2 Appartement, 3 Maison, 4 Grande maison, 5 Villa)");
		if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, 0xFF4444FF, "Place-toi dehors, devant la porte.");
		if (g_HouseCount >= HOUSE_MAX) return SendClientMessage(playerid, 0xFF4444FF, "Nombre maximum de maisons atteint.");
		new Float:x, Float:y, Float:z, Float:a, q[220];
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, a);
		format(q, sizeof q, "INSERT INTO houses (type, price, owner, locked, safe, x, y, z, a) VALUES (%d, %d, '', 1, 0, %.3f, %.3f, %.3f, %.2f)", type, price, x, y, z, a);
		db_free_result(db_query(g_GarDB, q));
		House_Load();
		Marks_SendAll();
		format(q, sizeof q, "Maison #%d creee (type %d, %d FCFA).", g_HouseCount ? g_HouseId[g_HouseCount - 1] : 0, type, price);
		return SendClientMessage(playerid, 0x33CC33FF, q);
	}
	if (!strcmp(cmdtext, "/allermaison ", true, 13))
	{
		if (Admin_Level(playerid) < 4) return 0;
		new s = House_SlotById(strval(cmdtext[13]));
		if (s < 0) return SendClientMessage(playerid, 0xFF4444FF, "Maison introuvable.");
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerPos(playerid, g_HouseDoor[s][0], g_HouseDoor[s][1], g_HouseDoor[s][2]);
		return SendClientMessage(playerid, 0x33CC33FF, "Teleporte devant la maison.");
	}
	if (!strcmp(cmdtext, "/supprmaison ", true, 13))
	{
		if (Admin_Level(playerid) < 6) return 0;
		new id = strval(cmdtext[13]), q[64];
		if (House_SlotById(id) < 0) return SendClientMessage(playerid, 0xFF4444FF, "Maison introuvable.");
		Auc_Cancel(House_SlotById(id));   // [v15] enchere en cours remboursee
		format(q, sizeof q, "DELETE FROM houses WHERE id = %d", id);
		db_free_result(db_query(g_GarDB, q));
		House_Load();
		Marks_SendAll();
		return SendClientMessage(playerid, 0x33CC33FF, "Maison supprimee.");
	}
	if (!strcmp(cmdtext, "/maisons", true))
	{
		if (Admin_Level(playerid) < 4) return 0;
		new line[110];
		if (!g_HouseCount) SendClientMessage(playerid, 0x33CCFFFF, "Aucune maison. /creermaison <type> <prix>.");
		for (new i = 0; i < g_HouseCount; i++)
		{
			format(line, sizeof line, "  #%d  type %d  %d FCFA  %s", g_HouseId[i], g_HouseType[i], g_HousePrice[i], g_HouseOwner[i][0] ? g_HouseOwner[i] : ("(a vendre)"));
			SendClientMessage(playerid, 0xFFFFFFFF, line);
		}
		return 1;
	}
	return 0;
}

stock FishHouse_OnInit()
{
	Fish_InitDB();
	House_InitDB();
	printf("[PECHE] %d ponton(s). [MAISONS] %d maison(s).", g_FishSpotCount, g_HouseCount);
	return 1;
}

main()
{
	print("\n----------------------------------");
	print(" Basic freeroam gamemode by meagusp.");
	print(" You can use this script by copied into your own gamemode.");
	print("----------------------------------\n");
}

// ============================================================
//  KIT DE DEPART (converti de la ressource MTA "bpc_kitinicial")
// ------------------------------------------------------------
//  Une seule fois par compte : a la premiere apparition (ou /kit), une fenetre propose le kit.
//  Contenu : une Blista Compact (rangee dans le garage), un iPhone, une carte SIM, 10 Eau Kirene,
//  et KIT_CASH en liquide. Donnees : table kit_claimed de crestwood_inventory.db
// ============================================================
#define KIT_DIALOG            9790
#define KIT_CASH              5000
#define KIT_VEHICLE           496         // Blista Compact (le "Gol G3" du kit MTA)
#define KIT_COL               0x33CC33FF

new g_KitAsked[MAX_PLAYERS];
forward Kit_Offer(playerid);

stock Kit_OnInit()
{
	if (g_InvDB != DB:0) db_free_result(db_query(g_InvDB, "CREATE TABLE IF NOT EXISTS kit_claimed (name TEXT PRIMARY KEY COLLATE NOCASE, ts INTEGER)"));
	return 1;
}

stock Kit_Claimed(playerid)
{
	if (g_InvDB == DB:0) return 1;
	new name[MAX_PLAYER_NAME + 1], q[128];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT 1 FROM kit_claimed WHERE name = '%s'", name);
	new DBResult:r = db_query(g_InvDB, q), ok = 1;
	if (r != DBResult:0) { ok = db_num_rows(r) > 0; db_free_result(r); }
	return ok;
}

stock Kit_Show(playerid)
{
	new txt[700];
	format(txt, sizeof txt, "{FFFFFF}Bienvenue sur {D6B25E}Crestwood RP{FFFFFF} !\n\nVoici ton {D6B25E}kit de depart{FFFFFF}, offert une seule fois :\n\n\
{D6B25E}-{FFFFFF} une voiture Blista Compact (elle t'attend dans n'importe quel garage)\n\
{D6B25E}-{FFFFFF} un iPhone + une carte SIM (ton numero de telephone)\n\
{D6B25E}-{FFFFFF} 10 bouteilles d'Eau Kirene\n\
{D6B25E}-{FFFFFF} %d FCFA en liquide\n\nAppuie sur {D6B25E}Recuperer{FFFFFF} pour tout recevoir.", KIT_CASH);
	return ShowPlayerDialog(playerid, KIT_DIALOG, DIALOG_STYLE_MSGBOX, "Kit de depart", txt, "Recuperer", "Plus tard");
}

public Kit_Offer(playerid)
{
	if (!IsPlayerConnected(playerid) || !g_AuthLogged[playerid] || Kit_Claimed(playerid)) return 0;
	return Kit_Show(playerid);
}

stock Kit_Give(playerid)
{
	if (!g_AuthLogged[playerid]) return 0;
	if (Kit_Claimed(playerid)) return SendClientMessage(playerid, 0xFF4444FF, "Tu as deja recupere ton kit de depart.");
	new name[MAX_PLAYER_NAME + 1], q[200];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "INSERT OR IGNORE INTO kit_claimed (name, ts) VALUES ('%s', %d)", name, gettime());
	db_free_result(db_query(g_InvDB, q));
	// vehicule, range dans le garage du joueur (module GARAGES)
	if (g_GarDB != DB:0)
	{
		format(q, sizeof q, "INSERT INTO vehicles (owner, model, c1, c2, price) VALUES ('%s', %d, 1, 1, %d)", name, KIT_VEHICLE, GAR_DEFAULT_PRICE);
		db_free_result(db_query(g_GarDB, q));
	}
	Inv_SetQty(playerid, "iphone_noir", Inv_GetQty(playerid, "iphone_noir") + 1);
	Inv_SetQty(playerid, "carte_sim", Inv_GetQty(playerid, "carte_sim") + 1);
	Inv_SetQty(playerid, "eau_kirene", Inv_GetQty(playerid, "eau_kirene") + 10);
	GivePlayerMoney(playerid, KIT_CASH);
	SetPlayerHealth(playerid, 100.0);
	SendClientMessage(playerid, KIT_COL, "Kit de depart recupere ! Ta Blista t'attend au garage, ton iPhone et ta puce sont dans ton sac.");
	return 1;
}

stock Kit_OnSpawn(playerid)
{
	if (!g_AuthLogged[playerid] || g_KitAsked[playerid]) return 0;
	g_KitAsked[playerid] = 1;
	if (!Kit_Claimed(playerid)) SetTimerEx("Kit_Offer", 4000, false, "i", playerid);
	return 1;
}

stock Kit_OnDialog(playerid, dialogid, response)
{
	if (dialogid != KIT_DIALOG) return 0;
	if (response) Kit_Give(playerid);
	else SendClientMessage(playerid, KIT_COL, "Tu pourras recuperer ton kit plus tard avec /kit.");
	return 1;
}

stock Kit_OnCommand(playerid, const cmdtext[])
{
	if (strcmp(cmdtext, "/kit", true) && strcmp(cmdtext, "/kitdepart", true)) return 0;
	if (!g_AuthLogged[playerid]) return 1;
	if (Kit_Claimed(playerid)) return SendClientMessage(playerid, 0xFF4444FF, "Tu as deja recupere ton kit de depart."), 1;
	Kit_Show(playerid);
	return 1;
}

// ============================================================
//  BRAQUAGE DE LA MINI-BANQUE (converti de la ressource MTA "Magic_Robmini")
//  Lieu : mini-banque de Pershing Square (mapping MapImp_MiniBanque), 1406, -1621
// ------------------------------------------------------------
//  1) Devant la porte : main d'interaction "Braquer" (membre d'un gang). Piratage : recopier un code
//     en moins de ROB_HACK_SECONDS secondes. Reussi -> la porte 1 s'ouvre, la police est alertee (GPS).
//  2) Porte du coffre : "Pirater" -> 2e piratage -> la porte du coffre s'ouvre.
//  3) Dans le coffre : "Prendre" -> chaque appui prend une liasse (ROB_TAKE_MIN..ROB_TAKE_MAX FCFA).
//  Puis la banque se referme et il faut attendre ROB_COOLDOWN_MIN minutes.
// ============================================================
#define ROB_DIALOG            9791
#define ROB_POINT_ACTIF       0           // [v13] point de braquage fixe retire (1 = le remettre)
new g_RobActive = ROB_POINT_ACTIF;
#define ROB_NEED_GANG         1           // 1 = reserve aux membres d'un gang
#define ROB_MIN_POLICE        0           // policiers connectes minimum pour braquer
#define ROB_HACK_SECONDS      25
#define ROB_STACKS            24          // liasses dans le coffre
#define ROB_TAKE_MIN          250
#define ROB_TAKE_MAX          750
#define ROB_COOLDOWN_MIN      90
#define ROB_TIMEOUT_MIN       12          // le braquage s'annule s'il n'est pas termine
#define ROB_RANGE             1.6
#define ROB_COL               0xFF6347FF

new const Float:g_RobP1[3] = {1406.31, -1621.28, 13.58};   // porte d'entree
new const Float:g_RobP2[3] = {1404.07, -1626.63, 13.73};   // porte du coffre
new const Float:g_RobP3[3] = {1400.64, -1626.01, 13.73};   // liasses

new g_RobState;            // 0 pret, 1 porte 1 ouverte, 2 coffre ouvert, 3 en attente (cooldown)
new g_RobReadyAt;
new g_RobStartedAt;
new g_RobDoor1, g_RobDoor2;
new g_RobCash[ROB_STACKS];
new g_RobCashLeft;
new g_RobHackStage[MAX_PLAYERS];
new g_RobHackCode[MAX_PLAYERS];
new g_RobHackUntil[MAX_PLAYERS];
new g_RobTakeAt[MAX_PLAYERS];
forward Rob_Reset();
forward Rob_Tick();

stock Rob_Build()
{
	g_RobDoor1 = CreateObject(2930, 1405.4000, -1622.2000, 15.3000, 0.0, 0.0, 90.0, 120.0);
	g_RobDoor2 = CreateObject(2930, 1403.1000, -1625.9000, 15.3000, 0.0, 0.0, 0.0, 120.0);
	new k = 0;
	for (new row = 0; row < 4 && k < ROB_STACKS; row++)
		for (new col = 0; col < 6 && k < ROB_STACKS; col++, k++)
			g_RobCash[k] = CreateObject(1913, 1399.2 + col * 0.2, -1626.9 + row * 0.5, 13.8, 0.0, 0.0, 90.0, 60.0);
	g_RobCashLeft = ROB_STACKS;
	return 1;
}

public Rob_Reset()
{
	DestroyObject(g_RobDoor1); DestroyObject(g_RobDoor2);
	for (new k = 0; k < ROB_STACKS; k++) if (g_RobCash[k] != INVALID_OBJECT_ID) DestroyObject(g_RobCash[k]);
	Rob_Build();
	g_RobState = 0;
	return 1;
}

stock Rob_OnInit()
{
	for (new k = 0; k < ROB_STACKS; k++) g_RobCash[k] = INVALID_OBJECT_ID;
	Rob_Build();
	SetTimer("Rob_Tick", 5000, true);
	return 1;
}

stock Rob_Finish(const why[])
{
	g_RobState = 3;
	g_RobReadyAt = gettime() + ROB_COOLDOWN_MIN * 60;
	SetTimer("Rob_Reset", 20000, false);   // portes et coffre remis en place dans 20 s
	if (why[0]) SendClientMessageToAll(ROB_COL, why);
	return 1;
}

public Rob_Tick()
{
	if ((g_RobState == 1 || g_RobState == 2) && gettime() - g_RobStartedAt > ROB_TIMEOUT_MIN * 60)
		Rob_Finish("[MINI-BANQUE] Le braquage a echoue : les braqueurs ont mis trop de temps.");
	if (g_RobState == 3 && gettime() >= g_RobReadyAt) g_RobState = 0;
	return 1;
}

stock Rob_PoliceCount()
{
	new n = 0;
	for (new i = 0, m = GetMaxPlayers(); i < m; i++) if (IsPlayerConnected(i) && Fac_IsLaw(i)) n++;
	return n;
}

stock Rob_AlertPolice(const text[])
{
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (!IsPlayerConnected(i) || !Fac_IsLaw(i)) continue;
		SendClientMessage(i, ROB_COL, text);
		SetPlayerCheckpoint(i, g_RobP1[0], g_RobP1[1], g_RobP1[2], 4.0);
	}
	return 1;
}

stock Rob_Near(playerid, const Float:p[3])
{
	return IsPlayerInRangeOfPoint(playerid, ROB_RANGE, p[0], p[1], p[2]);
}

// cle d'interaction : 140 braquer, 141 pirater le coffre, 142 prendre une liasse
stock Rob_InteractKey(playerid)
{
	if (!g_AuthLogged[playerid] || GetPlayerVirtualWorld(playerid) != 0) return 0;
	if (!g_RobActive) return 0;
	if (g_RobState == 0 && Rob_Near(playerid, g_RobP1)) return 140;
	if (g_RobState == 1 && Rob_Near(playerid, g_RobP2)) return 141;
	if (g_RobState == 2 && g_RobCashLeft > 0 && Rob_Near(playerid, g_RobP3)) return 142;
	return 0;
}

stock Rob_StartHack(playerid, stage)
{
	g_RobHackStage[playerid] = stage;
	g_RobHackCode[playerid] = 10000 + random(90000);
	g_RobHackUntil[playerid] = gettime() + ROB_HACK_SECONDS;
	new txt[260];
	format(txt, sizeof txt, "{FFFFFF}Piratage %s en cours...\n\nRecopie ce code en moins de %d secondes :\n\n{D6B25E}          %d", stage == 1 ? ("de la porte") : ("du coffre"), ROB_HACK_SECONDS, g_RobHackCode[playerid]);
	ApplyAnimation(playerid, "INT_SHOP", "shop_cashier", 4.1, 1, 0, 0, 0, 0, 1);
	return ShowPlayerDialog(playerid, ROB_DIALOG, DIALOG_STYLE_INPUT, "Piratage", txt, "Valider", "Abandonner");
}

stock Rob_InteractDo(playerid)
{
	new key = Rob_InteractKey(playerid);
	if (key == 140)
	{
#if ROB_NEED_GANG
		if (g_GangOf[playerid] <= 0) return SendClientMessage(playerid, ROB_COL, "Seuls les membres d'un gang peuvent braquer la mini-banque.");
#endif
		if (Rob_PoliceCount() < ROB_MIN_POLICE) return SendClientMessage(playerid, ROB_COL, "Pas assez de policiers en ville pour un braquage.");
		return Rob_StartHack(playerid, 1);
	}
	if (key == 141) return Rob_StartHack(playerid, 2);
	if (key == 142)
	{
		if (gettime() < g_RobTakeAt[playerid]) return 0;
		g_RobTakeAt[playerid] = gettime() + 2;
		new k = -1;
		for (new i = 0; i < ROB_STACKS; i++) if (g_RobCash[i] != INVALID_OBJECT_ID) { k = i; break; }
		if (k < 0) return 0;
		DestroyObject(g_RobCash[k]);
		g_RobCash[k] = INVALID_OBJECT_ID;
		g_RobCashLeft--;
		new amount = ROB_TAKE_MIN + random(ROB_TAKE_MAX - ROB_TAKE_MIN + 1), m[96];
		GivePlayerMoney(playerid, amount);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0, 1);
		format(m, sizeof m, "+%d FCFA (%d liasse(s) restante(s))", amount, g_RobCashLeft);
		SendClientMessage(playerid, 0x33CC33FF, m);
		if (g_RobCashLeft <= 0) Rob_Finish("[MINI-BANQUE] Le coffre de la mini-banque de Pershing a ete vide !");
		return 1;
	}
	return 0;
}

stock Rob_OnDialog(playerid, dialogid, response, const inputtext[])
{
	if (dialogid != ROB_DIALOG) return 0;
	ClearAnimations(playerid);
	new stage = g_RobHackStage[playerid];
	g_RobHackStage[playerid] = 0;
	if (!response || !stage) return 1;
	if (gettime() > g_RobHackUntil[playerid]) return SendClientMessage(playerid, ROB_COL, "Trop lent : le systeme de securite t'a bloque. Recommence."), 1;
	if (strval(inputtext) != g_RobHackCode[playerid]) return SendClientMessage(playerid, ROB_COL, "Mauvais code : piratage rate. Recommence."), 1;
	if (stage == 1 && g_RobState == 0 && Rob_Near(playerid, g_RobP1))
	{
		g_RobState = 1;
		g_RobStartedAt = gettime();
		MoveObject(g_RobDoor1, 1405.4000, -1622.2000, 15.3010, 0.0002, 0.0, 0.0, 30.0);   // 90 -> 30 (comme MTA : -60), ~5 s
		SendClientMessage(playerid, 0x33CC33FF, "Porte ouverte ! Va pirater la porte du coffre (etape 2/2).");
		Rob_AlertPolice("[CENTRALE] Alarme a la mini-banque de Pershing Square : braquage en cours ! (point GPS)");
		return 1;
	}
	if (stage == 2 && g_RobState == 1 && Rob_Near(playerid, g_RobP2))
	{
		g_RobState = 2;
		MoveObject(g_RobDoor2, 1403.1000, -1625.9000, 15.3010, 0.0002, 0.0, 0.0, -105.0); // 0 -> -105, ~5 s
		SendClientMessage(playerid, 0x33CC33FF, "Coffre ouvert ! Prends les liasses (main d'interaction).");
		Rob_AlertPolice("[CENTRALE] Mini-banque : la porte du coffre vient d'etre forcee !");
		return 1;
	}
	return 1;
}

stock Rob_PushMarks()
{
	if (!g_RobActive) return 0;
	Mk_Add(12, g_RobP1[0], g_RobP1[1], g_RobP1[2] - 0.95);
	return 1;
}

stock Rob_AppendMarks(json[], size, &n)
{
#if !ROB_POINT_ACTIF
	#pragma unused json, size, n
	return 0;
#endif
	if (strlen(json) > size - 120) return 0;
	new part[112];
	format(part, sizeof part, "%s{\"t\":1,\"x\":%.2f,\"y\":%.2f,\"z\":%.2f,\"n\":\"Mini-banque\"}", n ? (",") : (""), g_RobP1[0], g_RobP1[1], g_RobP1[2] - 0.95);
	strcat(json, part, size);
	n++;
	return 1;
}

stock Rob_OnConnect(playerid)
{
	g_RobHackStage[playerid] = 0;
	g_RobTakeAt[playerid] = 0;
#if ROB_POINT_ACTIF
	SetPlayerMapIcon(playerid, 39, g_RobP1[0], g_RobP1[1], g_RobP1[2], 52, 0, MAPICON_LOCAL);
#endif
	return 1;
}

// ============================================================
//  TELEPHONE (puce / carte SIM, numero, contacts, SMS, appels, Wave, urgences)
//  Relie a la page de l'application : assets/phone/index.html + net.js
// ------------------------------------------------------------
//  serveur -> client : ShowPlayerDialog(9700, caption "@phone", JSON {"ev":...})
//     sync    {"ev":"sync","own":1,"num":"071234567","me":"Nom","has":1,"unread":2,"cash":..,"bank":..,
//              "call":{"st":0|1|2|3,"num":"..","name":"..","since":ts},"contacts":[[id,"nom","num"],...]}
//     convs   {"ev":"convs","list":[["num","dernier texte",ts,lu(0/1),non_lus],...]}
//     conv    {"ev":"conv","num":"..","msgs":[[moi(0/1),"texte",ts],...]}
//     recents {"ev":"recents","list":[["num",type(0 sortant,1 entrant,2 manque),ts],...]}
//     sent / sms / call / sos / wave / err (voir net.js)
//  client -> serveur : /phoneact sync|convs|recents|conv <num>|sms <num> <texte>|addc <num> <nom>|delc <id>
//                       call <num>|accept|decline|hangup|sos <svc> <texte>|taxi <texte>|soscancel|wave <num> <montant>|cam ...
//  Puce : objet "carte_sim" (24/7, 500 FCFA). Elle s'active toute seule a l'ouverture du telephone
//  (ou en l'utilisant dans l'inventaire) et donne un numero a 9 chiffres (07xxxxxxx), garde pour toujours.
//  Pendant un appel, les deux joueurs se parlent avec le bouton micro (canal vocal prive, SampVoice).
//  Donnees : SQLite scriptfiles/crestwood_phone.db
// ============================================================
#define PHONE_DIALOG          9700
#define PHONE_NEED_DEVICE     0           // 1 = il faut un iPhone dans l'inventaire pour utiliser le telephone
#define PHONE_SIM_ITEM        "carte_sim"
#define PHONE_RING_SECONDS    30
#define PHONE_COL_INFO        0x33CCFFFF
#define PHONE_COL_SOS         0xFF6347FF

new DB:g_PhDB;
new g_PhNum[MAX_PLAYERS][12];
new g_PhLoaded[MAX_PLAYERS];
new g_PhCallWith[MAX_PLAYERS] = { INVALID_PLAYER_ID, ... };
new g_PhCallSt[MAX_PLAYERS];          // 0 rien, 1 j'appelle (ca sonne), 2 appel entrant, 3 en ligne
new g_PhCallSince[MAX_PLAYERS];
#if CW_VOICE
new SV_GSTREAM:g_PhCallStream[MAX_PLAYERS] = { SV_NULL, ... };
#endif

forward Phone_RingTimeout(playerid, target, since);

// Texte libre : pas de quote / guillemet / antislash / accolade (SQL + JSON)
stock Ph_Clean(str[])
{
	for (new i = 0; str[i]; i++)
	{
		if (str[i] == '\'' || str[i] == '"' || str[i] == '\\' || str[i] == '{' || str[i] == '}' || str[i] < ' ') str[i] = ' ';
	}
	return 1;
}

stock Ph_Digits(const in[], out[], outsize)
{
	new j = 0;
	for (new i = 0; in[i] && j < outsize - 1 && j < 9; i++) if (in[i] >= '0' && in[i] <= '9') out[j++] = in[i];
	out[j] = 0;
	return j;
}

stock Ph_Send(playerid, const json[])
{
	return ShowPlayerDialog(playerid, PHONE_DIALOG, DIALOG_STYLE_MSGBOX, "@phone", json, "OK", "");
}

stock Ph_Err(playerid, const msg[])
{
	new json[160];
	format(json, sizeof json, "{\"ev\":\"err\",\"msg\":\"%s\"}", msg);
	return Ph_Send(playerid, json);
}

stock Ph_Name(playerid, out[], outsize)
{
	GetPlayerName(playerid, out, outsize);
	for (new i = 0; out[i]; i++) if (out[i] == '_') out[i] = ' ';
	return 1;
}

stock Phone_OnInit()
{
	g_PhDB = db_open("crestwood_phone.db");
	if (g_PhDB == DB:0) { print("[TELEPHONE] ERREUR : impossible d'ouvrir crestwood_phone.db"); return 0; }
	db_free_result(db_query(g_PhDB, "CREATE TABLE IF NOT EXISTS phones (name TEXT PRIMARY KEY COLLATE NOCASE, num TEXT UNIQUE)"));
	db_free_result(db_query(g_PhDB, "CREATE TABLE IF NOT EXISTS contacts (id INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT COLLATE NOCASE, num TEXT, cname TEXT)"));
	db_free_result(db_query(g_PhDB, "CREATE TABLE IF NOT EXISTS sms (id INTEGER PRIMARY KEY AUTOINCREMENT, snum TEXT, rnum TEXT, text TEXT, ts INTEGER, rd INTEGER DEFAULT 0)"));
	db_free_result(db_query(g_PhDB, "CREATE TABLE IF NOT EXISTS calls (id INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT, other TEXT, type INTEGER, ts INTEGER)"));
	print("[TELEPHONE] Base prete.");
	return 1;
}

stock Phone_Load(playerid)
{
	g_PhNum[playerid][0] = 0;
	g_PhLoaded[playerid] = 1;
	if (g_PhDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[128];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT num FROM phones WHERE name = '%s' LIMIT 1", name);
	new DBResult:r = db_query(g_PhDB, q);
	if (r != DBResult:0)
	{
		if (db_num_rows(r) > 0) db_get_field(r, 0, g_PhNum[playerid], 12);
		db_free_result(r);
	}
	return 1;
}

// Active une puce : nouveau numero unique. Retourne 1 si un numero a ete attribue.
stock Phone_ActivateSim(playerid)
{
	if (!g_PhLoaded[playerid]) Phone_Load(playerid);
	if (g_PhNum[playerid][0] || g_PhDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], num[12], q[160];
	GetPlayerName(playerid, name, sizeof name);
	for (new t = 0; t < 30; t++)
	{
		format(num, sizeof num, "07%07d", random(10000000));
		format(q, sizeof q, "SELECT 1 FROM phones WHERE num = '%s'", num);
		new DBResult:r = db_query(g_PhDB, q), used = 0;
		if (r != DBResult:0) { used = db_num_rows(r) > 0; db_free_result(r); }
		if (used) continue;
		format(q, sizeof q, "INSERT OR REPLACE INTO phones (name, num) VALUES ('%s', '%s')", name, num);
		db_free_result(db_query(g_PhDB, q));
		format(g_PhNum[playerid], 12, "%s", num);
		format(q, sizeof q, "Puce activee : ton numero est le %s.", num);
		SendClientMessage(playerid, PHONE_COL_INFO, q);
		return 1;
	}
	return 0;
}

stock Phone_GetNumber(playerid, out[], outsize)
{
	if (!g_PhLoaded[playerid]) Phone_Load(playerid);
	format(out, outsize, "%s", g_PhNum[playerid]);
	return out[0] != 0;
}

stock Phone_HasDevice(playerid)
{
#if PHONE_NEED_DEVICE
	return Inv_GetQty(playerid, "iphone_orange") > 0 || Inv_GetQty(playerid, "iphone_noir") > 0;
#else
	#pragma unused playerid
	return 1;
#endif
}

stock Phone_FindByNum(const num[])
{
	if (!num[0]) return INVALID_PLAYER_ID;
	for (new i = 0, m = GetMaxPlayers(); i < m; i++)
	{
		if (IsPlayerConnected(i) && g_PhLoaded[i] && g_PhNum[i][0] && !strcmp(g_PhNum[i], num)) return i;
	}
	return INVALID_PLAYER_ID;
}

// Nom d'un numero dans les contacts de playerid (vide si inconnu)
stock Phone_ContactName(playerid, const num[], out[], outsize)
{
	out[0] = 0;
	if (g_PhDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[200];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "SELECT cname FROM contacts WHERE owner = '%s' AND num = '%s' LIMIT 1", name, num);
	new DBResult:r = db_query(g_PhDB, q);
	if (r != DBResult:0) { if (db_num_rows(r) > 0) db_get_field(r, 0, out, outsize); db_free_result(r); }
	return out[0] != 0;
}

stock Phone_Unread(playerid)
{
	if (!g_PhNum[playerid][0] || g_PhDB == DB:0) return 0;
	new q[128], f[12], n = 0;
	format(q, sizeof q, "SELECT COUNT(*) FROM sms WHERE rnum = '%s' AND rd = 0", g_PhNum[playerid]);
	new DBResult:r = db_query(g_PhDB, q);
	if (r != DBResult:0)
	{
		if (db_num_rows(r) > 0)
		{
			db_get_field(r, 0, f, sizeof f);
			n = strval(f);
		}
		db_free_result(r);
	}
	return n;
}

stock Phone_AddRecent(playerid, const other[], type)
{
	if (g_PhDB == DB:0) return 0;
	new name[MAX_PLAYER_NAME + 1], q[200];
	GetPlayerName(playerid, name, sizeof name);
	format(q, sizeof q, "INSERT INTO calls (owner, other, type, ts) VALUES ('%s', '%s', %d, %d)", name, other, type, gettime());
	db_free_result(db_query(g_PhDB, q));
	return 1;
}

stock Phone_Sync(playerid)
{
	if (!g_PhLoaded[playerid]) Phone_Load(playerid);
	// puce dans l'inventaire et pas encore de numero : activation automatique
	if (!g_PhNum[playerid][0] && Inv_GetQty(playerid, PHONE_SIM_ITEM) > 0 && Phone_ActivateSim(playerid))
		Inv_SetQty(playerid, PHONE_SIM_ITEM, Inv_GetQty(playerid, PHONE_SIM_ITEM) - 1);

	new json[3600], part[96], me[MAX_PLAYER_NAME + 1], cnum[12], cname[32];
	Ph_Name(playerid, me, sizeof me);
	new w = g_PhCallWith[playerid];
	if (w != INVALID_PLAYER_ID && IsPlayerConnected(w)) { format(cnum, sizeof cnum, "%s", g_PhNum[w]); Phone_ContactName(playerid, cnum, cname, sizeof cname); }
	else { cnum[0] = 0; cname[0] = 0; }
	format(json, sizeof json, "{\"ev\":\"sync\",\"own\":%d,\"num\":\"%s\",\"me\":\"%s\",\"has\":%d,\"unread\":%d,\"cash\":%d,\"bank\":%d,\"call\":{\"st\":%d,\"num\":\"%s\",\"name\":\"%s\",\"since\":%d},\"contacts\":[",
		Phone_HasDevice(playerid), g_PhNum[playerid], me, g_PhNum[playerid][0] ? 1 : 0, Phone_Unread(playerid),
		GetPlayerMoney(playerid), g_BankBalance[playerid], g_PhCallSt[playerid], cnum, cname, g_PhCallSince[playerid]);
	if (g_PhDB != DB:0)
	{
		new name[MAX_PLAYER_NAME + 1], q[160], f[12], n = 0;
		GetPlayerName(playerid, name, sizeof name);
		format(q, sizeof q, "SELECT id, cname, num FROM contacts WHERE owner = '%s' ORDER BY cname LIMIT 40", name);
		new DBResult:r = db_query(g_PhDB, q);
		if (r != DBResult:0)
		{
			if (db_num_rows(r) > 0) do
			{
				db_get_field(r, 0, f, sizeof f);
				db_get_field(r, 1, cname, sizeof cname);
				db_get_field(r, 2, cnum, sizeof cnum);
				format(part, sizeof part, "%s[%d,\"%s\",\"%s\"]", n ? (",") : (""), strval(f), cname, cnum);
				if (strlen(json) + strlen(part) > sizeof(json) - 8) break;
				strcat(json, part, sizeof json);
				n++;
			}
			while (db_next_row(r));
			db_free_result(r);
		}
	}
	strcat(json, "]}", sizeof json);
	return Ph_Send(playerid, json);
}

stock Phone_SendConvs(playerid)
{
	new num[12];
	format(num, sizeof num, "%s", g_PhNum[playerid]);
	if (!num[0] || g_PhDB == DB:0) return Ph_Send(playerid, "{\"ev\":\"convs\",\"list\":[]}");
	new json[3800], part[180], q[420], o[12], text[100], f[16], ts, unread, n = 0;
	json = "{\"ev\":\"convs\",\"list\":[";
	format(q, sizeof q, "SELECT CASE WHEN snum = '%s' THEN rnum ELSE snum END AS o, text, ts, MAX(id), SUM(CASE WHEN rnum = '%s' AND rd = 0 THEN 1 ELSE 0 END) FROM sms WHERE snum = '%s' OR rnum = '%s' GROUP BY o ORDER BY MAX(id) DESC LIMIT 18", num, num, num, num);
	new DBResult:r = db_query(g_PhDB, q);
	if (r != DBResult:0)
	{
		if (db_num_rows(r) > 0) do
		{
			db_get_field(r, 0, o, sizeof o);
			db_get_field(r, 1, text, sizeof text);
			db_get_field(r, 2, f, sizeof f); ts = strval(f);
			db_get_field(r, 4, f, sizeof f); unread = strval(f);
			format(part, sizeof part, "%s[\"%s\",\"%s\",%d,%d,%d]", n ? (",") : (""), o, text, ts, unread ? 0 : 1, unread);
			if (strlen(json) + strlen(part) > sizeof(json) - 8) break;
			strcat(json, part, sizeof json);
			n++;
		}
		while (db_next_row(r));
		db_free_result(r);
	}
	strcat(json, "]}", sizeof json);
	return Ph_Send(playerid, json);
}

stock Phone_SendConv(playerid, const other[])
{
	new num[12];
	format(num, sizeof num, "%s", g_PhNum[playerid]);
	new json[3800], part[160], q[360], text[100], f[16], n = 0;
	format(json, sizeof json, "{\"ev\":\"conv\",\"num\":\"%s\",\"msgs\":[", other);
	if (num[0] && g_PhDB != DB:0)
	{
		format(q, sizeof q, "SELECT mine, text, ts FROM (SELECT id, snum = '%s' AS mine, text, ts FROM sms WHERE (snum = '%s' AND rnum = '%s') OR (snum = '%s' AND rnum = '%s') ORDER BY id DESC LIMIT 24) ORDER BY id", num, num, other, other, num);
		new DBResult:r = db_query(g_PhDB, q);
		if (r != DBResult:0)
		{
			if (db_num_rows(r) > 0) do
			{
				db_get_field(r, 0, f, sizeof f); new mine = strval(f);
				db_get_field(r, 1, text, sizeof text);
				db_get_field(r, 2, f, sizeof f);
				format(part, sizeof part, "%s[%d,\"%s\",%d]", n ? (",") : (""), mine, text, strval(f));
				if (strlen(json) + strlen(part) > sizeof(json) - 8) break;
				strcat(json, part, sizeof json);
				n++;
			}
			while (db_next_row(r));
			db_free_result(r);
		}
		format(q, sizeof q, "UPDATE sms SET rd = 1 WHERE snum = '%s' AND rnum = '%s'", other, num);
		db_free_result(db_query(g_PhDB, q));
	}
	strcat(json, "]}", sizeof json);
	return Ph_Send(playerid, json);
}

stock Phone_SendRecents(playerid)
{
	new json[2400], part[64], q[160], o[12], f[16], name[MAX_PLAYER_NAME + 1], n = 0;
	json = "{\"ev\":\"recents\",\"list\":[";
	if (g_PhDB != DB:0)
	{
		GetPlayerName(playerid, name, sizeof name);
		format(q, sizeof q, "SELECT other, type, ts FROM calls WHERE owner = '%s' ORDER BY id DESC LIMIT 25", name);
		new DBResult:r = db_query(g_PhDB, q);
		if (r != DBResult:0)
		{
			if (db_num_rows(r) > 0) do
			{
				db_get_field(r, 0, o, sizeof o);
				db_get_field(r, 1, f, sizeof f); new type = strval(f);
				db_get_field(r, 2, f, sizeof f);
				format(part, sizeof part, "%s[\"%s\",%d,%d]", n ? (",") : (""), o, type, strval(f));
				strcat(json, part, sizeof json);
				n++;
			}
			while (db_next_row(r));
			db_free_result(r);
		}
	}
	strcat(json, "]}", sizeof json);
	return Ph_Send(playerid, json);
}

// ------------------------------------------------------------ appels
stock Phone_CallEvent(playerid, const st[], const num[], const why[] = "")
{
	new json[200], cname[32];
	Phone_ContactName(playerid, num, cname, sizeof cname);
	format(json, sizeof json, "{\"ev\":\"call\",\"st\":\"%s\",\"num\":\"%s\",\"name\":\"%s\",\"why\":\"%s\"}", st, num, cname, why);
	return Ph_Send(playerid, json);
}

stock Phone_VoiceStart(a, b)
{
#if CW_VOICE
	new vname[2];
	new SV_GSTREAM:s = SvCreateGStream(0xFFFFFFFF, vname);
	if (s == SV_NULL) return 0;
	g_PhCallStream[a] = s; g_PhCallStream[b] = s;
	SvAttachListenerToStream(s, a);
	SvAttachListenerToStream(s, b);
#else
	#pragma unused a, b
#endif
	return 1;
}

stock Phone_VoiceStop(playerid)
{
#if CW_VOICE
	new SV_GSTREAM:s = g_PhCallStream[playerid];
	if (s == SV_NULL) return 0;
	for (new i = 0, m = GetMaxPlayers(); i < m; i++) if (g_PhCallStream[i] == s) g_PhCallStream[i] = SV_NULL;
	SvDeleteStream(s);
#else
	#pragma unused playerid
#endif
	return 1;
}

stock Phone_EndCall(playerid, const why[], notifySelf = 1)
{
	new w = g_PhCallWith[playerid], st = g_PhCallSt[playerid];
	if (st == 0) return 0;
	Phone_VoiceStop(playerid);
	g_PhCallSt[playerid] = 0; g_PhCallWith[playerid] = INVALID_PLAYER_ID; g_PhCallSince[playerid] = 0;
	new other[12];
	other[0] = 0;
	if (w != INVALID_PLAYER_ID && IsPlayerConnected(w))
	{
		format(other, sizeof other, "%s", g_PhNum[w]);
		new wst = g_PhCallSt[w];
		g_PhCallSt[w] = 0; g_PhCallWith[w] = INVALID_PLAYER_ID; g_PhCallSince[w] = 0;
		if (wst == 2 && st == 1) Phone_AddRecent(w, g_PhNum[playerid], 2);   // il n'a pas decroche : appel manque
		Phone_CallEvent(w, "ended", g_PhNum[playerid], why);
	}
	if (notifySelf) Phone_CallEvent(playerid, "ended", other, why);
	return 1;
}

public Phone_RingTimeout(playerid, target, since)
{
	if (!IsPlayerConnected(playerid) || g_PhCallSt[playerid] != 1 || g_PhCallWith[playerid] != target || g_PhCallSince[playerid] != since) return 0;
	Phone_EndCall(playerid, "Pas de reponse");
	return 1;
}

stock Phone_Call(playerid, const num[])
{
	if (!g_PhNum[playerid][0]) return Ph_Err(playerid, "Pas de carte SIM");
	if (g_PhCallSt[playerid]) return Ph_Err(playerid, "Tu es deja en ligne");
	if (!strcmp(num, "17") || !strcmp(num, "15") || !strcmp(num, "18")) return Ph_Err(playerid, "Utilise le bouton urgence");
	if (!strcmp(num, g_PhNum[playerid])) return Ph_Err(playerid, "Tu ne peux pas t'appeler toi-meme");
	Phone_AddRecent(playerid, num, 0);
	new t = Phone_FindByNum(num);
	if (t == INVALID_PLAYER_ID) return Phone_CallEvent(playerid, "ended", num, "Numero injoignable");
	if (g_PhCallSt[t]) return Phone_CallEvent(playerid, "ended", num, "Ligne occupee");
	new now = gettime();
	g_PhCallSt[playerid] = 1; g_PhCallWith[playerid] = t; g_PhCallSince[playerid] = now;
	g_PhCallSt[t] = 2; g_PhCallWith[t] = playerid; g_PhCallSince[t] = now;
	Phone_AddRecent(t, g_PhNum[playerid], 1);
	Phone_CallEvent(playerid, "ringing", num);
	Phone_CallEvent(t, "incoming", g_PhNum[playerid]);
	SetTimerEx("Phone_RingTimeout", PHONE_RING_SECONDS * 1000, false, "iii", playerid, t, now);
	return 1;
}

stock Phone_Accept(playerid)
{
	new c = g_PhCallWith[playerid];
	if (g_PhCallSt[playerid] != 2 || c == INVALID_PLAYER_ID || !IsPlayerConnected(c)) return Ph_Err(playerid, "Aucun appel entrant");
	new now = gettime();
	g_PhCallSt[playerid] = 3; g_PhCallSince[playerid] = now;
	g_PhCallSt[c] = 3; g_PhCallSince[c] = now;
	Phone_VoiceStart(playerid, c);
	Phone_CallEvent(playerid, "incall", g_PhNum[c]);
	Phone_CallEvent(c, "incall", g_PhNum[playerid]);
	SendClientMessage(playerid, PHONE_COL_INFO, "Appel en cours : maintiens le bouton micro pour parler.");
	SendClientMessage(c, PHONE_COL_INFO, "Appel en cours : maintiens le bouton micro pour parler.");
	return 1;
}

// ------------------------------------------------------------ SMS / Wave / urgences
stock Phone_Sms(playerid, const num[], text[])
{
	if (!g_PhNum[playerid][0]) return Ph_Err(playerid, "Pas de carte SIM");
	Ph_Clean(text);
	if (!text[0]) return 0;
	new q[300];
	format(q, sizeof q, "INSERT INTO sms (snum, rnum, text, ts, rd) VALUES ('%s', '%s', '%s', %d, 0)", g_PhNum[playerid], num, text, gettime());
	db_free_result(db_query(g_PhDB, q));
	new json[260];
	format(json, sizeof json, "{\"ev\":\"sent\",\"to\":\"%s\"}", num);
	Ph_Send(playerid, json);
	new t = Phone_FindByNum(num);
	if (t != INVALID_PLAYER_ID)
	{
		new cname[32];
		Phone_ContactName(t, g_PhNum[playerid], cname, sizeof cname);
		format(json, sizeof json, "{\"ev\":\"sms\",\"from\":\"%s\",\"name\":\"%s\",\"text\":\"%s\"}", g_PhNum[playerid], cname, text);
		Ph_Send(t, json);
	}
	return 1;
}

stock Phone_Wave(playerid, const num[], amount)
{
	if (!g_PhNum[playerid][0]) return Ph_Err(playerid, "Pas de carte SIM");
	if (!g_BankLoaded[playerid]) return Ph_Err(playerid, "Compte bancaire indisponible");
	if (amount <= 0 || amount > BANK_MAX_AMOUNT) return Ph_Err(playerid, "Montant invalide");
	if (amount > g_BankBalance[playerid]) return Ph_Err(playerid, "Solde bancaire insuffisant");
	if (!strcmp(num, g_PhNum[playerid])) return Ph_Err(playerid, "Numero invalide");
	new q[200], owner[MAX_PLAYER_NAME + 1];
	owner[0] = 0;
	format(q, sizeof q, "SELECT name FROM phones WHERE num = '%s' LIMIT 1", num);
	new DBResult:r = db_query(g_PhDB, q);
	if (r != DBResult:0) { if (db_num_rows(r) > 0) db_get_field(r, 0, owner, sizeof owner); db_free_result(r); }
	if (!owner[0]) return Ph_Err(playerid, "Ce numero n'existe pas");
	new t = Phone_FindByNum(num), descr[64], json[220];
	if (t != INVALID_PLAYER_ID && g_BankLoaded[t])
	{
		if (g_BankBalance[t] > BANK_MAX_MONEY - amount) return Ph_Err(playerid, "Ce compte ne peut pas recevoir autant");
		g_BankBalance[t] += amount;
		Bank_SavePlayer(t);
		format(descr, sizeof descr, "Wave recu du %s", g_PhNum[playerid]);
		Bank_AddHistory(t, descr, amount);
		new cname[32];
		Phone_ContactName(t, g_PhNum[playerid], cname, sizeof cname);
		format(json, sizeof json, "{\"ev\":\"wave\",\"st\":\"in\",\"num\":\"%s\",\"name\":\"%s\",\"amount\":%d,\"bank\":%d}", g_PhNum[playerid], cname, amount, g_BankBalance[t]);
		Ph_Send(t, json);
	}
	else
	{
		// destinataire hors ligne : credite directement son compte
		format(q, sizeof q, "UPDATE bank_accounts SET balance = balance + %d WHERE name = '%s'", amount, owner);
		db_free_result(db_query(g_BankDB, q));
	}
	g_BankBalance[playerid] -= amount;
	Bank_SavePlayer(playerid);
	format(descr, sizeof descr, "Wave envoye au %s", num);
	Bank_AddHistory(playerid, descr, -amount);
	format(json, sizeof json, "{\"ev\":\"wave\",\"st\":\"ok\",\"num\":\"%s\",\"name\":\"\",\"amount\":%d,\"bank\":%d}", num, amount, g_BankBalance[playerid]);
	return Ph_Send(playerid, json);
}

stock Phone_Sos(playerid, const svc[], text[])
{
	Ph_Clean(text);
	new n = 0, line[180], name[MAX_PLAYER_NAME + 1], json[120];
	Ph_Name(playerid, name, sizeof name);
	if (!strcmp(svc, "police"))
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		format(line, sizeof line, "[17 POLICE] %s (%s) : %s", name, g_PhNum[playerid][0] ? g_PhNum[playerid] : ("sans numero"), text);
		for (new i = 0, m = GetMaxPlayers(); i < m; i++)
		{
			if (!IsPlayerConnected(i) || !Fac_IsLaw(i)) continue;
			SendClientMessage(i, PHONE_COL_SOS, line);
			SetPlayerCheckpoint(i, x, y, z, 3.0);
			n++;
		}
	}
	format(json, sizeof json, "{\"ev\":\"sos\",\"svc\":\"%s\",\"st\":\"sent\",\"n\":%d}", svc, n);
	return Ph_Send(playerid, json);
}

// ------------------------------------------------------------ evenements
stock Phone_OnConnect(playerid)
{
	g_PhLoaded[playerid] = 0;
	g_PhNum[playerid][0] = 0;
	g_PhCallSt[playerid] = 0;
	g_PhCallWith[playerid] = INVALID_PLAYER_ID;
	g_PhCallSince[playerid] = 0;
#if CW_VOICE
	g_PhCallStream[playerid] = SV_NULL;
#endif
	return 1;
}

stock Phone_OnDisconnect(playerid)
{
	Phone_EndCall(playerid, "Ligne coupee", 0);
	g_PhLoaded[playerid] = 0;
	return 1;
}

stock Phone_OnCommand(playerid, const cmdtext[])
{
	if (strcmp(cmdtext, "/phoneact", true, 9) || (cmdtext[9] != ' ' && cmdtext[9] != 0)) return 0;
	if (!g_AuthLogged[playerid]) return 1;
	if (!g_PhLoaded[playerid]) Phone_Load(playerid);
	new idx = 9, action[12], tok[16], num[12], rest[128];
	Bank_NextToken(cmdtext, idx, action, sizeof action);
	if (!strcmp(action, "sync", true)) return Phone_Sync(playerid), 1;
	if (!strcmp(action, "cam", true)) return 1;   // camera du telephone : geree par l'APK
	if (!Phone_HasDevice(playerid)) return Ph_Err(playerid, "Il te faut un telephone"), 1;
	if (!strcmp(action, "convs", true)) return Phone_SendConvs(playerid), 1;
	if (!strcmp(action, "recents", true)) return Phone_SendRecents(playerid), 1;
	if (!strcmp(action, "accept", true)) return Phone_Accept(playerid), 1;
	if (!strcmp(action, "decline", true) || !strcmp(action, "hangup", true)) { if (!Phone_EndCall(playerid, "Appel termine")) Phone_CallEvent(playerid, "ended", "", "Appel termine"); return 1; }
	if (!strcmp(action, "soscancel", true)) return 1;
	Bank_NextToken(cmdtext, idx, tok, sizeof tok);
	while (cmdtext[idx] == ' ') idx++;
	format(rest, sizeof rest, "%s", cmdtext[idx]);
	if (!strcmp(action, "sos", true)) { Ph_Clean(tok); return Phone_Sos(playerid, tok, rest), 1; }
	if (!strcmp(action, "taxi", true))
	{
		new json[100];
		format(json, sizeof json, "{\"ev\":\"sos\",\"svc\":\"taxi\",\"st\":\"sent\",\"n\":0}");
		return Ph_Send(playerid, json), 1;
	}
	if (!strcmp(action, "delc", true))
	{
		new name[MAX_PLAYER_NAME + 1], q[160];
		GetPlayerName(playerid, name, sizeof name);
		format(q, sizeof q, "DELETE FROM contacts WHERE id = %d AND owner = '%s'", strval(tok), name);
		db_free_result(db_query(g_PhDB, q));
		return Phone_Sync(playerid), 1;
	}
	if (!Ph_Digits(tok, num, sizeof num)) return Ph_Err(playerid, "Numero invalide"), 1;
	if (!strcmp(action, "conv", true)) return Phone_SendConv(playerid, num), 1;
	if (!strcmp(action, "call", true)) return Phone_Call(playerid, num), 1;
	if (!strcmp(action, "sms", true)) return Phone_Sms(playerid, num, rest), 1;
	if (!strcmp(action, "wave", true)) return Phone_Wave(playerid, num, strval(rest)), 1;
	if (!strcmp(action, "addc", true))
	{
		Ph_Clean(rest);
		rest[24] = 0;
		if (!rest[0]) return Ph_Err(playerid, "Nom requis"), 1;
		new name[MAX_PLAYER_NAME + 1], q[220];
		GetPlayerName(playerid, name, sizeof name);
		format(q, sizeof q, "INSERT INTO contacts (owner, num, cname) VALUES ('%s', '%s', '%s')", name, num, rest);
		db_free_result(db_query(g_PhDB, q));
		return Phone_Sync(playerid), 1;
	}
	return 1;
}

// ============================================================
//  VOCAL DE PROXIMITE (SampVoice 3.1)
// ------------------------------------------------------------
//  Serveur : plugin sampvoice.so (v3.1) dans plugins/ + "plugins sampvoice.so" dans server.cfg
//            (APRES Pawn.RakNet s'il est present). Port UDP de SampVoice ouvert sur le VPS.
//  Chaque joueur a un canal local qui le suit (VOICE_DISTANCE metres). Le bouton micro du HUD
//  envoie la touche 0x42 : appui = le joueur parle dans son canal, relache = il se tait.
//  Les joueurs proches l'entendent (le plugin gere qui est a portee).
// ============================================================
#define VOICE_KEY             0x42
#define VOICE_DISTANCE        25.0

#if CW_VOICE
new SV_DLSTREAM:g_VoiceLocal[MAX_PLAYERS] = { SV_NULL, ... };

stock Voice_OnConnect(playerid)
{
	g_VoiceLocal[playerid] = SV_NULL;
	if (IsPlayerNPC(playerid)) return 0;
	if (SvGetVersion(playerid) == SV_NULL)
	{
		printf("[VOCAL] %d : pas de client vocal (APK sans SampVoice).", playerid);
		return 0;
	}
	// le canal est cree meme si le micro n'est pas encore autorise : le client le relance a l'appui
	new vname[2];
	g_VoiceLocal[playerid] = SvCreateDLStreamAtPlayer(VOICE_DISTANCE, SV_INFINITY, playerid, 0xFFFFFFFF, vname);
	if (g_VoiceLocal[playerid] == SV_NULL)
	{
		printf("[VOCAL] %d : impossible de creer le canal local.", playerid);
		return 0;
	}
	SvAddKey(playerid, VOICE_KEY);
	if (!SvHasMicro(playerid)) printf("[VOCAL] %d : micro non detecte a la connexion (autorisation Android ?).", playerid);
	return 1;
}

stock Voice_OnDisconnect(playerid)
{
	if (g_VoiceLocal[playerid] != SV_NULL)
	{
		SvDeleteStream(g_VoiceLocal[playerid]);
		g_VoiceLocal[playerid] = SV_NULL;
	}
	return 1;
}

public SV_VOID:OnPlayerActivationKeyPress(SV_UINT:playerid, SV_UINT:keyid)
{
	if (keyid != VOICE_KEY) return;
	if (g_VoiceLocal[playerid] != SV_NULL) SvAttachSpeakerToStream(g_VoiceLocal[playerid], playerid);
	if (g_PhCallStream[playerid] != SV_NULL) SvAttachSpeakerToStream(g_PhCallStream[playerid], playerid);   // appel telephone
}

public SV_VOID:OnPlayerActivationKeyRelease(SV_UINT:playerid, SV_UINT:keyid)
{
	if (keyid != VOICE_KEY) return;
	if (g_VoiceLocal[playerid] != SV_NULL) SvDetachSpeakerFromStream(g_VoiceLocal[playerid], playerid);
	if (g_PhCallStream[playerid] != SV_NULL) SvDetachSpeakerFromStream(g_PhCallStream[playerid], playerid);
}
#else
stock Voice_OnConnect(playerid) { return playerid; }
stock Voice_OnDisconnect(playerid) { return playerid; }
#endif

